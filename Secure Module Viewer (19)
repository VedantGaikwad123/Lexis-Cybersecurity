@charset "utf-8";

:root { --bg: #0f1923; --bg2: #162030; --bg3: #1c2b3a; --surface: #1e2f42; --surface2: #243548; --border: #2e4560; --accent: #4a9eca; --accent2: #e8a838; --accent3: #5ec98b; --text: #d6e8f5; --text2: #8eaec8; --text3: #5a7d9a; --header-bg: #0d1e2e; --toc-bg: #162030; --toc-border: #2e4560; --mono: 'JetBrains Mono', monospace; --serif: 'Playfair Display', Georgia, serif; --body: 'Source Serif 4', Georgia, serif; --shadow: 0 8px 32px rgba(0, 0, 0, 0.5); }

[data-theme="light"] { --bg: #f0ede8; --bg2: #e8e4de; --bg3: #dedad3; --surface: #ffffff; --surface2: #f5f2ed; --border: #d0c9bf; --accent: #1a3a5c; --accent2: #b5762a; --accent3: #2a7a4f; --text: #1a2a3a; --text2: #4a6070; --text3: #8a9aaa; --header-bg: #1a3050; --toc-bg: #ffffff; --toc-border: #c8c0b4; --shadow: 0 8px 32px rgba(0, 0, 0, 0.12); }

[data-theme="light"] header { background: rgb(26, 48, 80) !important; }

[data-theme="light"] header h1, [data-theme="light"] header p, [data-theme="light"] header .meta-label, [data-theme="light"] header .meta-value { color: rgb(214, 232, 245) !important; }

[data-theme="light"] .theme-toggle { background: rgba(255, 255, 255, 0.15); border-color: rgba(255, 255, 255, 0.3); }

[data-theme="light"] .toc-section { background: var(--toc-bg); border-left: 4px solid var(--accent); }

[data-theme="light"] .toc-section a { color: var(--accent); }

*, ::before, ::after { box-sizing: border-box; margin: 0px; padding: 0px; }

html { scroll-behavior: smooth; }

body { background: var(--bg); color: var(--text); font-family: var(--body); font-size: 17px; line-height: 1.8; transition: background 0.3s, color 0.3s; }

header { background: var(--header-bg); padding: 70px 60px 60px; position: relative; overflow: hidden; }

header::before { content: ""; position: absolute; inset: 0px; background: radial-gradient(at 80% 50%, rgba(74, 158, 202, 0.08) 0%, transparent 60%), radial-gradient(at 20% 80%, rgba(232, 168, 56, 0.05) 0%, transparent 50%); pointer-events: none; }

header::after { content: ""; position: absolute; bottom: 0px; left: 0px; right: 0px; height: 2px; background: linear-gradient(90deg, transparent, var(--accent), var(--accent2), transparent); }

header h1 { font-family: var(--serif); font-size: clamp(2.8rem, 6vw, 5rem); font-weight: 900; color: rgb(255, 255, 255); letter-spacing: -0.02em; margin-bottom: 14px; position: relative; }

header .subtitle { font-family: var(--body); font-size: 1.1rem; color: rgba(214, 232, 245, 0.7); font-weight: 300; margin-bottom: 40px; position: relative; }

.meta-row { display: flex; gap: 50px; position: relative; }

.meta-item { }

.meta-label { font-family: var(--mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; color: rgba(214, 232, 245, 0.5); font-weight: 600; margin-bottom: 4px; }

.meta-value { font-family: var(--mono); font-size: 0.85rem; color: rgba(214, 232, 245, 0.85); }

.theme-toggle { position: absolute; top: 24px; right: 24px; display: flex; align-items: center; gap: 6px; background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 50px; padding: 7px 14px; cursor: pointer; transition: 0.2s; z-index: 100; }

.theme-toggle:hover { background: rgba(255, 255, 255, 0.15); }

.theme-toggle span { font-size: 1rem; }

.toggle-check { width: 18px; height: 18px; border-radius: 50%; border: 2px solid rgba(255, 255, 255, 0.4); display: flex; align-items: center; justify-content: center; font-size: 0.6rem; }

[data-theme="light"] .toggle-check { border-color: rgba(255, 255, 255, 0.7); color: white; }

