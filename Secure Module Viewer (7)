@charset "utf-8";

:root { --bg-dark: #0f1b2d; --bg-panel: #162035; --bg-card: #1c2a42; --bg-light: #f0ede8; --bg-card-light: #ffffff; --bg-panel-light: #e8e4df; --accent: #4a9eff; --accent2: #f0a500; --accent3: #3ddbd9; --text-primary-dark: #e8edf5; --text-secondary-dark: #8fa3c0; --text-primary-light: #1a2540; --text-secondary-light: #5a6a82; --border-dark: rgba(74, 158, 255, 0.15); --border-light: rgba(26, 37, 64, 0.12); --header-bg: #152032; }

* { margin: 0px; padding: 0px; box-sizing: border-box; }

body { font-family: "Source Serif 4", Georgia, serif; background: var(--bg-dark); color: var(--text-primary-dark); transition: background 0.4s, color 0.4s; line-height: 1.8; }

body.light { background: var(--bg-light); color: var(--text-primary-light); }

.theme-bar { position: fixed; top: 18px; right: 24px; z-index: 1000; display: flex; align-items: center; gap: 6px; background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 50px; padding: 6px 10px; }

body.light .theme-bar { background: rgba(255, 255, 255, 0.9); border-color: rgba(0, 0, 0, 0.1); }

.theme-btn { background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; font-size: 16px; padding: 4px 8px; border-radius: 50%; transition: background 0.2s; color: inherit; }

.theme-btn.active { background: var(--accent); color: white; }

.hero { background: linear-gradient(135deg, rgb(13, 31, 53) 0%, rgb(21, 45, 74) 50%, rgb(15, 37, 64) 100%); padding: 80px 60px 70px; position: relative; overflow: hidden; min-height: 320px; }

body.light .hero { background: linear-gradient(135deg, rgb(21, 45, 74) 0%, rgb(30, 63, 106) 50%, rgb(21, 45, 74) 100%); }

.hero::before { content: ""; position: absolute; top: -60px; right: -60px; width: 350px; height: 350px; background: radial-gradient(circle, rgba(74, 158, 255, 0.08) 0%, transparent 70%); border-radius: 50%; }

.hero::after { content: ""; position: absolute; bottom: -40px; left: 30%; width: 250px; height: 250px; background: radial-gradient(circle, rgba(61, 219, 217, 0.05) 0%, transparent 70%); border-radius: 50%; }

.hero h1 { font-family: "Playfair Display", serif; font-size: clamp(2.8rem, 6vw, 4.5rem); font-weight: 900; color: rgb(255, 255, 255); line-height: 1.1; margin-bottom: 16px; letter-spacing: -0.02em; }

.hero p.subtitle { font-size: 1.05rem; color: rgba(255, 255, 255, 0.65); font-weight: 300; margin-bottom: 40px; letter-spacing: 0.01em; }

.hero-meta { display: flex; gap: 50px; flex-wrap: wrap; }

.meta-item label { display: block; font-family: "JetBrains Mono", monospace; font-size: 0.7rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.12em; color: rgba(255, 255, 255, 0.45); margin-bottom: 4px; }

.meta-item span { font-family: "JetBrains Mono", monospace; font-size: 0.85rem; color: rgba(255, 255, 255, 0.7); }

.content-wrap { max-width: 860px; margin: 0px auto; padding: 60px 30px 80px; }

.toc { background: var(--bg-card); border-left: 3px solid var(--accent); border-radius: 0px 12px 12px 0px; padding: 32px 36px; margin-bottom: 60px; transition: background 0.4s; }

body.light .toc { background: var(--bg-card-light); box-shadow: rgba(0, 0, 0, 0.06) 0px 2px 20px; }

.toc-label { font-family: "JetBrains Mono", monospace; font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-secondary-dark); margin-bottom: 18px; }

body.light .toc-label { color: var(--text-secondary-light); }

.toc ol { list-style: none; counter-reset: toc-counter 0; }

.toc ol li { counter-increment: toc-counter 1; display: flex; align-items: baseline; gap: 12px; padding: 7px 0px; border-bottom: 1px solid var(--border-dark); font-size: 0.97rem; }

body.light .toc ol li { border-bottom-color: var(--border-light); }

.toc ol li:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.toc ol li::before { content: counter(toc-counter) "."; font-family: "JetBrains Mono", monospace; font-size: 0.78rem; color: var(--accent); min-width: 22px; }

.toc a { color: var(--accent); text-decoration: none; transition: color 0.2s; }

body.light .toc a { color: rgb(30, 107, 196); }

.toc a:hover { color: var(--accent3); }

section { margin-bottom: 64px; }

h2 { font-family: "Playfair Display", serif; font-size: clamp(1.6rem, 3vw, 2.1rem); font-weight: 700; color: rgb(255, 255, 255); margin-bottom: 20px; margin-top: 10px; line-height: 1.25; }

body.light h2 { color: var(--text-primary-light); }

h3 { font-family: "Playfair Display", serif; font-size: 1.25rem; font-weight: 600; color: var(--accent3); margin: 28px 0px 12px; }

body.light h3 { color: rgb(30, 107, 196); }

h4 { font-family: "JetBrains Mono", monospace; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent2); margin: 22px 0px 8px; }

p { margin-bottom: 16px; font-size: 1rem; color: var(--text-primary-dark); }

body.light p { color: var(--text-primary-light); }

.section-divider { height: 1px; background: linear-gradient(to right, var(--accent), transparent); margin: 16px 0px 28px; opacity: 0.3; }

.callout { border-radius: 10px; padding: 20px 24px; margin: 24px 0px; font-size: 0.97rem; }

.callout.info { background: rgba(74, 158, 255, 0.08); border-left: 3px solid var(--accent); }

.callout.warning { background: rgba(240, 165, 0, 0.08); border-left: 3px solid var(--accent2); }

.callout.tip { background: rgba(61, 219, 217, 0.07); border-left: 3px solid var(--accent3); }

body.light .callout.info { background: rgba(74, 158, 255, 0.07); }

body.light .callout.warning { background: rgba(240, 165, 0, 0.07); }

body.light .callout.tip { background: rgba(61, 219, 217, 0.07); }

.callout-title { font-family: "JetBrains Mono", monospace; font-size: 0.7rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 8px; }

.callout.info .callout-title { color: var(--accent); }

.callout.warning .callout-title { color: var(--accent2); }

.callout.tip .callout-title { color: var(--accent3); }

ul, ol { padding-left: 22px; margin-bottom: 16px; }

li { margin-bottom: 8px; font-size: 0.98rem; }

body.light li { color: var(--text-primary-light); }

code { font-family: "JetBrains Mono", monospace; background: rgba(74, 158, 255, 0.1); color: var(--accent3); padding: 2px 7px; border-radius: 4px; font-size: 0.85em; }

body.light code { background: rgba(30, 107, 196, 0.08); color: rgb(30, 107, 196); }

pre { background: rgb(10, 22, 40); border: 1px solid var(--border-dark); border-radius: 10px; padding: 20px 24px; overflow-x: auto; margin: 18px 0px; font-family: "JetBrains Mono", monospace; font-size: 0.82rem; color: rgb(168, 212, 255); line-height: 1.7; }

body.light pre { background: rgb(244, 247, 251); color: rgb(30, 58, 95); border-color: rgba(0, 0, 0, 0.1); }

.diagram-wrap { margin: 30px 0px; border-radius: 12px; overflow: hidden; border: 1px solid var(--border-dark); }

body.light .diagram-wrap { border-color: var(--border-light); box-shadow: rgba(0, 0, 0, 0.05) 0px 2px 20px; }

.diagram-title { background: var(--bg-panel); padding: 10px 18px; font-family: "JetBrains Mono", monospace; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--text-secondary-dark); }

body.light .diagram-title { background: var(--bg-panel-light); color: var(--text-secondary-light); }

svg text { font-family: "Source Serif 4", serif; }

.cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; margin: 20px 0px; }

.card { background: var(--bg-card); border: 1px solid var(--border-dark); border-radius: 10px; padding: 20px 22px; transition: border-color 0.2s, background 0.4s; }

body.light .card { background: var(--bg-card-light); border-color: var(--border-light); box-shadow: rgba(0, 0, 0, 0.05) 0px 2px 12px; }

.card:hover { border-color: var(--accent); }

.card-icon { font-size: 1.5rem; margin-bottom: 10px; }

.card h4 { font-family: "JetBrains Mono", monospace; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); margin-bottom: 8px; margin-top: 0px; }

body.light .card h4 { color: rgb(30, 107, 196); }

.card p { font-size: 0.88rem; color: var(--text-secondary-dark); margin: 0px; }

body.light .card p { color: var(--text-secondary-light); }

table { width: 100%; border-collapse: collapse; margin: 20px 0px; font-size: 0.9rem; border-radius: 10px; overflow: hidden; }

th { background: var(--bg-panel); padding: 12px 16px; text-align: left; font-family: "JetBrains Mono", monospace; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); border-bottom: 1px solid var(--border-dark); }

body.light th { background: var(--bg-panel-light); border-bottom-color: var(--border-light); color: rgb(30, 107, 196); }

td { padding: 11px 16px; border-bottom: 1px solid var(--border-dark); vertical-align: top; }

body.light td { border-bottom-color: var(--border-light); color: var(--text-primary-light); }

tr:last-child td { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

tr:nth-child(2n) td { background: rgba(255, 255, 255, 0.02); }

body.light tr:nth-child(2n) td { background: rgba(0, 0, 0, 0.02); }

.steps { counter-reset: step-counter 0; margin: 20px 0px; }

.step { counter-increment: step-counter 1; display: flex; gap: 18px; margin-bottom: 20px; align-items: flex-start; }

.step-num { width: 36px; height: 36px; border-radius: 50%; background: var(--accent); color: rgb(255, 255, 255); font-family: "JetBrains Mono", monospace; font-size: 0.85rem; font-weight: 500; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }

.step-content h4 { margin-top: 4px; }

.step-content p { font-size: 0.92rem; margin: 4px 0px 0px; }

.quiz-wrap { background: var(--bg-card); border: 1px solid var(--border-dark); border-radius: 16px; padding: 36px 40px; margin-top: 60px; transition: background 0.4s; }

body.light .quiz-wrap { background: var(--bg-card-light); border-color: var(--border-light); box-shadow: rgba(0, 0, 0, 0.07) 0px 4px 30px; }

.quiz-header { display: flex; align-items: center; gap: 16px; margin-bottom: 32px; }

.quiz-badge { font-family: "JetBrains Mono", monospace; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent); background: rgba(74, 158, 255, 0.1); border: 1px solid rgba(74, 158, 255, 0.2); padding: 4px 10px; border-radius: 50px; }

.quiz-header h2 { font-size: 1.5rem; margin: 0px; }

.quiz-progress { font-family: "JetBrains Mono", monospace; font-size: 0.78rem; color: var(--text-secondary-dark); margin-bottom: 28px; }

body.light .quiz-progress { color: var(--text-secondary-light); }

.question-block { margin-bottom: 36px; }

.question-text { font-size: 1rem; font-weight: 600; margin-bottom: 14px; color: var(--text-primary-dark); }

body.light .question-text { color: var(--text-primary-light); }

.options { display: flex; flex-direction: column; gap: 10px; }

.option { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 8px; border: 1px solid var(--border-dark); cursor: pointer; transition: border-color 0.2s, background 0.2s; font-size: 0.93rem; }

body.light .option { border-color: var(--border-light); }

.option:hover { border-color: var(--accent); background: rgba(74, 158, 255, 0.05); }

.option input[type="radio"] { accent-color: var(--accent); }

.option.correct { border-color: rgb(55, 196, 123); background: rgba(61, 189, 122, 0.08); }

.option.wrong { border-color: rgb(224, 90, 90); background: rgba(224, 90, 90, 0.08); }

.option.selected { border-color: var(--accent); background: rgba(74, 158, 255, 0.07); }

.feedback { margin-top: 10px; font-size: 0.87rem; font-family: "JetBrains Mono", monospace; padding: 8px 12px; border-radius: 6px; display: none; }

.feedback.correct { color: rgb(61, 189, 122); background: rgba(61, 189, 122, 0.08); display: block; }

.feedback.wrong { color: rgb(224, 90, 90); background: rgba(224, 90, 90, 0.08); display: block; }

.quiz-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 10px; }

.btn { padding: 12px 28px; border-radius: 8px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; font-family: "JetBrains Mono", monospace; font-size: 0.82rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em; transition: background 0.2s, transform 0.1s; }

.btn:active { transform: scale(0.98); }

.btn-primary { background: var(--accent); color: white; }

.btn-primary:hover { background: rgb(58, 142, 240); }

.btn-secondary { background: transparent; color: var(--accent); border: 1px solid var(--accent); }

.btn-secondary:hover { background: rgba(74, 158, 255, 0.1); }

.quiz-result { display: none; text-align: center; padding: 30px 0px 10px; }

.quiz-result .score { font-family: "Playfair Display", serif; font-size: 3.5rem; font-weight: 900; color: var(--accent); margin-bottom: 8px; }

.quiz-result p { font-size: 1rem; }

.highlight { color: var(--accent2); font-weight: 600; }

.analogy { background: rgba(240, 165, 0, 0.06); border: 1px dashed rgba(240, 165, 0, 0.25); border-radius: 10px; padding: 18px 22px; margin: 20px 0px; font-style: italic; font-size: 0.96rem; }

.analogy strong { font-style: normal; color: var(--accent2); }

footer { text-align: center; padding: 40px 20px; font-family: "JetBrains Mono", monospace; font-size: 0.72rem; color: var(--text-secondary-dark); border-top: 1px solid var(--border-dark); letter-spacing: 0.08em; text-transform: uppercase; }

body.light footer { color: var(--text-secondary-light); border-top-color: var(--border-light); }

@media (max-width: 600px) {
  .hero { padding: 60px 24px 50px; }
  .content-wrap { padding: 40px 18px 60px; }
  .quiz-wrap { padding: 24px 20px; }
  .hero-meta { gap: 28px; }
}
