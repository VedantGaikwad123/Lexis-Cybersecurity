@charset "utf-8";

:root { --ink: #2a2620; --ink-soft: #514a3d; --paper: #f2ecdc; --paper-edge: #e7dfc7; --frame: #161a17; --frame-line: #2b332d; --tape: #c99a3e; --tape-dark: #a87d2c; --stamp: #a33d2c; --steel: #3c5a56; --steel-soft: #6f8b86; --mono: 'IBM Plex Mono', ui-monospace, monospace; --serif: 'Source Serif 4', Georgia, 'Times New Roman', serif; }

* { box-sizing: border-box; }

html { background: var(--frame); }

body { margin: 0px; font-family: var(--serif); color: var(--ink); background-image: ; background-position-x: ; background-position-y: ; background-size: ; background-repeat: ; background-origin: ; background-clip: ; background-color: ; background-attachment: fixed; min-height: 100vh; }

body::before { content: ""; position: fixed; inset: 0px; background-image: radial-gradient(var(--frame-line) 1px, transparent 1px); background-size: 26px 26px; opacity: 0.35; pointer-events: none; }

.site-header { position: relative; z-index: 2; padding: 38px 24px 18px; text-align: center; }

.site-header .kicker { font-family: var(--mono); font-size: 11px; letter-spacing: 0.32em; color: var(--tape); text-transform: uppercase; }

.site-header h1 { font-family: var(--mono); color: rgb(242, 236, 220); font-weight: 700; font-size: clamp(22px, 4vw, 34px); letter-spacing: 0.01em; margin: 10px 0px 6px; }

.site-header .sub { font-family: var(--serif); font-style: italic; color: rgb(167, 176, 171); font-size: 15px; }

.frame-wrap { position: relative; z-index: 2; max-width: 900px; margin: 0px auto 80px; padding: 0px 20px; }

.paper { position: relative; background: var(--paper); border: 1px solid var(--paper-edge); box-shadow: 0 2px 0 var(--paper-edge),
      0 30px 60px -20px rgba(0,0,0,.65),
      0 8px 24px rgba(0,0,0,.35); padding: 56px 52px 64px; }

.paper::before { content: ""; position: absolute; top: 0px; bottom: 0px; left: 40px; width: 1px; background: repeating-linear-gradient(
      to bottom, var(--stamp) 0 6px, transparent 6px 12px
    ); opacity: 0.28; }

.tab { position: absolute; top: -18px; right: 56px; background: var(--tape); color: rgb(34, 26, 8); font-family: var(--mono); font-weight: 700; font-size: 11px; letter-spacing: 0.18em; padding: 7px 14px 6px; box-shadow: rgba(0, 0, 0, 0.35) 0px 6px 14px; transform: rotate(1.2deg); }

p { margin: 1em 0px; line-height: 1.7; font-size: 16px; }

strong { color: var(--ink); font-weight: 700; }

em { color: var(--ink-soft); }

a { color: var(--steel); text-decoration-color: var(--tape); text-underline-offset: 3px; }

a:hover { color: var(--stamp); }

ul, ol { padding-left: 1.4em; margin: 1em 0px; }

li { margin: 0.4em 0px; line-height: 1.65; }

ul > li::marker { color: var(--tape-dark); }

ol > li::marker { color: var(--steel); font-family: var(--mono); font-weight: 600; }

blockquote { margin: 1.6em 0px; padding: 14px 20px; background: rgba(60, 90, 86, 0.08); border-left: 3px solid var(--steel); color: var(--ink-soft); font-style: italic; }

table { width: 100%; border-collapse: collapse; margin: 1.4em 0px; font-size: 15px; }

th, td { border-bottom: 1px solid var(--paper-edge); padding: 9px 10px; text-align: left; vertical-align: top; }

th { font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--steel); border-bottom: 2px solid var(--steel); }

tbody tr:nth-child(2n+1) { background: rgba(201, 154, 62, 0.07); }

img { max-width: 100%; display: block; margin: 22px auto; border: 6px solid rgb(255, 253, 246); outline: 1px solid var(--paper-edge); box-shadow: rgba(0, 0, 0, 0.28) 0px 10px 26px; }

hr { border-right-width: medium; border-bottom-width: medium; border-left-width: medium; border-right-style: none; border-bottom-style: none; border-left-style: none; border-right-color: currentcolor; border-bottom-color: currentcolor; border-left-color: currentcolor; border-image: none; border-top: 1px dashed var(--paper-edge); margin: 2.2em 0px; }

.hd-part { font-family: var(--mono); font-weight: 700; font-size: 12px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--paper); background: var(--frame); display: block; padding: 16px 20px; margin: 3em -52px 2em; box-shadow: rgba(255, 255, 255, 0.05) 0px 0px 0px 1px inset; }

.paper > .hd-part:first-of-type { margin-top: -4px; }

.hd-section { font-family: var(--mono); font-weight: 700; font-size: 19px; color: var(--ink); letter-spacing: 0.01em; margin: 2.4em 0px 0.9em; padding-bottom: 0.4em; border-bottom: 2px solid var(--tape); display: flex; align-items: baseline; gap: 10px; }

.hd-section .num { font-family: var(--mono); font-size: 13px; color: rgb(255, 255, 255); background: var(--stamp); padding: 2px 8px; border-radius: 2px; letter-spacing: 0px; }

.hd-sub { font-family: var(--mono); font-weight: 600; font-size: 14.5px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--steel); margin: 1.8em 0px 0.5em; }

