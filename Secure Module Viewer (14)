.complete-banner { background: linear-gradient(135deg, rgb(26, 58, 42), rgb(13, 42, 30)); border: 1px solid var(--accent3); border-radius: 4px; padding: 24px 28px; display: none; margin-top: 20px; align-items: center; gap: 18px; }

