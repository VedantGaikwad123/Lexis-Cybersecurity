*, ::before, ::after { box-sizing: border-box; margin: 0px; padding: 0px; }

html { scroll-behavior: smooth; }

body { background: var(--bg); color: var(--text); font-family: "Source Serif 4", Georgia, serif; font-size: 17px; line-height: 1.75; transition: background 0.3s, color 0.3s; }

.theme-toggle { position: fixed; top: 20px; right: 20px; z-index: 999; background: var(--surface); border: 1.5px solid var(--border); border-radius: 50px; padding: 6px 14px; display: flex; align-items: center; gap: 10px; cursor: pointer; box-shadow: rgba(0, 0, 0, 0.25) 0px 4px 20px; transition: 0.3s; }

