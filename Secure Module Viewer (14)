:root[data-theme="dark"] { --bg: #0f1923; --hero-bg: #152032; --surface: #1a2a3a; --surface2: #1e3045; --border: #2a4060; --text: #e8edf2; --text-muted: #8aa0b8; --text-dim: #4a6480; --accent: #4a9eff; --accent2: #f0a045; --accent3: #5cd6a0; --accent-danger: #ff6b6b; --toc-border: #2a5080; --code-bg: #0d1f2d; --tag-bg: #1e3a55; --highlight: #2a4a68; --quiz-correct: #1a3a2a; --quiz-wrong: #3a1a1a; --quiz-correct-border: #5cd6a0; --quiz-wrong-border: #ff6b6b; }

