.quiz-actions { display: flex; gap: 14px; flex-wrap: wrap; }

.btn { padding: 11px 26px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 3px; cursor: pointer; font-family: "Source Serif 4", serif; font-size: 0.88rem; font-weight: 600; transition: 0.2s; letter-spacing: 0.02em; }

