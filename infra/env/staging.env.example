# ==============================================================================
# LEXIS Environment Template: STAGING
# Secrets injected via CI/CD (GitHub Secrets / Vault / AWS Secrets Manager)
# ==============================================================================

NODE_ENV=staging
PORT=5000
API_PREFIX=/api/v1
APP_NAME="LEXIS Platform (Staging)"
CLIENT_URL=https://staging.lexis-app.com

# Auth & Security (Injected in CI pipeline)
JWT_SECRET=${STAGING_JWT_SECRET}
JWT_REFRESH_SECRET=${STAGING_JWT_REFRESH_SECRET}
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=${STAGING_SESSION_SECRET}
BCRYPT_SALT_ROUNDS=12
ENCRYPTION_KEY=${STAGING_ENCRYPTION_KEY}

# Staging Cloud Storage & Databases
MONGO_URI=mongodb+srv://${MONGO_STAGING_USER}:${MONGO_STAGING_PASS}@cluster-staging.mongodb.net/lexis_staging?retryWrites=true&w=majority
MONGO_MAX_POOL_SIZE=20
REDIS_URL=rediss://default:${REDIS_STAGING_PASS}@staging-redis.lexis.internal:6380
REDIS_PASSWORD=${REDIS_STAGING_PASS}
QDRANT_URL=https://staging-qdrant.lexis.internal:6333
QDRANT_API_KEY=${STAGING_QDRANT_API_KEY}

# AI Providers (Staging Keys with Usage Quotas)
OPENAI_API_KEY=${STAGING_OPENAI_API_KEY}
OPENAI_MODEL=gpt-4o-mini
SARVAM_API_KEY=${STAGING_SARVAM_API_KEY}

# Telephony / OTP (Staging Sandbox Tier)
SMS_PROVIDER=msg91
SMS_PROVIDER_KEY=${STAGING_SMS_PROVIDER_KEY}
SMS_SENDER_ID=LEXISSTG

# Network & Hardening
ALLOWED_ORIGINS=https://staging.lexis-app.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX_REQUESTS=10
