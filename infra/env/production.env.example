# ==============================================================================
# LEXIS Environment Template: PRODUCTION
# MANDATORY ENCRYPTION AT REST, HIGH AVAILABILITY, HARDENED RATELIMITS
# ==============================================================================

NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1
APP_NAME="LEXIS Legal Intelligence Platform"
CLIENT_URL=https://app.lexis.com

# Auth & Security (High entropy HSM / Vault generated)
JWT_SECRET=${PROD_JWT_SECRET}
JWT_REFRESH_SECRET=${PROD_JWT_REFRESH_SECRET}
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=${PROD_SESSION_SECRET}
BCRYPT_SALT_ROUNDS=12
ENCRYPTION_KEY=${PROD_ENCRYPTION_KEY}

# High-Availability Database Infrastructure (TLS Enforced)
MONGO_URI=mongodb+srv://${MONGO_PROD_USER}:${MONGO_PROD_PASS}@cluster-prod.mongodb.net/lexis_prod?retryWrites=true&w=majority&tls=true
MONGO_MAX_POOL_SIZE=50
REDIS_URL=rediss://default:${REDIS_PROD_PASS}@prod-redis.lexis.internal:6380
REDIS_PASSWORD=${REDIS_PROD_PASS}
QDRANT_URL=https://prod-qdrant.lexis.internal:6333
QDRANT_API_KEY=${PROD_QDRANT_API_KEY}

# Production AI Engine Keys
OPENAI_API_KEY=${PROD_OPENAI_API_KEY}
OPENAI_MODEL=gpt-4o
SARVAM_API_KEY=${PROD_SARVAM_API_KEY}

# Production SMS / OTP Telephony Gateway
SMS_PROVIDER=msg91
SMS_PROVIDER_KEY=${PROD_SMS_PROVIDER_KEY}
SMS_SENDER_ID=LEXIS

# Production Network Hardening Parameters
ALLOWED_ORIGINS=https://app.lexis.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5
