          </tr>
        </thead>
        <tbody>
          <tr>
            <td>MD5</td>
            <td>128-bit (32 hex chars)</td>
            <td>Very Fast</td>
            <td>Broken</td>
            <td>❌ Deprecated</td>
          </tr>
          <tr>
            <td>SHA-1</td>
            <td>160-bit (40 hex chars)</td>
            <td>Fast</td>
            <td>Weak (collisions found)</td>
            <td>⚠️ Legacy</td>
          </tr>
          <tr>
            <td>SHA-256</td>
            <td>256-bit (64 hex chars)</td>
            <td>Fast</td>
            <td>Strong</td>
            <td>✅ Recommended</td>
          </tr>
          <tr>
            <td>SHA-512</td>
            <td>512-bit (128 hex chars)</td>
            <td>Fast</td>
            <td>Very Strong</td>
            <td>✅ Recommended</td>
          </tr>
          <tr>
            <td>bcrypt</td>
            <td>60 chars</td>
            <td>Slow (by design)</td>
            <td>Strong for passwords</td>
            <td>✅ Best for passwords</td>
          </tr>
          <tr>
            <td>Argon2</td>
            <td>Variable</td>
            <td>Slow (tunable)</td>
            <td>Strongest</td>
            <td>✅ Modern gold standard</td>
          </tr>
          <tr>
            <td>SHA-3 (Keccak)</td>
