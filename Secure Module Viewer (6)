        <text x="110" y="116" font-family="sans-serif" font-size="11" fill="#2e7d52">bcrypt: ~10,000
          hashes/second</text>
        <text x="68" y="116" text-anchor="end" font-family="sans-serif" font-size="11" fill="#1a2e4a">bcrypt</text>
