      <svg viewBox="0 0 620 160" xmlns="http://www.w3.org/2000/svg" width="100%">
        <text x="310" y="18" text-anchor="middle" font-family="sans-serif" font-size="12" font-weight="600" fill="#1a2e4a">GPU Cracking Speed: MD5 vs bcrypt</text>
