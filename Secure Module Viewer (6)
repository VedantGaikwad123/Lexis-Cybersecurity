*, ::before, ::after { box-sizing: border-box; margin: 0px; padding: 0px; }

:root { --navy: #1a2e4a; --navy-dark: #0f1e33; --navy-light: #24406b; --cream: #f5f2ed; --cream-dark: #ede9e2; --white: #ffffff; --text-dark: #1a1a2e; --text-muted: #5a6a7a; --text-light: #8a9ab0; --accent: #4a90d9; --accent2: #e8734a; --border: rgba(26, 46, 74, 0.12); --code-bg: #1e2d42; --success: #2e7d52; --warning: #b85c1a; --card-bg: #ffffff; --analogy-bg: #fff8f4; --diagram-bg: #ffffff; --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }

body.dark-mode { --navy: #0d1117; --navy-dark: #010409; --navy-light: #161b22; --cream: #0d1117; --cream-dark: #161b22; --white: #161b22; --text-dark: #c9d1d9; --text-muted: #8b949e; --text-light: #484f58; --accent: #58a6ff; --accent2: #f0883e; --border: rgba(240, 246, 252, 0.1); --code-bg: #010409; --card-bg: #0d1117; --analogy-bg: #161b22; --diagram-bg: #0d1117; }

body { font-family: "Source Sans 3", sans-serif; background: var(--cream); color: var(--text-dark); font-size: 16px; line-height: 1.75; transition: var(--transition); text-align: center; }

.theme-toggle { position: fixed; top: 20px; right: 20px; z-index: 1000; background: var(--navy); color: white; width: 44px; height: 44px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: rgba(0, 0, 0, 0.2) 0px 4px 12px; transition: var(--transition); border: 1px solid rgba(255, 255, 255, 0.1); }

.theme-toggle:hover { transform: scale(1.1); background: var(--accent); }

.theme-toggle .sun-icon { display: none; }

.theme-toggle .moon-icon { display: block; }

body.dark-mode .theme-toggle .sun-icon { display: block; }

body.dark-mode .theme-toggle .moon-icon { display: none; }

.hero { background: var(--navy); color: white; padding: 70px 60px 60px; position: relative; overflow: hidden; }

.hero::before { content: ""; position: absolute; top: -80px; right: -80px; width: 320px; height: 320px; border: 60px solid rgba(255, 255, 255, 0.04); border-radius: 50%; }

.hero::after { content: ""; position: absolute; bottom: -40px; left: 30%; width: 180px; height: 180px; border: 40px solid rgba(255, 255, 255, 0.03); border-radius: 50%; }

.hero h1 { font-family: "Playfair Display", serif; font-size: 3.2rem; font-weight: 700; letter-spacing: -0.5px; margin-bottom: 14px; position: relative; }

.hero p.subtitle { font-size: 1.05rem; color: rgba(255, 255, 255, 0.65); margin-bottom: 36px; font-weight: 300; }

.hero-meta { display: flex; gap: 48px; flex-wrap: wrap; }

.hero-meta div label { display: block; font-size: 0.78rem; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255, 255, 255, 0.45); margin-bottom: 3px; }

.hero-meta div span { font-size: 0.93rem; color: rgba(255, 255, 255, 0.85); }

.toc-wrap { background: var(--white); border-left: 4px solid var(--navy); margin: 48px 60px; padding: 28px 36px; border-radius: 0px 8px 8px 0px; box-shadow: rgba(0, 0, 0, 0.06) 0px 2px 12px; }

.toc-label { font-size: 0.72rem; letter-spacing: 2px; text-transform: uppercase; color: var(--text-muted); font-weight: 600; margin-bottom: 14px; }

.toc-wrap ol { columns: 2; column-gap: 40px; padding-left: 18px; }

.toc-wrap li { font-size: 0.93rem; margin-bottom: 7px; color: var(--navy); font-weight: 400; }

.toc-wrap li a { color: var(--navy); text-decoration: none; }

.toc-wrap li a:hover { color: var(--accent); text-decoration: underline; }

.content { padding: 0px 60px 60px; }

.section { margin-bottom: 60px; }

h2.section-title { font-family: "Playfair Display", serif; font-size: 2rem; font-weight: 700; color: var(--navy); border-bottom: 2px solid var(--navy); padding-bottom: 10px; margin-bottom: 24px; }

h3.sub-title { font-family: "Playfair Display", serif; font-size: 1.35rem; color: var(--navy-light); margin: 28px 0px 12px; }

p { margin-bottom: 18px; font-size: 1.05rem; max-width: 800px; margin-left: auto; margin-right: auto; }

.callout { background: var(--navy); color: white; border-radius: 8px; padding: 20px 24px; margin: 20px 0px; font-size: 0.93rem; line-height: 1.6; }

.callout strong { color: rgb(126, 184, 245); }

.analogy-box { background: var(--analogy-bg); border-top: 4px solid var(--accent2); padding: 24px 30px; margin: 30px auto; border-radius: 12px; font-size: 1rem; max-width: 800px; box-shadow: rgba(0, 0, 0, 0.05) 0px 4px 15px; }

.analogy-box .label { font-weight: 600; color: var(--accent2); font-size: 0.78rem; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 5px; }

code.inline { background: var(--code-bg); color: rgb(126, 184, 245); padding: 2px 8px; border-radius: 4px; font-family: "Courier New", monospace; font-size: 0.88rem; }

.code-block { background: var(--code-bg); color: rgb(168, 200, 240); border-radius: 8px; padding: 20px 24px; font-family: "Courier New", monospace; font-size: 0.85rem; overflow-x: auto; margin: 18px 0px; line-height: 1.6; }

.code-block .comment { color: rgb(90, 122, 154); }

.code-block .key { color: rgb(126, 184, 245); }

.code-block .val { color: rgb(240, 192, 112); }

.diagram-wrap { background: var(--diagram-bg); border-radius: 10px; padding: 24px; margin: 24px 0px; border: 1px solid var(--border); box-shadow: rgba(0, 0, 0, 0.05) 0px 2px 10px; }

.diagram-wrap svg { display: block; margin: 0px auto; }

body.dark-mode .diagram-wrap svg rect[fill="#e8f0fb"] { fill: var(--navy-light); }

body.dark-mode .diagram-wrap svg rect[fill="#fff3e8"] { fill: rgb(44, 26, 10); }

body.dark-mode .diagram-wrap svg text[fill="#1a2e4a"] { fill: rgb(201, 209, 217); }

body.dark-mode .diagram-wrap svg text[fill="#5a6a7a"] { fill: rgb(139, 148, 158); }

body.dark-mode .diagram-wrap svg line { stroke: rgb(48, 54, 61); }

.diagram-caption { text-align: center; font-size: 0.82rem; color: var(--text-muted); margin-top: 12px; font-style: italic; }

.hash-table { width: 100%; border-collapse: collapse; margin: 20px 0px; font-size: 0.88rem; }

.hash-table th { background: var(--navy); color: white; padding: 10px 14px; text-align: left; font-weight: 600; font-size: 0.8rem; letter-spacing: 0.5px; }

.hash-table td { padding: 10px 14px; border-bottom: 1px solid var(--border); font-family: "Courier New", monospace; font-size: 0.82rem; }

.hash-table tr:nth-child(2n) td { background: var(--cream-dark); }

.hash-table td:first-child { font-family: "Source Sans 3", sans-serif; font-weight: 600; color: var(--navy); }

.cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin: 22px 0px; }

.card { background: var(--card-bg); border-radius: 10px; padding: 20px; border: 1px solid var(--border); }

.card .card-icon { width: 40px; height: 40px; background: var(--navy); border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 12px; font-size: 18px; }

.card h4 { font-size: 0.97rem; font-weight: 600; color: var(--navy); margin-bottom: 7px; }

.card p { font-size: 0.85rem; color: var(--text-muted); margin: 0px; line-height: 1.5; }

.pros-cons { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 30px auto; max-width: 900px; }

.pros-box, .cons-box { background: var(--card-bg); border-radius: 8px; padding: 18px 20px; border: 1px solid var(--border); }

.pros-box h4 { color: var(--success); font-size: 0.93rem; margin-bottom: 10px; }

.cons-box h4 { color: var(--warning); font-size: 0.93rem; margin-bottom: 10px; }

.pros-box ul, .cons-box ul { padding-left: 18px; }

.pros-box li, .cons-box li { font-size: 0.87rem; margin-bottom: 6px; color: var(--text-dark); }

.step-list { counter-reset: step 0; list-style: none; padding: 0px; margin: 18px 0px; }

.step-list li { counter-increment: step 1; display: flex; flex-direction: column; align-items: center; gap: 12px; margin-bottom: 30px; }

.step-list li::before { content: counter(step); min-width: 30px; height: 30px; background: var(--navy); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.82rem; font-weight: 700; flex-shrink: 0; margin-top: 2px; }

.step-list li p { margin: 0px; font-size: 0.92rem; }

.step-list li strong { color: var(--navy); }

.quiz-section { background: var(--navy); padding: 48px 60px; margin-top: 60px; }

.quiz-section h2 { font-family: "Playfair Display", serif; color: white; font-size: 2rem; margin-bottom: 10px; }

.quiz-section > p { color: rgba(255, 255, 255, 0.6); font-size: 0.9rem; margin-bottom: 36px; }

.quiz-card { background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 10px; padding: 24px 26px; margin-bottom: 22px; }

.quiz-q { color: white; font-size: 0.97rem; font-weight: 600; margin-bottom: 16px; line-height: 1.5; }

.quiz-q span { background: rgba(255, 255, 255, 0.15); color: rgba(255, 255, 255, 0.8); font-size: 0.75rem; padding: 2px 8px; border-radius: 4px; margin-right: 8px; font-weight: 400; }

.options { display: flex; flex-direction: column; gap: 9px; }

.opt-btn { background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.15); color: rgba(255, 255, 255, 0.85); border-radius: 7px; padding: 10px 16px; cursor: pointer; font-size: 0.9rem; text-align: left; transition: background 0.2s, border-color 0.2s; font-family: "Source Sans 3", sans-serif; }

.opt-btn:hover { background: rgba(255, 255, 255, 0.13); border-color: rgba(255, 255, 255, 0.3); }

.opt-btn.correct { background: rgba(46, 125, 82, 0.4); border-color: rgb(76, 175, 128); color: rgb(168, 240, 198); }

.opt-btn.wrong { background: rgba(180, 50, 50, 0.35); border-color: rgb(224, 96, 96); color: rgb(245, 176, 176); }

.opt-btn.reveal { opacity: 0.45; pointer-events: none; }

.feedback { margin-top: 12px; font-size: 0.87rem; font-weight: 600; display: none; padding: 10px 14px; border-radius: 6px; }

.feedback.correct-fb { background: rgba(46, 125, 82, 0.3); color: rgb(168, 240, 198); display: block; }

.feedback.wrong-fb { background: rgba(180, 50, 50, 0.25); color: rgb(245, 176, 176); display: block; }

.score-bar { background: rgba(255, 255, 255, 0.08); border-radius: 10px; padding: 20px 24px; text-align: center; color: white; margin-top: 10px; }

.score-bar .score-num { font-size: 2.5rem; font-weight: 700; font-family: "Playfair Display", serif; }

.score-bar p { font-size: 0.88rem; color: rgba(255, 255, 255, 0.6); margin-top: 4px; }

.quiz-btn { display: inline-block; margin-top: 20px; padding: 12px 28px; border-radius: 6px; font-weight: 600; cursor: pointer; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; font-family: inherit; transition: var(--transition); font-size: 0.95rem; }

.reattempt-btn { background: var(--accent2); color: white; }

.reattempt-btn:hover { background: rgb(214, 96, 56); transform: translateY(-2px); }

.submit-btn { background: rgb(46, 125, 82); color: white; }

.submit-btn:hover { background: rgb(36, 99, 65); transform: translateY(-2px); }

.submit-btn:disabled { background: rgb(160, 160, 160); cursor: not-allowed; transform: none; }

.footer-submit-wrap { padding: 40px 0px 80px; background: var(--cream-dark); text-align: center; }

.main-submit-btn { padding: 16px 48px; font-size: 1.2rem; border-radius: 50px; background: var(--navy); color: white; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; font-weight: 700; transition: var(--transition); box-shadow: rgba(0, 0, 0, 0.1) 0px 10px 20px; }

.main-submit-btn:hover { background: var(--accent); transform: scale(1.05); }

.status-msg { margin-top: 15px; font-weight: 600; font-size: 1rem; }

.status-msg.error { color: rgb(192, 57, 43); }

.status-msg.success { color: rgb(46, 125, 82); }

hr.section-div { border-right-width: medium; border-bottom-width: medium; border-left-width: medium; border-right-style: none; border-bottom-style: none; border-left-style: none; border-right-color: currentcolor; border-bottom-color: currentcolor; border-left-color: currentcolor; border-image: none; border-top: 2px solid var(--border); margin: 50px 0px; }

ul.bullet-list { padding-left: 20px; margin: 10px 0px; }

ul.bullet-list li { margin-bottom: 8px; font-size: 0.94rem; }

@media (max-width: 700px) {
  .hero { padding: 40px 24px; }
