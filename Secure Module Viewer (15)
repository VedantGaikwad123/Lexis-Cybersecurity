.step-list { list-style: none; padding: 0px; counter-reset: steps 0; margin: 18px 0px; }

.step-list li { counter-increment: steps 1; display: flex; gap: 16px; align-items: flex-start; margin-bottom: 14px; padding: 14px 18px; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; }

.step-list li::before { content: counter(steps); min-width: 28px; height: 28px; background: var(--navy); color: rgb(255, 255, 255); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: "Source Code Pro", monospace; font-size: 0.75rem; font-weight: 700; flex-shrink: 0; }

[data-theme="dark"] .step-list li::before { background: var(--accent); color: rgb(13, 31, 48); }

.tag { display: inline-block; background: var(--tag-bg); color: var(--accent); border: 1px solid rgba(74, 158, 218, 0.3); border-radius: 3px; padding: 2px 8px; font-family: "Source Code Pro", monospace; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.05em; margin: 2px; }

.compare-table { width: 100%; border-collapse: collapse; margin: 20px 0px; font-size: 0.9rem; }

.compare-table th { background: var(--navy); color: rgb(255, 255, 255); padding: 12px 16px; text-align: left; font-family: "Source Code Pro", monospace; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; }

[data-theme="dark"] .compare-table th { background: rgb(30, 58, 90); }

.compare-table td { padding: 10px 16px; border-bottom: 1px solid var(--border); vertical-align: top; }

.compare-table tr:nth-child(2n) td { background: var(--surface2); }

.compare-table tr:hover td { background: var(--tag-bg); }

.vuln-demo { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; margin: 24px 0px; overflow: hidden; box-shadow: var(--shadow); }

.vuln-demo-header { background: var(--navy); padding: 14px 22px; display: flex; align-items: center; gap: 12px; }

[data-theme="dark"] .vuln-demo-header { background: rgb(30, 58, 90); }

.vuln-demo-header .vuln-title { font-family: "Source Code Pro", monospace; font-size: 0.82rem; font-weight: 600; color: rgb(255, 255, 255); letter-spacing: 0.06em; }

.severity-badge { font-family: "Source Code Pro", monospace; font-size: 0.65rem; font-weight: 700; padding: 3px 8px; border-radius: 3px; letter-spacing: 0.1em; text-transform: uppercase; }

.sev-critical { background: var(--danger); color: rgb(255, 255, 255); }

.sev-high { background: var(--warning); color: rgb(255, 255, 255); }

.sev-medium { background: var(--accent2); color: rgb(51, 51, 51); }

.vuln-demo-body { padding: 22px; }

.report-box { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 28px; margin: 22px 0px; box-shadow: var(--shadow); font-family: Lora, serif; }

.report-box .report-field { display: grid; grid-template-columns: 160px 1fr; gap: 8px 16px; margin-bottom: 12px; font-size: 0.9rem; border-bottom: 1px solid var(--border); padding-bottom: 10px; }

.report-box .report-field:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; margin-bottom: 0px; padding-bottom: 0px; }

.report-field label { font-family: "Source Code Pro", monospace; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-light); padding-top: 2px; }

.flow-diagram { display: flex; align-items: center; gap: 0px; flex-wrap: wrap; justify-content: center; margin: 24px 0px; }

.flow-node { background: var(--surface); border: 1.5px solid var(--border); border-radius: 6px; padding: 14px 18px; text-align: center; min-width: 120px; box-shadow: var(--shadow); }

.flow-node .fn-icon { font-size: 1.6rem; display: block; margin-bottom: 4px; }

.flow-node .fn-label { font-family: "Source Code Pro", monospace; font-size: 0.72rem; font-weight: 600; color: var(--text-muted); }

.flow-arrow { font-size: 1.4rem; color: var(--accent); padding: 0px 6px; flex-shrink: 0; }

.quiz-section { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 36px; margin: 48px 0px 60px; box-shadow: var(--shadow); }

.quiz-header { font-family: "Playfair Display", serif; font-size: 1.8rem; font-weight: 700; color: var(--navy); margin-bottom: 6px; }

[data-theme="dark"] .quiz-header { color: rgb(168, 212, 248); }

.quiz-sub { font-size: 0.9rem; color: var(--text-muted); margin-bottom: 32px; font-style: italic; }

.quiz-q { margin-bottom: 32px; padding-bottom: 28px; border-bottom: 1px solid var(--border); }

.quiz-q:last-of-type { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.q-num { font-family: "Source Code Pro", monospace; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em; color: var(--accent); text-transform: uppercase; margin-bottom: 6px; }

.q-text { font-size: 1rem; font-weight: 600; margin-bottom: 16px; color: var(--text); }

.options { display: flex; flex-direction: column; gap: 10px; }

.opt-btn { background: var(--surface2); border: 1.5px solid var(--border); border-radius: 6px; padding: 12px 18px; text-align: left; cursor: pointer; font-family: Lora, serif; font-size: 0.92rem; color: var(--text); transition: 0.2s; display: flex; gap: 12px; align-items: center; }

.opt-btn:hover:not(:disabled) { border-color: var(--accent); background: var(--tag-bg); }

.opt-btn:disabled { cursor: default; }

.opt-btn.correct { background: rgba(61, 186, 126, 0.12); border-color: var(--success); color: var(--success); }

.opt-btn.wrong { background: rgba(224, 85, 85, 0.1); border-color: var(--danger); color: var(--danger); }

.opt-letter { font-family: "Source Code Pro", monospace; font-size: 0.78rem; font-weight: 700; min-width: 22px; height: 22px; border-radius: 50%; background: var(--border); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: 0.2s; }

.opt-btn.correct .opt-letter { background: var(--success); color: rgb(255, 255, 255); }

.opt-btn.wrong .opt-letter { background: var(--danger); color: rgb(255, 255, 255); }

.q-feedback { margin-top: 10px; padding: 8px 14px; border-radius: 4px; font-size: 0.85rem; display: none; }

.q-feedback.show { display: block; }

.q-feedback.correct-fb { background: rgba(61, 186, 126, 0.12); color: var(--success); border-left: 3px solid var(--success); }

.q-feedback.wrong-fb { background: rgba(224, 85, 85, 0.1); color: var(--danger); border-left: 3px solid var(--danger); }

.quiz-actions { margin-top: 28px; display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }

.quiz-score { font-family: "Source Code Pro", monospace; font-size: 1rem; font-weight: 600; color: var(--text-muted); margin-bottom: 16px; display: none; }

.quiz-score span { color: var(--navy); }

[data-theme="dark"] .quiz-score span { color: var(--accent); }

.btn { font-family: "Source Code Pro", monospace; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; padding: 12px 24px; border-radius: 5px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; transition: 0.2s; }

.btn-primary { background: var(--navy); color: rgb(255, 255, 255); }

.btn-primary:hover:not(:disabled) { background: var(--navy-dark); transform: translateY(-1px); }

.btn-primary:disabled { opacity: 0.4; cursor: not-allowed; }

.btn-outline { background: transparent; color: var(--text-muted); border: 1.5px solid var(--border); }

.btn-outline:hover { border-color: var(--accent); color: var(--accent); }

.complete-banner { display: none; background: linear-gradient(135deg, var(--navy) 0%, #1e5080 100%); color: rgb(255, 255, 255); border-radius: 8px; padding: 22px 28px; margin-top: 20px; text-align: center; }

.complete-banner.show { display: block; }

.complete-banner h3 { font-family: "Playfair Display", serif; font-size: 1.4rem; margin-bottom: 6px; }

.complete-banner p { font-size: 0.9rem; opacity: 0.8; margin: 0px; }

.cannot-submit-msg { color: var(--danger); font-family: "Source Code Pro", monospace; font-size: 0.78rem; display: none; margin-top: 8px; }

.cannot-submit-msg.show { display: block; }

.progress-bar-wrap { background: var(--border); border-radius: 99px; height: 6px; margin-bottom: 28px; overflow: hidden; }

.progress-bar-fill { height: 100%; background: linear-gradient(90deg, var(--accent), var(--success)); border-radius: 99px; transition: width 0.4s; width: 0%; }

.divider { border-right-width: medium; border-bottom-width: medium; border-left-width: medium; border-right-style: none; border-bottom-style: none; border-left-style: none; border-right-color: currentcolor; border-bottom-color: currentcolor; border-left-color: currentcolor; border-image: none; border-top: 1px solid var(--border); margin: 40px 0px; }

footer { background: var(--navy-deeper); color: rgba(255, 255, 255, 0.4); text-align: center; padding: 24px; font-family: "Source Code Pro", monospace; font-size: 0.72rem; letter-spacing: 0.06em; }

@media (max-width: 650px) {
  .hero { padding: 60px 24px; }
  .owasp-grid { grid-template-columns: 1fr; }
  .flow-diagram { flex-direction: column; }
  .flow-arrow { transform: rotate(90deg); }
  .quiz-section { padding: 24px 18px; }
  .compare-table { font-size: 0.8rem; }
  .report-box .report-field { grid-template-columns: 1fr; }
}

code { font-family: "Source Code Pro", monospace; font-size: 0.85em; background: var(--surface2); border: 1px solid var(--border); border-radius: 3px; padding: 1px 6px; color: var(--accent); }

[data-theme="dark"] code { background: rgb(26, 48, 80); }
