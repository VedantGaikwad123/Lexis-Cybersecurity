@charset "utf-8";

:root { --navy: #1a2f4e; --navy-dark: #142440; --navy-mid: #1e3558; --cream: #f0ece4; --cream-dark: #e5e0d6; --cream-text: #c8c0b0; --gold: #c9993a; --gold-light: #e8b84b; --teal: #2a8a7f; --teal-light: #3ab5a8; --red-accent: #c0392b; --white: #ffffff; --text-dark: #1a1a2e; --text-mid: #3d3d5a; --text-muted: #6b6b8a; --android-green: #3ddc84; --ios-silver: #8e8e93; }

[data-theme="dark"] { --cream: #121826; --cream-dark: #1f2937; --cream-text: #9ca3af; --white: #1f2937; --text-dark: #f3f4f6; --text-mid: #d1d5db; --navy: #111827; --navy-dark: #030712; --navy-mid: #374151; }

* { box-sizing: border-box; margin: 0px; padding: 0px; }

body { font-family: "Source Serif 4", Georgia, serif; background: var(--cream); color: var(--text-dark); line-height: 1.75; }

.hero { background: var(--navy); padding: 60px 60px 50px; position: relative; overflow: hidden; }

.hero::before { content: ""; position: absolute; inset: 0px; background: repeating-linear-gradient(45deg, transparent, transparent 40px, rgba(255, 255, 255, 0.016) 40px, rgba(255, 255, 255, 0.016) 80px); }

.hero-controls { position: absolute; top: 24px; right: 32px; display: flex; gap: 8px; background: rgba(255, 255, 255, 0.12); padding: 8px 14px; border-radius: 30px; align-items: center; font-family: "JetBrains Mono", monospace; font-size: 11px; color: rgba(255, 255, 255, 0.7); }

.hero-controls span { cursor: pointer; font-size: 15px; }

.hero h1 { font-family: "Playfair Display", serif; font-size: clamp(42px, 6vw, 76px); font-weight: 900; color: rgb(255, 255, 255); line-height: 1.05; position: relative; z-index: 1; letter-spacing: -1px; }

.hero-sub { font-family: "Source Serif 4", serif; font-weight: 300; font-style: italic; color: var(--cream-text); font-size: 18px; margin-top: 12px; position: relative; z-index: 1; }

.hero-meta { display: flex; gap: 48px; margin-top: 36px; position: relative; z-index: 1; }

.hero-meta-item label { display: block; font-family: "JetBrains Mono", monospace; font-size: 11px; font-weight: 500; letter-spacing: 0.12em; color: rgba(255, 255, 255, 0.45); text-transform: uppercase; margin-bottom: 4px; }

.hero-meta-item span { font-family: "Source Serif 4", serif; font-size: 13px; color: rgba(255, 255, 255, 0.65); }

.badge-android { display: inline-flex; align-items: center; gap: 6px; background: rgba(61, 220, 132, 0.15); border: 1px solid rgba(61, 220, 132, 0.3); color: var(--android-green); padding: 3px 10px; border-radius: 4px; font-family: "JetBrains Mono", monospace; font-size: 11px; font-weight: 500; letter-spacing: 0.05em; }

.badge-ios { display: inline-flex; align-items: center; gap: 6px; background: rgba(142, 142, 147, 0.15); border: 1px solid rgba(142, 142, 147, 0.3); color: var(--ios-silver); padding: 3px 10px; border-radius: 4px; font-family: "JetBrains Mono", monospace; font-size: 11px; font-weight: 500; letter-spacing: 0.05em; }

.content-wrapper { max-width: 1100px; margin: 0px auto; padding: 0px 40px; }

.toc-section { background: var(--cream); padding: 50px 60px; }

.toc-box { background: var(--white); border-left: 4px solid var(--navy); padding: 32px 40px; max-width: 800px; margin: 0px auto; }

.toc-box .toc-label { font-family: "JetBrains Mono", monospace; font-size: 10px; letter-spacing: 0.2em; color: var(--text-muted); text-transform: uppercase; margin-bottom: 20px; }

.toc-box ol { list-style: none; counter-reset: toc 0; }

.toc-box ol li { counter-increment: toc 1; padding: 6px 0px; font-size: 15px; display: flex; align-items: baseline; gap: 12px; border-bottom: 1px solid var(--cream-dark); }

.toc-box ol li:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.toc-box ol li::before { content: counter(toc) "."; font-family: "JetBrains Mono", monospace; font-size: 12px; color: var(--navy); font-weight: 500; min-width: 20px; }

.toc-box ol li a { color: var(--navy); text-decoration: none; transition: color 0.2s; }

.toc-box ol li a:hover { color: var(--teal); }

main { padding: 60px; max-width: 1100px; margin: 0px auto; }

.section-block { margin-bottom: 60px; }

h2.section-title { font-family: "Playfair Display", serif; font-size: 34px; font-weight: 700; color: var(--navy); margin-bottom: 6px; border-bottom: 2px solid var(--navy); padding-bottom: 10px; }

h3.sub-title { font-family: "Playfair Display", serif; font-size: 22px; font-weight: 700; color: var(--navy-mid); margin: 32px 0px 12px; }

h4.sub-sub-title { font-family: "Source Serif 4", serif; font-size: 17px; font-weight: 600; color: var(--text-mid); margin: 22px 0px 8px; }

p { font-size: 16px; margin-bottom: 16px; color: var(--text-dark); line-height: 1.8; }

.callout { background: var(--navy); color: rgba(255, 255, 255, 0.88); padding: 24px 32px; border-radius: 2px; margin: 28px 0px; position: relative; }

.callout::before { content: "\""; font-family: "Playfair Display", serif; font-size: 80px; color: var(--gold); opacity: 0.4; position: absolute; top: -8px; left: 16px; line-height: 1; }

.callout p { color: rgba(255, 255, 255, 0.88); font-style: italic; font-size: 15px; padding-left: 24px; margin-bottom: 0px; }

.callout .callout-source { font-style: normal; font-size: 12px; color: var(--gold-light); font-family: "JetBrains Mono", monospace; margin-top: 8px; padding-left: 24px; display: block; }

.tip-box { background: rgba(26, 47, 78, 0.06); border-left: 3px solid var(--teal); padding: 16px 20px; margin: 20px 0px; border-radius: 0px 4px 4px 0px; }

.tip-box p { margin-bottom: 0px; font-size: 14px; }

.tip-box strong { color: var(--teal); font-family: "JetBrains Mono", monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; display: block; margin-bottom: 6px; }

.warning-box { background: rgba(192, 57, 43, 0.06); border-left: 3px solid var(--red-accent); padding: 16px 20px; margin: 20px 0px; border-radius: 0px 4px 4px 0px; }

.warning-box p { margin-bottom: 0px; font-size: 14px; }

.warning-box strong { color: var(--red-accent); font-family: "JetBrains Mono", monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; display: block; margin-bottom: 6px; }

.compare-table { width: 100%; border-collapse: collapse; margin: 24px 0px; font-size: 14px; }

.compare-table thead tr { background: var(--navy); color: white; }

.compare-table thead th { padding: 14px 18px; text-align: left; font-family: "JetBrains Mono", monospace; font-size: 12px; font-weight: 500; letter-spacing: 0.06em; }

.compare-table thead th:first-child { width: 30%; }

.compare-table tbody tr:nth-child(2n) { background: rgba(26, 47, 78, 0.04); }

.compare-table tbody tr:hover { background: rgba(26, 47, 78, 0.08); }

.compare-table tbody td { padding: 12px 18px; border-bottom: 1px solid var(--cream-dark); vertical-align: top; }

.compare-table tbody td:first-child { font-family: "JetBrains Mono", monospace; font-size: 12px; font-weight: 500; color: var(--navy); background: rgba(26, 47, 78, 0.04); }

.tag-android { display: inline-block; background: rgba(61, 220, 132, 0.12); color: rgb(26, 122, 74); padding: 2px 7px; border-radius: 3px; font-size: 12px; font-family: "JetBrains Mono", monospace; margin-right: 4px; }

.tag-ios { display: inline-block; background: rgba(100, 100, 140, 0.12); color: rgb(61, 61, 106); padding: 2px 7px; border-radius: 3px; font-size: 12px; font-family: "JetBrains Mono", monospace; }

.step-list { list-style: none; margin: 20px 0px; }

.step-list li { display: flex; gap: 16px; margin-bottom: 16px; align-items: flex-start; }

.step-num { background: var(--navy); color: white; font-family: "JetBrains Mono", monospace; font-size: 12px; font-weight: 500; min-width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; border-radius: 50%; flex-shrink: 0; margin-top: 4px; }

.step-content strong { display: block; font-family: "Source Serif 4", serif; font-weight: 600; font-size: 15px; color: var(--navy); margin-bottom: 3px; }

.step-content span { font-size: 14px; color: var(--text-mid); line-height: 1.6; }

.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin: 24px 0px; }

.platform-card { background: white; border: 1px solid var(--cream-dark); padding: 24px; border-radius: 2px; }

.platform-card.android { border-top: 3px solid var(--android-green); }

.platform-card.ios { border-top: 3px solid var(--ios-silver); }

.platform-card h4 { font-family: "Playfair Display", serif; font-size: 18px; color: var(--navy); margin-bottom: 14px; display: flex; align-items: center; gap: 10px; }

.platform-card h4 .dot { width: 10px; height: 10px; border-radius: 50%; }

.platform-card h4 .dot.android { background: var(--android-green); }

.platform-card h4 .dot.ios { background: var(--ios-silver); }

.platform-card ul { list-style: none; }

.platform-card ul li { font-size: 14px; color: var(--text-mid); padding: 5px 0px; border-bottom: 1px solid var(--cream-dark); display: flex; align-items: flex-start; gap: 8px; }

.platform-card ul li:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.platform-card ul li::before { content: "›"; color: var(--navy); font-weight: 700; flex-shrink: 0; margin-top: 1px; }

.diagram-wrap { background: white; border: 1px solid var(--cream-dark); padding: 32px; margin: 28px 0px; border-radius: 2px; }

.diagram-caption { text-align: center; font-size: 12px; font-family: "JetBrains Mono", monospace; color: var(--text-muted); letter-spacing: 0.08em; margin-top: 14px; text-transform: uppercase; }

.case-study { background: white; border-top-color: ; border-top-style: ; border-top-width: ; border-right-color: ; border-right-style: ; border-right-width: ; border-bottom-color: ; border-bottom-style: ; border-bottom-width: ; border-image-source: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; border-left: 5px solid var(--gold); padding: 28px 32px; margin: 28px 0px; }

.case-study .cs-label { font-family: "JetBrains Mono", monospace; font-size: 10px; text-transform: uppercase; letter-spacing: 0.15em; color: var(--gold); margin-bottom: 10px; display: flex; align-items: center; gap: 8px; }

.case-study .cs-label::before { content: "◆"; font-size: 8px; }

.case-study h4 { font-family: "Playfair Display", serif; font-size: 19px; color: var(--navy); margin-bottom: 10px; }

.case-study p { font-size: 14px; color: var(--text-mid); margin-bottom: 10px; }

.case-study p:last-child { margin-bottom: 0px; }

.pros-cons { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 20px 0px; }

.pros-box, .cons-box { padding: 20px 24px; border-radius: 2px; }

.pros-box { background: rgba(42, 138, 127, 0.06); border: 1px solid rgba(42, 138, 127, 0.2); }

.cons-box { background: rgba(192, 57, 43, 0.06); border: 1px solid rgba(192, 57, 43, 0.2); }

.pros-box h5, .cons-box h5 { font-family: "JetBrains Mono", monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 12px; }

.pros-box h5 { color: var(--teal); }

.cons-box h5 { color: var(--red-accent); }

.pros-box ul, .cons-box ul { list-style: none; }

.pros-box ul li, .cons-box ul li { font-size: 13px; color: var(--text-mid); padding: 4px 0px; display: flex; gap: 8px; }

.pros-box ul li::before { content: "✓"; color: var(--teal); font-weight: 700; }

.cons-box ul li::before { content: "✗"; color: var(--red-accent); font-weight: 700; }

.quiz-section { background: var(--navy); padding: 60px; margin-top: 0px; }

.quiz-section h2 { font-family: "Playfair Display", serif; font-size: 36px; color: white; margin-bottom: 8px; }

.quiz-section .quiz-sub { color: var(--cream-text); font-style: italic; font-size: 16px; margin-bottom: 40px; }

.quiz-card { background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.12); padding: 28px 32px; margin-bottom: 20px; border-radius: 2px; }

.quiz-card .q-num { font-family: "JetBrains Mono", monospace; font-size: 11px; color: var(--gold); letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 10px; }

.quiz-card .q-text { font-family: "Source Serif 4", serif; font-size: 17px; font-weight: 600; color: white; margin-bottom: 20px; line-height: 1.5; }

.quiz-options { display: flex; flex-direction: column; gap: 10px; }

.quiz-option { display: flex; align-items: center; gap: 12px; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.1); padding: 12px 16px; cursor: pointer; transition: 0.2s; border-radius: 2px; font-size: 14px; color: rgba(255, 255, 255, 0.8); font-family: "Source Serif 4", serif; user-select: none; }

.quiz-option:hover { background: rgba(255, 255, 255, 0.1); border-color: rgba(255, 255, 255, 0.25); }

.quiz-option.selected-correct { background: rgba(42, 138, 127, 0.25); border-color: var(--teal-light); color: white; }

.quiz-option.selected-wrong { background: rgba(192, 57, 43, 0.2); border-color: rgb(238, 85, 85); color: white; }

.quiz-option .opt-letter { font-family: "JetBrains Mono", monospace; font-size: 12px; font-weight: 500; background: rgba(255, 255, 255, 0.1); width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; border-radius: 50%; flex-shrink: 0; color: var(--cream-text); }

.quiz-feedback { margin-top: 14px; padding: 12px 16px; border-radius: 2px; font-size: 13px; display: none; }

.quiz-feedback.show { display: block; }

.quiz-feedback.correct { background: rgba(42, 138, 127, 0.2); color: var(--teal-light); border: 1px solid rgba(42, 138, 127, 0.3); }

.quiz-feedback.wrong { background: rgba(192, 57, 43, 0.15); color: rgb(255, 138, 122); border: 1px solid rgba(192, 57, 43, 0.3); }

.score-display { background: rgba(201, 153, 58, 0.15); border: 1px solid rgba(201, 153, 58, 0.3); padding: 24px 32px; margin-top: 32px; border-radius: 2px; align-items: center; justify-content: space-between; display: none; }

.score-display.show { display: flex; }

.score-display .score-label { font-family: "JetBrains Mono", monospace; font-size: 12px; color: var(--gold-light); letter-spacing: 0.1em; text-transform: uppercase; }

.score-display .score-num { font-family: "Playfair Display", serif; font-size: 42px; color: var(--gold-light); font-weight: 700; }

footer { background: var(--navy-dark); padding: 24px 60px; display: flex; align-items: center; justify-content: space-between; }

footer p { font-family: "JetBrains Mono", monospace; font-size: 11px; color: rgba(255, 255, 255, 0.3); margin: 0px; }

.mono { font-family: "JetBrains Mono", monospace; font-size: 13px; background: rgba(26, 47, 78, 0.07); padding: 2px 6px; border-radius: 3px; }

@media (max-width: 700px) {
  .hero, .toc-section, main { padding: 32px 24px; }
  .two-col, .pros-cons { grid-template-columns: 1fr; }
  .hero-meta { flex-wrap: wrap; gap: 24px; }
  .quiz-section { padding: 32px 24px; }
  footer { flex-direction: column; gap: 8px; }
}
