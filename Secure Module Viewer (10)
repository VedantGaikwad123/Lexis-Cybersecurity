          <tr>
            <td><code>magic_number</code></td>
            <td>4 bytes</td>
            <td>0xd4c3b2a1 (little-endian) or 0xa1b2c3d4 (big-endian). Identifies byte order.</td>
          </tr>
          <tr>
            <td><code>version_major</code></td>
            <td>2 bytes</td>
            <td>Major version number (currently 2)</td>
          </tr>
          <tr>
            <td><code>version_minor</code></td>
            <td>2 bytes</td>
            <td>Minor version number (currently 4)</td>
          </tr>
          <tr>
            <td><code>thiszone</code></td>
            <td>4 bytes</td>
            <td>GMT offset for timestamps (usually 0)</td>
          </tr>
          <tr>
            <td><code>sigfigs</code></td>
            <td>4 bytes</td>
            <td>Accuracy of timestamps (almost always 0)</td>
          </tr>
          <tr>
            <td><code>snaplen</code></td>
            <td>4 bytes</td>
            <td>Max bytes per captured packet (65535 = full capture)</td>
          </tr>
          <tr>
            <td><code>network</code></td>
            <td>4 bytes</td>
            <td>Link layer type (1 = Ethernet, 101 = Raw IP, etc.)</td>
          </tr>
