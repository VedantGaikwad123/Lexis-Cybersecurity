@charset "utf-8";

:root { --navy: #1a2e4a; --navy-light: #243a5e; --navy-dark: #0f1e30; --cream: #f0ede8; --white: #ffffff; --accent: #4a9eff; --accent2: #ff6b35; --text-light: #a8bcd4; --text-muted: #6b8aaa; --card-bg: #ffffff; --border: #e0dbd4; --success: #2ecc71; --warning: #f39c12; --danger: #e74c3c; --code-bg: #1e3a5f; }

[data-theme="dark"] { --cream: #0d1b2a; --white: #1a2e4a; --card-bg: #162438; --border: #2a4060; --navy: #0a1628; --text-light: #a8bcd4; }

* { margin: 0px; padding: 0px; box-sizing: border-box; }

body { font-family: "Source Sans 3", sans-serif; background: var(--cream); color: rgb(44, 62, 80); line-height: 1.7; transition: 0.3s; }

.hero { background: linear-gradient(135deg, var(--navy-dark) 0%, var(--navy) 50%, var(--navy-light) 100%); padding: 60px 80px 70px; position: relative; overflow: hidden; }

.hero::before { content: ""; position: absolute; inset: 0px; background-image: radial-gradient(circle at 20% 50%, rgba(74, 158, 255, 0.08) 0%, transparent 50%), radial-gradient(circle at 80% 20%, rgba(255, 107, 53, 0.06) 0%, transparent 40%); }

.hero-controls { position: absolute; top: 24px; right: 32px; display: flex; align-items: center; gap: 8px; background: rgba(255, 255, 255, 0.12); padding: 8px 16px; border-radius: 30px; backdrop-filter: blur(10px); }

.theme-btn { background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; color: white; font-size: 16px; padding: 4px 6px; border-radius: 50%; transition: background 0.2s; }

.theme-btn:hover { background: rgba(255, 255, 255, 0.2); }

.theme-btn.active { background: rgba(255, 255, 255, 0.25); }

.hero h1 { font-family: "Playfair Display", serif; font-size: clamp(42px, 6vw, 72px); font-weight: 900; color: white; line-height: 1.1; position: relative; max-width: 800px; }

.hero p { color: var(--text-light); font-size: 18px; margin-top: 12px; position: relative; }

.hero-meta { display: flex; gap: 48px; margin-top: 40px; position: relative; }

.meta-item label { display: block; color: var(--text-muted); font-size: 11px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 4px; }

.meta-item span { color: var(--text-light); font-size: 14px; }

.toc-wrapper { max-width: 900px; margin: 60px auto; padding: 0px 40px; }

.toc-card { background: var(--card-bg); border-left: 4px solid var(--navy); border-radius: 2px; padding: 32px 36px; box-shadow: rgba(0, 0, 0, 0.06) 0px 2px 20px; }

.toc-title { font-size: 11px; letter-spacing: 3px; text-transform: uppercase; color: var(--text-muted); margin-bottom: 20px; font-weight: 600; }

.toc-list { list-style: none; }

.toc-list li { padding: 6px 0px; border-bottom: 1px solid var(--border); }

.toc-list li:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.toc-list a { color: var(--navy); text-decoration: none; font-size: 16px; transition: color 0.2s; display: flex; align-items: center; gap: 12px; }

.toc-list a:hover { color: var(--accent); }

.toc-num { color: var(--text-muted); font-size: 13px; min-width: 24px; }

.content { max-width: 900px; margin: 0px auto; padding: 0px 40px 80px; }

.section { margin-bottom: 72px; }

h2 { font-family: "Playfair Display", serif; font-size: 32px; font-weight: 700; color: var(--navy); margin-bottom: 20px; padding-top: 20px; }

h3 { font-family: "Playfair Display", serif; font-size: 22px; color: var(--navy); margin: 28px 0px 12px; }

h4 { font-size: 16px; font-weight: 600; color: var(--navy-light); margin: 20px 0px 8px; text-transform: uppercase; letter-spacing: 0.5px; }

p { margin-bottom: 16px; color: rgb(58, 74, 92); font-size: 16px; }

.divider { height: 2px; background: linear-gradient(90deg, var(--navy), transparent); margin-bottom: 28px; width: 60px; }

.callout { border-radius: 4px; padding: 20px 24px; margin: 24px 0px; border-left: 4px solid; font-size: 15px; }

.callout-info { background: rgb(238, 246, 255); border-color: var(--accent); }

.callout-warning { background: rgb(255, 248, 236); border-color: var(--warning); }

.callout-danger { background: rgb(255, 240, 239); border-color: var(--danger); }

.callout-success { background: rgb(237, 251, 243); border-color: var(--success); }

.callout strong { display: block; margin-bottom: 6px; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; }

.callout-info strong { color: var(--accent); }

.callout-warning strong { color: var(--warning); }

.callout-danger strong { color: var(--danger); }

.callout-success strong { color: var(--success); }

.code-block { background: var(--navy-dark); border-radius: 6px; padding: 20px 24px; margin: 20px 0px; overflow-x: auto; }

.code-block pre { font-family: "JetBrains Mono", monospace; font-size: 13px; color: rgb(168, 216, 255); line-height: 1.8; }

.code-block .comment { color: rgb(90, 138, 122); }

.code-block .keyword { color: rgb(255, 157, 108); }

.code-block .string { color: rgb(152, 217, 130); }

.cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin: 24px 0px; }

.card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 6px; padding: 24px; box-shadow: rgba(0, 0, 0, 0.04) 0px 2px 12px; }

.card-icon { width: 44px; height: 44px; background: var(--navy); border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 14px; font-size: 20px; }

.card h4 { margin-top: 0px; text-transform: none; font-size: 17px; }

.card p { font-size: 14px; color: rgb(90, 106, 122); margin: 0px; }

.steps { margin: 24px 0px; }

.step { display: flex; gap: 20px; margin-bottom: 20px; align-items: flex-start; }

.step-num { min-width: 36px; height: 36px; background: var(--navy); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px; flex-shrink: 0; }

.step-body h4 { margin-top: 6px; }

.data-table { width: 100%; border-collapse: collapse; margin: 24px 0px; font-size: 14px; background: var(--card-bg); box-shadow: rgba(0, 0, 0, 0.05) 0px 2px 12px; border-radius: 6px; overflow: hidden; }

.data-table th { background: var(--navy); color: white; padding: 12px 16px; text-align: left; font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; }

.data-table td { padding: 11px 16px; border-bottom: 1px solid var(--border); color: rgb(58, 74, 92); }

.data-table tr:last-child td { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.data-table tr:hover td { background: rgb(248, 246, 243); }

.diagram-wrap { background: var(--card-bg); border: 1px solid var(--border); border-radius: 8px; padding: 24px; margin: 28px 0px; text-align: center; box-shadow: rgba(0, 0, 0, 0.05) 0px 2px 16px; }

.diagram-wrap figcaption { font-size: 13px; color: var(--text-muted); margin-top: 12px; font-style: italic; }

.tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0px; }

.tag { background: var(--navy); color: var(--text-light); font-size: 12px; padding: 4px 12px; border-radius: 20px; font-family: "JetBrains Mono", monospace; }

.quiz-section { background: var(--navy-dark); padding: 60px 40px; margin-top: 80px; }

.quiz-header { text-align: center; margin-bottom: 48px; }

.quiz-header h2 { color: white; font-family: "Playfair Display", serif; font-size: 36px; }

.quiz-header p { color: var(--text-muted); }

.quiz-cards { max-width: 800px; margin: 0px auto; display: flex; flex-direction: column; gap: 28px; }

.quiz-card { background: var(--navy-light); border-radius: 8px; padding: 28px 32px; border: 1px solid rgba(74, 158, 255, 0.15); }

.quiz-q { color: white; font-size: 17px; font-weight: 600; margin-bottom: 20px; line-height: 1.5; }

.quiz-q span { display: inline-block; background: var(--accent); color: white; font-size: 12px; padding: 2px 10px; border-radius: 20px; margin-right: 10px; font-weight: 400; vertical-align: middle; }

.options { display: flex; flex-direction: column; gap: 10px; }

.option { background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 6px; padding: 12px 18px; color: var(--text-light); cursor: pointer; transition: 0.2s; text-align: left; font-size: 15px; }

.option:hover { background: rgba(74, 158, 255, 0.15); border-color: var(--accent); color: white; }

.option.correct { background: rgba(46, 204, 113, 0.2); border-color: var(--success); color: rgb(163, 245, 200); }

.option.wrong { background: rgba(231, 76, 60, 0.2); border-color: var(--danger); color: rgb(245, 163, 163); }

.option.reveal { background: rgba(46, 204, 113, 0.1); border-color: rgba(46, 204, 113, 0.3); color: rgb(163, 245, 200); }

.option:disabled { cursor: not-allowed; }

.quiz-feedback { margin-top: 14px; font-size: 14px; min-height: 20px; color: var(--text-muted); font-style: italic; }

.quiz-controls { margin-top: 48px; display: flex; flex-direction: column; align-items: center; gap: 16px; }

.retake-btn { background: transparent; border: 1px solid var(--accent); color: var(--accent); padding: 10px 24px; border-radius: 6px; font-weight: 600; cursor: pointer; transition: 0.2s; display: none; }

.retake-btn:hover { background: rgba(74, 158, 255, 0.1); }

.submit-container { display: flex; flex-direction: column; align-items: center; gap: 10px; }

.submit-btn { background: var(--navy); color: white; border: 2px solid var(--accent); padding: 14px 40px; border-radius: 6px; font-weight: 700; font-size: 16px; cursor: pointer; transition: 0.3s; letter-spacing: 0.5px; text-transform: uppercase; }

.submit-btn:hover { background: var(--accent); color: var(--white); }

.submit-btn:disabled { cursor: not-allowed; }

.submit-btn.completed { background: rgba(46, 204, 113, 0.15); border-color: var(--success); color: rgb(163, 245, 200); }

.submit-btn.completed:hover { background: rgba(46, 204, 113, 0.15); color: rgb(163, 245, 200); }

.submit-msg { font-size: 14px; font-weight: 600; display: none; }

.footer { background: var(--navy-dark); padding: 32px 80px; text-align: center; color: var(--text-muted); font-size: 14px; border-top: 1px solid rgba(255, 255, 255, 0.05); }

ul.styled, ol.styled { padding-left: 24px; margin: 12px 0px 20px; }

ul.styled li, ol.styled li { margin-bottom: 8px; color: rgb(58, 74, 92); font-size: 15px; }

.highlight-box { background: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 100%); color: white; border-radius: 8px; padding: 28px 32px; margin: 24px 0px; }

.highlight-box h3 { color: var(--accent); margin-top: 0px; }

.highlight-box p { color: rgba(255, 255, 255, 0.85); }

.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin: 20px 0px; }

@media (max-width: 700px) {
  .hero { padding: 48px 24px 56px; }
  .hero-meta { gap: 24px; flex-wrap: wrap; }
  .content, .toc-wrapper { padding: 0px 20px 60px; }
  .two-col { grid-template-columns: 1fr; }
  .quiz-section { padding: 40px 20px; }
}
