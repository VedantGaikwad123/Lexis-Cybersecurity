@charset "utf-8";

:root { --bg: #f3f4f6; --panel: #ffffff; --panel-raised: #ffffff; --line: #e5e7eb; --ink: #111827; --ink-dim: #374151; --ink-faint: #6b7280; --safe: #0d9488; --safe-dim: #ccfbf1; --warn: #d97706; --warn-dim: #fef3c7; --danger: #dc2626; --danger-dim: #fee2e2; }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { margin: 0px; background: var(--bg); color: var(--ink); font-family: "IBM Plex Sans", sans-serif; line-height: 1.55; -webkit-font-smoothing: antialiased; }

::selection { background: var(--safe-dim); color: var(--ink); }

.scanline { position: fixed; inset: 0px; pointer-events: none; z-index: 5; background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.08) 0px, rgba(0, 0, 0, 0.08) 1px, transparent 1px, transparent 3px); opacity: 0.25; mix-blend-mode: overlay; }

.classbar { background: var(--danger-dim); border-bottom: 1px solid rgb(107, 42, 32); color: rgb(255, 185, 168); font-family: "IBM Plex Mono", monospace; font-size: 12.5px; letter-spacing: 0.08em; text-align: center; padding: 8px 12px; text-transform: uppercase; }

header.hero { max-width: 980px; margin: 0px auto; padding: 64px 28px 40px; border-bottom: 1px solid var(--line); }

.eyebrow { font-family: "IBM Plex Mono", monospace; color: var(--safe); font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; display: flex; align-items: center; gap: 10px; margin-bottom: 18px; }

.eyebrow::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--safe); box-shadow: 0 0 0 3px var(--safe-dim); }

h1 { font-family: "Space Grotesk", sans-serif; font-weight: 700; font-size: clamp(32px, 5vw, 52px); line-height: 1.08; margin: 0px 0px 18px; letter-spacing: -0.01em; }

h1 .accent { color: var(--safe); }

.lede { color: var(--ink-dim); font-size: 17px; max-width: 640px; margin: 0px 0px 28px; }

.stamp-row { display: flex; flex-wrap: wrap; gap: 10px; }

.stamp { font-family: "IBM Plex Mono", monospace; font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; padding: 6px 12px; border-radius: 3px; border: 1px solid; }

.stamp.safe { color: var(--safe); border-color: var(--safe-dim); background: rgba(79, 209, 197, 0.06); }

.stamp.no { color: var(--ink-dim); border-color: var(--line); background: rgba(255, 255, 255, 0.02); }

.wrap { max-width: 980px; margin: 0px auto; padding: 0px 28px; }

.grid { display: flex; flex-direction: column; gap: 48px; padding: 48px 0px 100px; }

@media (max-width: 820px) {
  .grid { padding: 24px 0px 60px; }
}

.toc { font-family: "IBM Plex Mono", monospace; font-size: 12.5px; margin: 0px auto; text-align: center; }

.toc-title { color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.1em; font-size: 11px; margin-bottom: 14px; }

.toc a { display: inline-block; color: var(--ink-dim); text-decoration: none; padding: 7px 14px; margin: 4px; border: 1px solid var(--line); border-radius: 20px; transition: 0.15s; }

.toc a:hover, .toc a.active { color: var(--safe); border-color: var(--safe); background: rgba(13, 148, 136, 0.05); }

section { margin-bottom: 56px; scroll-margin-top: 20px; }

.sec-head { display: flex; align-items: baseline; gap: 14px; margin-bottom: 18px; }

.sec-num { font-family: "IBM Plex Mono", monospace; color: var(--ink-faint); font-size: 14px; }

h2 { font-family: "Space Grotesk", sans-serif; font-size: 24px; margin: 0px; font-weight: 600; }

p { color: var(--ink-dim); }

strong { color: var(--ink); }

.rules { list-style: none; margin: 0px; padding: 0px; display: grid; gap: 10px; }

.rules li { background: var(--panel); border-top-color: ; border-top-style: ; border-top-width: ; border-right-color: ; border-right-style: ; border-right-width: ; border-bottom-color: ; border-bottom-style: ; border-bottom-width: ; border-image-source: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; border-left: 3px solid var(--warn); padding: 14px 16px; border-radius: 4px; color: var(--ink-dim); font-size: 14.5px; }

.rules li strong { color: var(--warn); }

.certline { margin-top: 16px; font-family: "IBM Plex Mono", monospace; font-size: 13px; background: var(--panel-raised); border: 1px dashed var(--safe-dim); color: var(--safe); padding: 14px 16px; border-radius: 4px; }

.subtask { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 26px 28px; margin-bottom: 22px; position: relative; overflow: hidden; }

.subtask::before { content: attr(data-tag); position: absolute; top: 0px; right: 0px; font-family: "IBM Plex Mono", monospace; font-size: 10.5px; letter-spacing: 0.08em; color: var(--safe); background: var(--safe-dim); padding: 5px 12px; border-bottom-left-radius: 6px; }

.subtask-head { display: flex; align-items: center; gap: 14px; margin-bottom: 6px; }

.subtask-index { font-family: "Space Grotesk", sans-serif; font-weight: 700; font-size: 26px; color: var(--ink-faint); min-width: 34px; }

.subtask h3 { font-family: "Space Grotesk", sans-serif; font-size: 19px; margin: 0px; }

.goal { color: var(--ink-dim); font-size: 14.5px; margin: 4px 0px 18px 48px; }

.steps { margin: 0px 0px 0px 48px; padding: 0px; list-style: none; counter-reset: step 0; }

.steps li { counter-increment: step 1; position: relative; padding-left: 30px; margin-bottom: 10px; font-size: 14.5px; color: var(--ink); }

.steps li::before { content: counter(step); position: absolute; left: 0px; top: 1px; width: 20px; height: 20px; border-radius: 50%; background: var(--panel-raised); border: 1px solid var(--line); color: var(--safe); font-family: "IBM Plex Mono", monospace; font-size: 11px; display: flex; align-items: center; justify-content: center; }

code { font-family: "IBM Plex Mono", monospace; background: var(--panel-raised); border: 1px solid var(--line); border-radius: 3px; padding: 1px 6px; color: var(--safe); font-size: 13px; }

.deliverable { margin: 16px 0px 0px 48px; font-size: 13.5px; color: var(--ink-faint); font-family: "IBM Plex Mono", monospace; border-top: 1px solid var(--line); padding-top: 12px; }

.deliverable b { color: var(--ink-dim); }

.qtable { margin: 12px 0px 0px 48px; border-collapse: collapse; font-family: "IBM Plex Mono", monospace; font-size: 13px; width: calc(100% - 48px); }

.qtable th, .qtable td { border: 1px solid var(--line); padding: 8px 12px; text-align: left; color: var(--ink-dim); }

.qtable th { color: var(--safe); background: var(--panel-raised); font-weight: 500; }

.qtable td:first-child { color: var(--ink-faint); width: 36px; }

table.data { width: 100%; border-collapse: collapse; font-size: 14.5px; }

table.data th, table.data td { border: 1px solid var(--line); padding: 12px 14px; text-align: left; }

table.data th { background: var(--panel-raised); color: var(--safe); font-weight: 500; font-size: 13px; text-transform: uppercase; letter-spacing: 0.04em; }

table.data td { color: var(--ink-dim); background: var(--panel); }

table.data td:last-child { color: var(--ink); font-family: "IBM Plex Mono", monospace; white-space: nowrap; }

.notes { list-style: none; margin: 0px; padding: 0px; display: grid; gap: 12px; }

.notes li { background: var(--panel); border-top-color: ; border-top-style: ; border-top-width: ; border-right-color: ; border-right-style: ; border-right-width: ; border-bottom-color: ; border-bottom-style: ; border-bottom-width: ; border-image-source: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; border-radius: 6px; padding: 14px 16px; font-size: 14.5px; color: var(--ink-dim); border-left: 3px solid var(--safe-dim); }

footer { max-width: 980px; margin: 0px auto; padding: 36px 28px 60px; color: var(--ink-faint); font-family: "IBM Plex Mono", monospace; font-size: 12px; border-top: 1px solid var(--line); }

.template-box { margin: 16px 0px 0px 48px; background: var(--panel-raised); border: 1px solid var(--line); border-radius: 6px; padding: 16px 18px; }

.template-label { font-family: "IBM Plex Mono", monospace; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--safe); margin-bottom: 10px; }

.ascii { font-family: "IBM Plex Mono", monospace; font-size: 12.5px; color: var(--ink-dim); white-space: pre; overflow-x: auto; margin: 0px; line-height: 1.6; }

.caselist { list-style: none; margin: 0px; padding: 0px; display: grid; gap: 10px; }

.caselist li { font-size: 13.5px; color: var(--ink-dim); }

.caselist b { color: var(--ink); }

.subq { list-style: disc; margin: 8px 0px 0px 20px; padding: 0px; }

.subq li { font-size: 14px; color: var(--ink); margin-bottom: 4px; }

.faq-list { display: grid; gap: 14px; }

.faq-item { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 14px 16px; }

.faq-q { font-family: "Space Grotesk", sans-serif; font-weight: 600; font-size: 14.5px; color: var(--safe); margin-bottom: 6px; }

.faq-a { font-size: 14px; color: var(--ink-dim); }

.submission-note { max-width: 980px; margin: 0px auto 40px; padding: 0px 28px; }

.submission-note::before { content: "⚠ Submission Deadline"; display: block; font-family: "IBM Plex Mono", monospace; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--warn); margin-bottom: 8px; }

.submission-note { font-family: "IBM Plex Mono", monospace; background: var(--warn-dim); border: 1px solid rgb(107, 80, 23); color: rgb(255, 217, 138); border-radius: 6px; padding: 16px 20px; font-size: 14px; }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
}
