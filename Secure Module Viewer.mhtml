@charset "utf-8";

* { box-sizing: border-box; }

body { margin: 0px; padding: 0px; background: rgb(15, 23, 42); color: rgb(226, 232, 240); font-family: Inter, sans-serif; user-select: none; }

@media print {
  html, body { display: none !important; opacity: 0 !important; visibility: hidden !important; }
  * { display: none !important; }
}

#reading-progress-bar { position: fixed; top: 0px; left: 0px; width: 0%; height: 4px; background: linear-gradient(90deg, rgb(8, 145, 178), rgb(0, 243, 255), rgb(168, 85, 247)); z-index: 99999; transition: width 0.1s linear; box-shadow: rgba(0, 243, 255, 0.6) 0px 0px 10px; }

#reading-progress-label { position: fixed; top: 8px; right: 15px; font-family: "Share Tech Mono", monospace; font-size: 11px; color: rgb(0, 243, 255); background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(8px); padding: 3px 10px; border-radius: 20px; border: 1px solid rgba(0, 243, 255, 0.3); z-index: 99999; letter-spacing: 1px; }

.secure-container { width: 100%; max-width: 1200px; margin: 0px auto; padding: 60px 20px 40px; box-sizing: border-box; }

.watermark { position: fixed; inset: 0px; pointer-events: none; z-index: 9998; opacity: 0.04; display: flex; flex-wrap: wrap; place-content: center; overflow: hidden; }

.watermark span { font-size: 24px; font-weight: bold; padding: 50px; transform: rotate(-30deg); white-space: nowrap; }
