.theme-btn { width: 36px; height: 36px; border-radius: 18px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: 0.2s; color: rgba(255, 255, 255, 0.5); background: transparent; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

