:root { --bg: #f8f7f4; --bg2: #ffffff; --bg3: #f1efe8; --text: #2c2c2a; --text2: #5f5e5a; --text3: #888780; --border: rgba(0, 0, 0, 0.10); --border2: rgba(0, 0, 0, 0.18); --blue: #185FA5; --blue-bg: #E6F1FB; --blue-t: #0C447C; --red: #A32D2D; --red-bg: #FCEBEB; --red-t: #791F1F; --green: #3B6D11; --green-bg: #EAF3DE; --green-t: #27500A; --amber: #854F0B; --amber-bg: #FAEEDA; --amber-t: #633806; --teal: #0F6E56; --teal-bg: #E1F5EE; --teal-t: #085041; --purple: #534AB7; --purple-bg: #EEEDFE; --purple-t: #3C3489; --coral: #993C1D; --coral-bg: #FAECE7; --gray-bg: #F1EFE8; --radius: 8px; --radius-lg: 12px; }

