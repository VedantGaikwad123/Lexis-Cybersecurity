.bar-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }

.bar-label { font-size: 11px; color: var(--text2); width: 140px; flex-shrink: 0; text-align: right; }

.bar-track { flex: 1 1 0%; background: var(--bg3); border-radius: 3px; height: 16px; border: 0.5px solid var(--border); overflow: hidden; }

.bar-fill { height: 100%; border-radius: 2px; display: flex; align-items: center; justify-content: flex-end; padding-right: 5px; font-size: 10px; font-weight: 600; color: rgb(255, 255, 255); }

.quiz-section { margin-top: 48px; padding-top: 32px; border-top: 0.5px solid var(--border); }

.quiz-title { font-size: 1.2rem; font-weight: 600; color: var(--text); margin-bottom: 4px; }

.quiz-sub { font-size: 0.85rem; color: var(--text2); margin-bottom: 24px; }

.q-item { background: var(--bg2); border: 0.5px solid var(--border); border-radius: var(--radius-lg); padding: 18px 20px; margin-bottom: 14px; }

.q-num { font-size: 10px; color: var(--text3); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 6px; }

.q-text { font-size: 0.93rem; font-weight: 500; color: var(--text); margin-bottom: 14px; line-height: 1.6; }

.q-opts { display: flex; flex-direction: column; gap: 7px; }

.q-opt { display: flex; align-items: center; gap: 10px; padding: 9px 13px; border: 0.5px solid var(--border); border-radius: var(--radius); cursor: pointer; font-size: 0.83rem; color: var(--text2); background: var(--bg3); transition: 0.15s; user-select: none; }

.q-opt:hover { border-color: var(--border2); color: var(--text); background: var(--bg2); }

.q-opt.correct { background: var(--green-bg); border-color: var(--green); color: var(--green-t); }

.q-opt.wrong { background: var(--red-bg); border-color: var(--red); color: var(--red-t); }

.opt-letter { width: 20px; height: 20px; border: 0.5px solid; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 600; flex-shrink: 0; }

.q-feedback { margin-top: 10px; padding: 10px 14px; border-radius: var(--radius); font-size: 0.83rem; display: none; line-height: 1.6; }

.q-feedback.show { display: block; }

.fb-correct { background: var(--green-bg); color: var(--green-t); border: 0.5px solid var(--green); }

.fb-wrong { background: var(--red-bg); color: var(--red-t); border: 0.5px solid var(--red); }

.score-card { text-align: center; padding: 24px; background: var(--bg2); border: 0.5px solid var(--border); border-radius: var(--radius-lg); margin-top: 16px; display: none; }

.score-card.show { display: block; }

.score-big { font-size: 3.5rem; font-weight: 600; color: var(--text); }

.score-msg { font-size: 0.9rem; color: var(--text2); margin-top: 6px; }

button.reset-btn { margin-top: 14px; padding: 10px 28px; background: var(--bg2); border: 1px solid var(--border2); border-radius: var(--radius); font-size: 0.95rem; font-family: inherit; color: var(--text); cursor: pointer; font-weight: 600; transition: 0.2s; }

button.reset-btn:hover { background: var(--bg3); transform: translateY(-1px); }

.submit-section { text-align: center; margin-top: 60px; padding: 40px 24px; border-top: 1px solid var(--border); background: var(--bg2); border-radius: var(--radius-lg); box-shadow: rgba(0, 0, 0, 0.02) 0px -10px 30px; }

.submit-btn { padding: 16px 48px; background: var(--blue); color: white; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 30px; font-size: 1.1rem; font-weight: 600; cursor: pointer; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: rgba(24, 95, 165, 0.3) 0px 4px 15px; font-family: Inter, sans-serif; letter-spacing: 0.5px; }

.submit-btn:hover { background: rgb(21, 81, 141); transform: translateY(-2px); box-shadow: rgba(24, 95, 165, 0.4) 0px 8px 25px; }

.submit-btn:active { transform: translateY(0px); }

.submit-btn.complete { background: var(--green); box-shadow: rgba(59, 109, 17, 0.3) 0px 4px 15px; cursor: default; }

.submit-btn.complete:hover { transform: none; }

.submit-msg { margin-top: 20px; font-size: 1rem; font-weight: 500; transition: 0.3s; min-height: 24px; }

.submit-msg.error { color: var(--red); animation: 0.4s ease-in-out 0s 1 normal none running shake; }

.submit-msg.success { color: var(--green); }

@keyframes shake { 
  0%, 100% { transform: translateX(0px); }
  25% { transform: translateX(-5px); }
  75% { transform: translateX(5px); }
}

.layers-container { display: flex; flex-direction: column; gap: 16px; margin-top: 24px; }

.layer-item { background: var(--bg2); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }

.layer-head { background: var(--bg3); padding: 12px 20px; display: flex; align-items: center; gap: 12px; border-bottom: 1px solid var(--border); }

.layer-tag { font-size: 9px; font-weight: 700; text-transform: uppercase; padding: 3px 8px; background: var(--blue); color: white; border-radius: 4px; }

.layer-name { font-weight: 600; color: var(--text); font-size: 14px; }

.layer-body { padding: 20px; }

.layer-desc { font-size: 0.9rem; color: var(--text2); margin-bottom: 14px; line-height: 1.6; }

.layer-row { display: flex; gap: 8px; margin-top: 6px; font-size: 0.85rem; }

.layer-row strong { color: var(--text); min-width: 60px; }

.layer-row span { color: var(--text2); }

code { font-family: "JetBrains Mono", monospace; font-size: 0.82rem; background: var(--bg3); padding: 1px 5px; border-radius: 4px; color: var(--text); }

@media print {
  body { background: rgb(255, 255, 255); }
  .hero, .section, .quiz-section { break-inside: avoid; }
}

@media (max-width: 600px) {
  .stats-row { gap: 8px; }
  .card-grid { grid-template-columns: 1fr 1fr; }
  .bar-label { width: 100px; font-size: 10px; }
  .hero-meta { gap: 20px; flex-direction: column; }
  .hero-dark { padding: 60px 20px; }
  .toc-card { margin: -40px 20px 40px; padding: 24px; }
}
