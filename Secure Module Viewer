.toc-card { background: var(--bg2); border-radius: 4px; border-top-color: ; border-top-style: ; border-top-width: ; border-right-color: ; border-right-style: ; border-right-width: ; border-bottom-color: ; border-bottom-style: ; border-bottom-width: ; border-image-source: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; border-left: 4px solid rgb(30, 58, 138); padding: 40px; margin: -60px auto 60px; position: relative; z-index: 20; box-shadow: rgba(0, 0, 0, 0.08) 0px 20px 40px; max-width: 600px; }

