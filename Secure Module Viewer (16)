.code-block .out { color: rgb(200, 216, 232); }

ul.styled, ol.styled { padding-left: 0px; list-style: none; margin: 16px 0px 24px; }

ul.styled li { padding: 8px 0px 8px 24px; position: relative; color: var(--text-secondary); font-size: 15px; border-bottom: 1px solid var(--border); }

