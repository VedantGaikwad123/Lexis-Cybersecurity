.feedback.correct-fb { background: rgba(61, 220, 132, 0.1); border: 1px solid rgba(61, 220, 132, 0.3); color: var(--accent-green); }

.feedback.wrong-fb { background: rgba(255, 92, 92, 0.1); border: 1px solid rgba(255, 92, 92, 0.3); color: var(--accent-red); }

.quiz-actions { display: flex; gap: 16px; margin-top: 36px; flex-wrap: wrap; align-items: center; }

.btn { padding: 13px 28px; border-radius: 4px; font-family: "Source Code Pro", monospace; font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase; cursor: pointer; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; transition: 0.2s; font-weight: 600; }

.btn-primary { background: var(--accent); color: white; }

