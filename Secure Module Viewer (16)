:root[data-theme="dark"] { --bg-primary: #0f1923; --bg-secondary: #162030; --bg-card: #1a2a3a; --bg-code: #0d1b2a; --text-primary: #e8edf2; --text-secondary: #8fa3b8; --text-muted: #5a7a94; --accent: #4a9eff; --accent-soft: #1e3a5f; --accent-green: #3ddc84; --accent-red: #ff5c5c; --accent-orange: #ffaa44; --border: #1e3a5a; --border-light: #243a52; --hero-bg: #0f2035; --toc-border: #1e3a5a; --toc-bg: #162030; --tag-bg: #1e3a5f; --shadow: rgba(0,0,0,0.5); }

:root[data-theme="light"] { --bg-primary: #f0f2f5; --bg-secondary: #e8ecf0; --bg-card: #ffffff; --bg-code: #f4f6f8; --text-primary: #1a2a3a; --text-secondary: #4a6080; --text-muted: #7a98b0; --accent: #1a5fa8; --accent-soft: #d4e8ff; --accent-green: #1a8a4a; --accent-red: #c0392b; --accent-orange: #d4800a; --border: #c8d8e8; --border-light: #d8e8f0; --hero-bg: #1a3a5f; --toc-border: #b0c8d8; --toc-bg: #f8fafc; --tag-bg: #daeaff; --shadow: rgba(0,0,0,0.1); }

* { margin: 0px; padding: 0px; box-sizing: border-box; }

body { font-family: Lato, sans-serif; background: var(--bg-primary); color: var(--text-primary); line-height: 1.8; transition: background 0.3s, color 0.3s; }

.theme-toggle { position: fixed; top: 20px; right: 20px; z-index: 1000; background: var(--bg-card); border: 1px solid var(--border); border-radius: 50px; padding: 6px 14px; display: flex; align-items: center; gap: 10px; cursor: pointer; box-shadow: 0 4px 20px var(--shadow); transition: 0.3s; }

.theme-toggle:hover { box-shadow: 0 6px 28px var(--shadow); }

.toggle-icon { font-size: 18px; line-height: 1; }

.toggle-switch { width: 34px; height: 18px; background: var(--accent); border-radius: 9px; position: relative; transition: background 0.3s; }

.toggle-switch::after { content: ""; position: absolute; width: 12px; height: 12px; background: white; border-radius: 50%; top: 3px; left: 3px; transition: left 0.3s; }

[data-theme="light"] .toggle-switch::after { left: 19px; }

.shield-icon { font-size: 18px; }

.hero { background-position-x: ; background-position-y: ; background-size: ; background-repeat: ; background-attachment: ; background-origin: ; background-clip: ; background-color: ; background-image: repeating-linear-gradient(45deg, transparent, transparent 30px, rgba(74, 158, 255, 0.03) 30px, rgba(74, 158, 255, 0.03) 31px), repeating-linear-gradient(-45deg, transparent, transparent 30px, rgba(74, 158, 255, 0.03) 30px, rgba(74, 158, 255, 0.03) 31px); padding: 80px 60px 70px; position: relative; overflow: hidden; }

.hero::before { content: ""; position: absolute; top: -80px; right: -80px; width: 400px; height: 400px; border-radius: 50%; background: radial-gradient(circle, rgba(74, 158, 255, 0.08) 0%, transparent 70%); }

.hero-label { font-family: "Source Code Pro", monospace; font-size: 11px; letter-spacing: 3px; text-transform: uppercase; color: var(--accent); margin-bottom: 16px; opacity: 0.8; }

.hero h1 { font-family: "Playfair Display", serif; font-size: clamp(42px, 6vw, 72px); font-weight: 900; color: rgb(255, 255, 255); line-height: 1.1; margin-bottom: 18px; letter-spacing: -1px; }

.hero-subtitle { font-size: 18px; color: rgba(255, 255, 255, 0.55); font-weight: 300; letter-spacing: 0.5px; margin-bottom: 48px; max-width: 500px; }

.hero-meta { display: flex; gap: 60px; flex-wrap: wrap; }

.meta-item label { font-family: "Source Code Pro", monospace; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: rgba(255, 255, 255, 0.4); display: block; margin-bottom: 4px; font-weight: 700; }

.meta-item span { font-family: "Source Code Pro", monospace; font-size: 13px; color: rgba(255, 255, 255, 0.65); }

.meta-item .arrow { color: var(--accent); margin: 0px 4px; }

.container { max-width: 860px; margin: 0px auto; padding: 60px 40px; }

.toc { background: var(--toc-bg); border-top-color: ; border-top-style: ; border-top-width: ; border-right-color: ; border-right-style: ; border-right-width: ; border-bottom-color: ; border-bottom-style: ; border-bottom-width: ; border-image-source: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; border-left: 4px solid var(--accent); border-radius: 4px; padding: 36px 40px; margin-bottom: 60px; }

.toc-title { font-family: "Source Code Pro", monospace; font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: var(--text-muted); margin-bottom: 20px; }

.toc ol { list-style: none; counter-reset: toc-counter 0; }

.toc ol li { counter-increment: toc-counter 1; margin-bottom: 10px; display: flex; align-items: baseline; gap: 12px; }

.toc ol li::before { content: counter(toc-counter) "."; font-family: "Source Code Pro", monospace; font-size: 12px; color: var(--text-muted); min-width: 20px; }

.toc ol li a { color: var(--accent); text-decoration: none; font-size: 15px; font-weight: 400; transition: color 0.2s; }

.toc ol li a:hover { color: var(--text-primary); }

.section { margin-bottom: 64px; }

h2 { font-family: "Playfair Display", serif; font-size: 32px; font-weight: 700; color: var(--text-primary); margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid var(--border); scroll-margin-top: 30px; }

h3 { font-family: "Playfair Display", serif; font-size: 22px; font-weight: 700; color: var(--text-primary); margin: 36px 0px 14px; }

h4 { font-family: Lato, sans-serif; font-size: 16px; font-weight: 700; color: var(--accent); text-transform: uppercase; letter-spacing: 1px; margin: 28px 0px 10px; }

p { font-size: 16px; color: var(--text-secondary); margin-bottom: 18px; font-weight: 300; }

strong { color: var(--text-primary); font-weight: 700; }

.callout { border-radius: 4px; padding: 20px 24px; margin: 24px 0px; border-left: 4px solid; background: var(--bg-card); }

