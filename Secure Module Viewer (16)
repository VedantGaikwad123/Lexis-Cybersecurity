.callout-title { font-family: "Source Code Pro", monospace; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 8px; font-weight: 700; }

.callout.info .callout-title { color: var(--accent); }

.callout.warning .callout-title { color: var(--accent-orange); }

.callout.danger .callout-title { color: var(--accent-red); }

.callout.success .callout-title { color: var(--accent-green); }

.callout p { margin-bottom: 0px; font-size: 15px; }

.code-block { background: var(--bg-code); border: 1px solid var(--border); border-radius: 6px; padding: 20px 24px; margin: 20px 0px; overflow-x: auto; position: relative; }

.code-label { font-family: "Source Code Pro", monospace; font-size: 10px; letter-spacing: 2px; color: var(--text-muted); text-transform: uppercase; margin-bottom: 12px; }

.code-block pre { font-family: "Source Code Pro", monospace; font-size: 13px; line-height: 1.7; color: rgb(168, 216, 168); white-space: pre; }

.code-block .cmd { color: rgb(74, 158, 255); }

.code-block .opt { color: rgb(255, 170, 68); }

.code-block .val { color: rgb(61, 220, 132); }

