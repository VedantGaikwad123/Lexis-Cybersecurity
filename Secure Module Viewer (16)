      <svg viewBox="0 0 620 200" xmlns="http://www.w3.org/2000/svg" width="100%" style="max-width:620px">
        <!-- Bind -->
        <rect x="20" y="20" width="130" height="50" rx="6" fill="#162030" stroke="#4a9eff" stroke-width="1.5"></rect>
