.btn-secondary { background: transparent; border: 1px solid var(--border); color: var(--text-secondary); }

.btn-secondary:hover { border-color: var(--accent); color: var(--accent); }

.btn:disabled { opacity: 0.4; cursor: not-allowed; }

.submit-msg { font-family: "Source Code Pro", monospace; font-size: 13px; padding: 10px 16px; border-radius: 4px; display: none; }

.submit-msg.error { background: rgba(255, 92, 92, 0.1); color: var(--accent-red); border: 1px solid rgba(255, 92, 92, 0.3); }

.submit-msg.success { background: rgba(61, 220, 132, 0.1); color: var(--accent-green); border: 1px solid rgba(61, 220, 132, 0.3); }

.complete-badge { display: none; flex-direction: column; align-items: center; text-align: center; padding: 40px; background: var(--bg-card); border: 1px solid var(--accent-green); border-radius: 6px; margin-top: 30px; }

.complete-badge .badge-icon { font-size: 48px; margin-bottom: 16px; }

.complete-badge h3 { font-family: "Playfair Display", serif; font-size: 28px; color: var(--accent-green); margin-bottom: 10px; }

.complete-badge p { font-size: 15px; margin-bottom: 0px; }

.tag { display: inline-block; background: var(--tag-bg); color: var(--accent); font-family: "Source Code Pro", monospace; font-size: 11px; padding: 3px 10px; border-radius: 3px; margin: 3px; letter-spacing: 0.5px; }

.step-flow { margin: 28px 0px; }

.step { display: flex; gap: 20px; margin-bottom: 20px; align-items: flex-start; }

.step-num { width: 36px; height: 36px; border-radius: 50%; background: var(--accent); color: white; display: flex; align-items: center; justify-content: center; font-family: "Source Code Pro", monospace; font-size: 13px; font-weight: 700; flex-shrink: 0; margin-top: 2px; }

.step-content h4 { margin-top: 0px; margin-bottom: 6px; font-size: 15px; }

.step-content p { margin-bottom: 0px; font-size: 14px; }

.divider { height: 1px; background: linear-gradient(to right, transparent, var(--border), transparent); margin: 48px 0px; }

.highlight { color: var(--accent); }

.mono { font-family: "Source Code Pro", monospace; font-size: 13px; color: var(--accent-green); background: var(--bg-code); padding: 2px 7px; border-radius: 3px; }

@media (max-width: 768px) {
  .hero { padding: 60px 28px; }
  .hero-meta { gap: 30px; }
  .container { padding: 40px 24px; }
  .quiz-card { padding: 20px; }
  h2 { font-size: 26px; }
}
