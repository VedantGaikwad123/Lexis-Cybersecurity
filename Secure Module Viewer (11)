*, ::before, ::after { box-sizing: border-box; margin: 0px; padding: 0px; }

html { scroll-behavior: smooth; }

body { font-family: "Source Serif 4", Georgia, serif; background: var(--bg-body); color: var(--text-primary); transition: background 0.3s, color 0.3s; line-height: 1.75; }

.theme-toggle { position: fixed; top: 20px; right: 24px; z-index: 1000; background: var(--toggle-bg); border: 1.5px solid var(--toggle-border); border-radius: 50px; padding: 6px 14px; display: flex; align-items: center; gap: 10px; cursor: pointer; box-shadow: rgba(0, 0, 0, 0.12) 0px 2px 16px; transition: 0.3s; }

.theme-toggle span { font-size: 16px; line-height: 1; }

.theme-toggle .dot { width: 8px; height: 8px; background: var(--text-muted); border-radius: 50%; }

.theme-toggle .check { font-size: 13px; color: var(--accent2); font-family: "JetBrains Mono", monospace; font-weight: 500; }

.hero { background: var(--bg-hero); padding: 72px 8vw 64px; position: relative; overflow: hidden; transition: background 0.3s; }

.hero::before { content: ""; position: absolute; inset: 0px; background: radial-gradient(at 80% 50%, rgba(200, 151, 58, 0.06) 0%, transparent 65%), repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(255, 255, 255, 0.02) 40px), repeating-linear-gradient(90deg, transparent, transparent 39px, rgba(255, 255, 255, 0.02) 40px); pointer-events: none; }

.hero h1 { font-family: "Playfair Display", serif; font-size: clamp(2.4rem, 5.5vw, 4.2rem); font-weight: 900; color: var(--text-hero); line-height: 1.12; max-width: 820px; margin-bottom: 18px; letter-spacing: -0.01em; }

.hero-sub { font-size: 1.1rem; color: var(--text-hero-sub); font-weight: 300; font-style: italic; margin-bottom: 42px; letter-spacing: 0.01em; }

.hero-meta { display: flex; gap: 56px; flex-wrap: wrap; }

.hero-meta-item label { display: block; font-family: "JetBrains Mono", monospace; font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--hero-meta-label); margin-bottom: 6px; }

.hero-meta-item span { font-size: 0.95rem; color: var(--text-hero); font-weight: 400; }

.hero-meta-item .arrow { color: var(--accent2); }

.toc-wrapper { background: var(--bg-body); padding: 60px 8vw; }

.toc-card { max-width: 820px; margin: 0px auto; background: var(--bg-card); border-left: 3px solid var(--border-left); padding: 36px 44px; transition: background 0.3s; }

.toc-title { font-family: "JetBrains Mono", monospace; font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 24px; }

.toc-list { list-style: none; counter-reset: toc 0; }

.toc-list li { counter-increment: toc 1; display: flex; align-items: baseline; gap: 14px; padding: 10px 0px; border-bottom: 1px solid var(--border); }

.toc-list li:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.toc-list li::before { content: counter(toc, decimal-leading-zero) "."; font-family: "JetBrains Mono", monospace; font-size: 0.78rem; color: var(--text-muted); min-width: 28px; }

.toc-list a { font-size: 1.05rem; color: var(--accent); text-decoration: none; font-weight: 400; transition: opacity 0.2s; }

.toc-list a:hover { opacity: 0.65; text-decoration: underline; }

.content { max-width: 820px; margin: 0px auto; padding: 0px 8vw 80px; }

.section { padding: 60px 0px 0px; }

.section-label { font-family: "JetBrains Mono", monospace; font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 10px; }

h2 { font-family: "Playfair Display", serif; font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 700; color: var(--text-primary); line-height: 1.22; margin-bottom: 22px; letter-spacing: -0.01em; }

h3 { font-family: "Playfair Display", serif; font-size: 1.25rem; font-weight: 700; color: var(--text-primary); margin: 36px 0px 14px; }

h4 { font-family: "Source Serif 4", serif; font-size: 1rem; font-weight: 600; color: var(--text-secondary); margin: 24px 0px 10px; letter-spacing: 0.02em; }

p { font-size: 1.02rem; color: var(--text-secondary); margin-bottom: 18px; line-height: 1.8; }

strong { color: var(--text-primary); font-weight: 600; }

em { font-style: italic; color: var(--text-primary); }

.divider { height: 1px; background: var(--border); margin: 48px 0px 0px; }

.pullquote { border-left: 3px solid var(--border-left); padding: 20px 28px; margin: 32px 0px; background: var(--bg-card2); font-size: 1.08rem; font-style: italic; color: var(--text-primary); line-height: 1.7; }

.infobox { background: var(--bg-card); border-right-color: ; border-right-style: ; border-right-width: ; border-bottom-color: ; border-bottom-style: ; border-bottom-width: ; border-left-color: ; border-left-style: ; border-left-width: ; border-image-source: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; border-top: 3px solid var(--accent2); padding: 24px 28px; margin: 28px 0px; transition: background 0.3s; }

.infobox-title { font-family: "JetBrains Mono", monospace; font-size: 0.7rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--accent2); margin-bottom: 12px; }

ul.styled, ol.styled { padding-left: 0px; list-style: none; margin: 16px 0px 24px; }

ul.styled li { padding: 6px 0px 6px 22px; position: relative; color: var(--text-secondary); font-size: 1rem; line-height: 1.7; border-bottom: 1px solid var(--border); }

ul.styled li:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

ul.styled li::before { content: "—"; position: absolute; left: 0px; color: var(--accent2); font-weight: 700; }

ol.styled { counter-reset: item 0; }

ol.styled li { counter-increment: item 1; padding: 8px 0px 8px 36px; position: relative; color: var(--text-secondary); font-size: 1rem; line-height: 1.7; border-bottom: 1px solid var(--border); }

ol.styled li:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

ol.styled li::before { content: counter(item) "."; position: absolute; left: 0px; font-family: "JetBrains Mono", monospace; font-size: 0.82rem; color: var(--text-muted); font-weight: 500; top: 10px; }

.code-block { background: var(--code-bg); border-radius: 3px; padding: 20px 24px; margin: 24px 0px; overflow-x: auto; font-family: "JetBrains Mono", monospace; font-size: 0.82rem; color: var(--code-text); line-height: 1.7; transition: background 0.3s; }

.code-block .comment { color: rgb(106, 127, 106); }

.code-block .keyword { color: rgb(200, 151, 58); }

.code-block .string { color: rgb(130, 185, 232); }

