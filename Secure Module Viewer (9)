@charset "utf-8";

:root { --navy: #1a2a4a; --navy-mid: #1e3461; --navy-light: #243a6e; --cream: #f0ede6; --cream-mid: #e8e4dc; --cream-dark: #d8d3c8; --gold: #c9a84c; --gold-light: #e6c875; --text-dark: #1a1a2e; --text-mid: #2d3561; --text-muted: #6b7399; --white: #ffffff; --red: #c0392b; --green: #1a7a5e; --blue-accent: #2563a8; }

* { margin: 0px; padding: 0px; box-sizing: border-box; }

body { font-family: "Source Serif 4", Georgia, serif; background: var(--cream); color: var(--text-dark); line-height: 1.8; font-size: 16px; }

.hero { background: var(--navy); padding: 56px 60px 48px; position: relative; overflow: hidden; }

.hero::before { content: ""; position: absolute; inset: 0px; background: repeating-linear-gradient(-45deg, transparent, transparent 40px, rgba(255, 255, 255, 0.016) 40px, rgba(255, 255, 255, 0.016) 41px); }

.hero-controls { position: absolute; top: 20px; right: 24px; display: flex; align-items: center; gap: 8px; background: rgba(255, 255, 255, 0.12); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 24px; padding: 6px 12px; }

.ctrl-icon { width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; border-radius: 50%; cursor: pointer; font-size: 14px; color: rgba(255, 255, 255, 0.7); transition: background 0.2s; }

.ctrl-icon.active { background: rgba(255, 255, 255, 0.2); color: rgb(255, 255, 255); }

.hero h1 { font-family: "Playfair Display", serif; font-size: 58px; font-weight: 700; color: rgb(255, 255, 255); letter-spacing: -1px; line-height: 1.05; margin-bottom: 16px; position: relative; }

.hero-sub { font-family: "Source Serif 4", serif; font-size: 17px; color: rgba(255, 255, 255, 0.65); font-weight: 300; letter-spacing: 0.3px; position: relative; }

.hero-meta { display: flex; gap: 48px; margin-top: 36px; position: relative; }

.meta-item label { display: block; font-family: "JetBrains Mono", monospace; font-size: 11px; font-weight: 500; color: rgba(255, 255, 255, 0.45); text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 4px; }

.meta-item span { font-family: "Source Serif 4", serif; font-size: 14px; color: rgba(255, 255, 255, 0.7); }

.meta-arrow { color: var(--gold); margin: 0px 4px; }

.toc-section { background: var(--cream); padding: 40px 60px; border-bottom: 1px solid var(--cream-dark); }

.toc-inner { background: rgb(255, 255, 255); border-left: 3px solid var(--navy); padding: 28px 32px; max-width: 700px; }

.toc-label { font-family: "JetBrains Mono", monospace; font-size: 10px; font-weight: 500; letter-spacing: 2.5px; text-transform: uppercase; color: var(--text-muted); margin-bottom: 16px; }

.toc-list { list-style: none; }

.toc-list li { display: flex; align-items: baseline; gap: 12px; padding: 6px 0px; font-size: 15px; color: var(--navy-mid); border-bottom: 0.5px solid var(--cream-mid); cursor: pointer; transition: color 0.2s; }

.toc-list li:hover { color: var(--gold); }

.toc-list li:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.toc-num { font-family: "JetBrains Mono", monospace; font-size: 12px; color: var(--text-muted); min-width: 20px; }

.content { max-width: 860px; margin: 0px auto; padding: 48px 60px; }

.section { margin-bottom: 52px; }

h2 { font-family: "Playfair Display", serif; font-size: 32px; font-weight: 700; color: var(--navy); margin-bottom: 20px; padding-bottom: 12px; border-bottom: 2px solid var(--cream-dark); line-height: 1.2; }

h3 { font-family: "Source Serif 4", serif; font-size: 20px; font-weight: 600; color: var(--navy-mid); margin: 28px 0px 12px; }

h4 { font-family: "JetBrains Mono", monospace; font-size: 13px; font-weight: 500; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin: 20px 0px 8px; }

p { margin-bottom: 16px; color: rgb(42, 42, 62); line-height: 1.85; }

.lead { font-size: 18px; font-weight: 300; color: var(--navy-mid); line-height: 1.7; border-left: 3px solid var(--gold); padding-left: 20px; margin-bottom: 24px; }

.def-box { background: var(--navy); color: rgb(255, 255, 255); padding: 24px 28px; border-radius: 4px; margin: 24px 0px; position: relative; }

.def-box::before { content: "DEF"; position: absolute; top: 12px; right: 16px; font-family: "JetBrains Mono", monospace; font-size: 10px; letter-spacing: 2px; color: rgba(255, 255, 255, 0.25); }

.def-box p { color: rgba(255, 255, 255, 0.85); margin-bottom: 0px; font-size: 15px; }

.callout { background: rgb(255, 248, 230); border-left: 4px solid var(--gold); padding: 16px 20px; margin: 20px 0px; border-radius: 0px 4px 4px 0px; }

.callout-icon { font-size: 16px; margin-right: 8px; }

.callout p { margin-bottom: 0px; font-size: 14px; color: rgb(90, 74, 0); }

.danger-callout { background: rgb(255, 240, 240); border-left: 4px solid var(--red); padding: 16px 20px; margin: 20px 0px; border-radius: 0px 4px 4px 0px; }

.danger-callout p { margin-bottom: 0px; font-size: 14px; color: rgb(90, 0, 0); }

ul.styled, ol.styled { margin: 12px 0px 20px; padding-left: 0px; list-style: none; }

ul.styled li, ol.styled li { padding: 6px 0px 6px 24px; position: relative; font-size: 15px; color: rgb(42, 42, 62); border-bottom: 0.5px solid var(--cream-mid); counter-increment: li 1; }

ul.styled li::before { content: "—"; position: absolute; left: 0px; color: var(--gold); font-weight: 700; }

ol.styled { counter-reset: li 0; }

ol.styled li::before { content: counter(li); position: absolute; left: 0px; font-family: "JetBrains Mono", monospace; font-size: 11px; color: var(--navy); background: var(--cream-mid); width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center; top: 8px; }

.diagram-wrap { background: rgb(255, 255, 255); border: 0.5px solid var(--cream-dark); border-radius: 6px; padding: 32px 24px 24px; margin: 28px 0px; overflow-x: auto; }

.diagram-title { font-family: "JetBrains Mono", monospace; font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-muted); margin-bottom: 20px; text-align: center; }

.cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin: 24px 0px; }

.card { background: rgb(255, 255, 255); border: 0.5px solid var(--cream-dark); border-radius: 6px; padding: 20px 18px; }

.card-icon { font-size: 24px; margin-bottom: 10px; display: block; }

.card h4 { color: var(--navy); margin: 0px 0px 8px; font-size: 13px; }

.card p { font-size: 13px; margin-bottom: 0px; color: var(--text-muted); }

.styled-table { width: 100%; border-collapse: collapse; margin: 24px 0px; font-size: 14px; background: rgb(255, 255, 255); }

.styled-table th { background: var(--navy); color: rgb(255, 255, 255); padding: 12px 16px; text-align: left; font-family: "JetBrains Mono", monospace; font-size: 11px; letter-spacing: 0.5px; font-weight: 500; }

.styled-table td { padding: 10px 16px; border-bottom: 0.5px solid var(--cream-mid); color: rgb(42, 42, 62); vertical-align: top; }

.styled-table tr:hover td { background: var(--cream); }

.badge { display: inline-block; padding: 2px 8px; border-radius: 3px; font-family: "JetBrains Mono", monospace; font-size: 10px; font-weight: 500; letter-spacing: 0.5px; }

.badge-provider { background: rgb(219, 232, 255); color: rgb(26, 58, 138); }

.badge-customer { background: rgb(255, 232, 208); color: rgb(122, 58, 0); }

.badge-shared { background: rgb(232, 255, 208); color: rgb(26, 90, 0); }

.case-study { background: rgb(255, 255, 255); border: 0.5px solid var(--cream-dark); border-radius: 6px; padding: 24px 28px; margin: 28px 0px; position: relative; }

.case-study::before { content: "CASE STUDY"; font-family: "JetBrains Mono", monospace; font-size: 9px; letter-spacing: 2.5px; color: var(--white); background: var(--navy); padding: 4px 10px; border-radius: 2px; position: absolute; top: -10px; left: 20px; }

