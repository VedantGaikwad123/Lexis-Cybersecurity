.btn-primary:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }

.btn-ghost { background: var(--bg-secondary); color: var(--text-secondary); border: 1.5px solid var(--border); }

.btn-ghost:hover { border-color: var(--accent); color: var(--accent); }

.submit-msg { margin-top: 1rem; padding: 0.8rem 1.2rem; border-radius: 10px; font-size: 0.9rem; font-weight: 600; display: none; }

.submit-msg.show { display: block; }

.submit-msg.warn { background: rgba(247, 196, 77, 0.1); color: var(--accent-secondary); border: 1px solid var(--accent-secondary); }

.submit-msg.complete { background: var(--correct-bg); color: var(--correct); border: 1px solid var(--correct); font-size: 1rem; text-align: center; padding: 1.5rem; }

footer { border-top: 1px solid var(--border); text-align: center; padding: 2.5rem 1rem; color: var(--text-muted); font-size: 0.82rem; }

footer span { color: var(--accent); }

::-webkit-scrollbar { width: 6px; height: 6px; }

::-webkit-scrollbar-track { background: var(--bg-primary); }

::-webkit-scrollbar-thumb { background: var(--border-accent); border-radius: 999px; }

@keyframes fadeUp { 
  0% { opacity: 0; transform: translateY(22px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.hero-content > * { animation: 0.6s ease 0s 1 normal both running fadeUp; }

.hero-content h1 { animation-delay: 0.05s; }

.hero-content .hero-sub { animation-delay: 0.15s; }

.hero-content .hero-stats { animation-delay: 0.25s; }

.toc-card { animation: 0.6s ease 0.35s 1 normal both running fadeUp; }

@media (max-width: 680px) {
  .theme-switch-wrapper { top: 1rem; right: 1rem; }
  .hero { padding: 5rem 0px 3rem; }
  .hero-stats { gap: 1.5rem; }
  .container { padding: 0px 1rem; }
  .section { padding: 2.5rem 0px; }
  .toc-card { padding: 1.5rem; margin-top: 2rem; }
}
