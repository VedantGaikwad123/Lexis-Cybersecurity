              <text class="ts" x="531" y="104" text-anchor="middle" dominant-baseline="central">voice, vein pattern</text>
            </g>
            
            <line x1="107" y1="120" x2="250" y2="170" class="arr" stroke="#8b96a5" marker-end="url(#arr4)"></line>
