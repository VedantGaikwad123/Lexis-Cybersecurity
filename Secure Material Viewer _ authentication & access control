            <div class="quiz-options-list" id="quiz-options-list">
              <!-- Options buttons injected via JS -->
            </div>

            <div class="quiz-explanation-box hidden" id="quiz-explanation-box">
              <div class="explanation-title" id="quiz-feedback-title">Correct!</div>
              <p class="explanation-text" id="quiz-explanation-text">Explanation content goes here.</p>
            </div>

            <div class="quiz-action-footer">
              <button class="lab-btn" id="btn-quiz-next" disabled="">Next Question</button>
            </div>
          </div>

          <!-- Quiz Results / Certificate View -->
          <div class="quiz-result-view hidden" id="quiz-result-view">
            <h2 class="quiz-title"><i class="ti ti-trophy text-amber"></i> Assessment Completed</h2>
            
            <div class="quiz-score-badge" id="quiz-score-badge">8 / 10</div>
            <p class="quiz-result-feedback" id="quiz-result-feedback">Congratulations, you passed and earned your certification!</p>
            
