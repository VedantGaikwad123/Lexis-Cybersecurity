@charset "utf-8";

*, ::before, ::after { box-sizing: border-box; margin: 0px; padding: 0px; }

:root { --navy: #0f2744; --navy-mid: #1a3a5c; --navy-light: #2e5282; --cream: #f5f2eb; --cream-dark: #ede8de; --text-dark: #1c1c1e; --text-mid: #3d3d3a; --text-muted: #6b6b67; --accent: #e8a83e; --accent-light: #f4c96b; --green: #2a7d56; --green-light: #e1f5ec; --red: #c0392b; --red-light: #fdf0ee; --blue: #1a6cb0; --blue-light: #e8f2fb; --border: rgba(15, 39, 68, 0.12); --bg-page: var(--cream); --bg-card: #ffffff; --font-serif: 'Playfair Display', Georgia, serif; --font-sans: 'Source Sans 3', system-ui, sans-serif; --font-mono: 'JetBrains Mono', monospace; --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }

[data-theme="dark"] { --navy: #0a1d36; --navy-mid: #0d223a; --navy-light: #1a3a5c; --cream: #0f172a; --cream-dark: #1e293b; --text-dark: #f1f5f9; --text-mid: #cbd5e1; --text-muted: #94a3b8; --bg-page: #0f172a; --bg-card: #1e293b; --border: rgba(255, 255, 255, 0.1); --blue-light: rgba(26, 108, 176, 0.15); --green-light: rgba(42, 125, 86, 0.15); --red-light: rgba(192, 57, 43, 0.15); --accent: #fbbf24; }

body { font-family: var(--font-sans); background: var(--bg-page); color: var(--text-dark); font-size: 17px; line-height: 1.75; transition: background-color 0.3s, color 0.3s; }

.hero { background: var(--navy); color: white; padding: 64px 56px 56px; position: relative; overflow: hidden; }

.hero::before { content: ""; position: absolute; inset: 0px; background: radial-gradient(at 80% 50%, rgba(46, 82, 130, 0.6) 0%, transparent 60%); pointer-events: none; }

.hero-meta { display: flex; gap: 48px; margin-top: 40px; position: relative; }

.hero-meta-item .label { font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.08em; color: rgba(255, 255, 255, 0.5); text-transform: uppercase; margin-bottom: 4px; }

.hero-meta-item .value { font-family: var(--font-mono); font-size: 13px; color: rgba(255, 255, 255, 0.7); }

.hero h1 { font-family: var(--font-serif); font-size: clamp(2.8rem, 5vw, 4.2rem); font-weight: 900; line-height: 1.05; letter-spacing: -0.02em; position: relative; }

.hero p.subtitle { font-size: 1rem; color: rgba(255, 255, 255, 0.65); margin-top: 10px; font-weight: 300; position: relative; }

.theme-toggle { position: absolute; top: 32px; right: 32px; background: rgba(255, 255, 255, 0.08); backdrop-filter: blur(8px); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 30px; padding: 6px 16px; display: flex; gap: 12px; align-items: center; color: rgba(255, 255, 255, 0.6); font-size: 15px; z-index: 100; cursor: pointer; transition: var(--transition); }

.theme-toggle:hover { color: white; background: rgba(255, 255, 255, 0.12); }

.toc-section { background: var(--bg-page); padding: 48px 56px; border-bottom: 1px solid var(--border); }

.toc-box { background: var(--bg-card); border-left: 4px solid var(--navy); border-radius: 0px 8px 8px 0px; padding: 32px 36px; max-width: 780px; margin: 0px auto; box-shadow: rgba(0, 0, 0, 0.08) 0px 4px 20px; }

.toc-label { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 20px; }

.toc-list { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 4px 24px; }

.toc-list li { padding: 7px 0px; border-bottom: 1px solid var(--border); display: flex; gap: 12px; align-items: baseline; }

.toc-list li:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.toc-num { font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); min-width: 20px; }

.toc-list a { color: var(--navy); text-decoration: none; font-size: 15px; transition: color 0.2s; }

.toc-list a:hover { color: var(--accent); }

.content { max-width: 880px; margin: 0px auto; padding: 0px 40px; }

section.chapter { padding: 56px 0px 24px; border-bottom: 1px solid var(--border); }

h2.section-title { font-family: var(--font-serif); font-size: 2rem; font-weight: 700; color: var(--navy); margin-bottom: 6px; }

h2.section-title .num { font-family: var(--font-mono); font-size: 12px; color: var(--accent); display: block; margin-bottom: 4px; letter-spacing: 0.1em; }

h3.sub { font-family: var(--font-serif); font-size: 1.3rem; font-weight: 700; color: var(--navy-mid); margin: 32px 0px 10px; }

h4.subsub { font-family: var(--font-sans); font-size: 1rem; font-weight: 600; color: var(--text-dark); margin: 24px 0px 8px; border-left: 3px solid var(--accent); padding-left: 10px; }

p { margin-bottom: 1rem; color: var(--text-mid); }

strong { color: var(--text-dark); font-weight: 600; }

.callout { background: var(--blue-light); border-left: 4px solid var(--blue); border-radius: 0px 8px 8px 0px; padding: 16px 20px; margin: 20px 0px; font-size: 0.92rem; color: var(--text-mid); }

.callout.warn { background: rgb(255, 248, 230); border-color: var(--accent); }

.callout.danger { background: var(--red-light); border-color: var(--red); }

.callout.success { background: var(--green-light); border-color: var(--green); }

.callout strong { display: block; margin-bottom: 4px; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.06em; }

.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin: 20px 0px; }

.card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px; padding: 18px 16px; box-shadow: rgba(0, 0, 0, 0.05) 0px 2px 10px; }

.card h4 { font-weight: 600; font-size: 14px; color: var(--navy); margin-bottom: 6px; }

.card p { font-size: 13px; margin: 0px; }

code { font-family: var(--font-mono); font-size: 0.85em; background: rgba(15, 39, 68, 0.07); padding: 2px 6px; border-radius: 4px; color: var(--navy-mid); }

.code-block { background: rgb(26, 30, 46); color: rgb(201, 209, 217); padding: 20px 24px; border-radius: 8px; overflow-x: auto; font-family: var(--font-mono); font-size: 0.82rem; line-height: 1.6; margin: 16px 0px; }

.code-block pre { margin: 0px; }

.code-block .cmd { color: rgb(255, 123, 114); }

.code-block .flag { color: rgb(165, 214, 255); }

.code-block .comment { color: rgb(139, 148, 158); font-style: italic; }

.diagram-wrapper { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 28px 24px 20px; margin: 28px 0px; box-shadow: rgba(0, 0, 0, 0.08) 0px 4px 20px; text-align: center; }

.diagram-title { font-size: 12px; color: var(--text-muted); font-family: var(--font-mono); margin-top: 12px; letter-spacing: 0.04em; }

.quiz-section { background: var(--navy); padding: 56px; margin-top: 60px; color: white; }

.quiz-section h2 { font-family: var(--font-serif); font-size: 2rem; color: white; margin-bottom: 8px; }

.quiz-section > p { color: rgba(255, 255, 255, 0.6); font-size: 15px; margin-bottom: 36px; }

.quiz-card { background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: 28px 30px; margin-bottom: 20px; }

.quiz-q { font-size: 16px; font-weight: 600; color: white; margin-bottom: 18px; display: flex; gap: 12px; }

.quiz-q .quiz-num { font-family: var(--font-mono); font-size: 11px; color: var(--accent); display: block; margin-bottom: 6px; letter-spacing: 0.08em; }

.quiz-options { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

.quiz-opt { background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 8px; padding: 12px 16px; font-size: 14px; color: rgba(255, 255, 255, 0.8); cursor: pointer; transition: 0.2s; text-align: left; display: flex; align-items: center; gap: 10px; }

.quiz-opt:hover:not(:disabled) { background: rgba(255, 255, 255, 0.1); border-color: rgba(255, 255, 255, 0.25); }

.quiz-opt.correct { background: rgba(42, 125, 86, 0.25); border-color: rgb(42, 125, 86); color: rgb(125, 224, 172); }

.quiz-opt.wrong { background: rgba(192, 57, 43, 0.2); border-color: rgb(192, 57, 43); color: rgb(241, 148, 138); }

.quiz-opt:disabled { cursor: default; }

.quiz-opt-letter { font-family: var(--font-mono); font-size: 11px; background: rgba(255, 255, 255, 0.12); border-radius: 4px; padding: 1px 6px; color: rgba(255, 255, 255, 0.5); }

.quiz-feedback { margin-top: 14px; font-size: 13px; padding: 12px 14px; border-radius: 6px; display: none; }

.quiz-feedback.show { display: block; }

.quiz-feedback.correct-fb { background: rgba(42, 125, 86, 0.2); color: rgb(125, 224, 172); }

.quiz-feedback.wrong-fb { background: rgba(192, 57, 43, 0.15); color: rgb(241, 148, 138); }

.score-box { text-align: center; padding: 28px; background: rgba(255, 255, 255, 0.06); border-radius: 12px; margin-top: 8px; display: none; }

.score-number { font-family: var(--font-serif); font-size: 3rem; color: var(--accent); font-weight: 700; }

.btn-primary { background: var(--accent); color: var(--navy); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 12px 28px; border-radius: 30px; font-family: var(--font-sans); font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: 0.05em; cursor: pointer; transition: var(--transition); display: inline-flex; align-items: center; gap: 8px; box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 12px; margin-top: 20px; }

.btn-primary:hover { transform: translateY(-2px); box-shadow: rgba(232, 168, 62, 0.3) 0px 6px 20px; background: var(--accent-light); }

.btn-primary:disabled { opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: none; }

.submit-wrap { padding: 80px 40px; text-align: center; background: var(--bg-page); border-top: 1px solid var(--border); }

.submit-status { margin-top: 20px; font-size: 15px; font-weight: 500; transition: var(--transition); opacity: 0; }

.submit-status.show { opacity: 1; }

.submit-status.error { color: var(--red); }

.submit-status.success { color: var(--green); }

.completion-badge { display: none; align-items: center; justify-content: center; gap: 10px; color: var(--green); font-weight: 700; font-size: 1.2rem; margin-bottom: 20px; }

footer { background: rgb(10, 29, 54); color: rgba(255, 255, 255, 0.4); padding: 32px 56px; font-size: 13px; font-family: var(--font-mono); text-align: center; }

@media (max-width: 700px) {
  .hero { padding: 44px 24px 36px; }
  .content { padding: 0px 20px; }
  .toc-section { padding: 32px 20px; }
  .quiz-section { padding: 36px 20px; }
  .quiz-options { grid-template-columns: 1fr; }
  .hero-meta { flex-direction: column; gap: 20px; }
}
