      <line x1="560" y1="160" x2="407" y2="160" stroke="#dc2626" stroke-width="1.2" marker-end="url(#arrow)" opacity="0.5"></line>
      <line x1="140" y1="160" x2="293" y2="160" stroke="#0891b2" stroke-width="1.2" marker-end="url(#arrow)" opacity="0.5"></line>
