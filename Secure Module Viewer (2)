            <td><strong>WAF</strong></td>
            <td>Layer 7</td>
            <td><span class="badge badge-green">Yes</span></td>
            <td><span class="badge badge-green">Yes</span></td>
            <td>Web application protection</td>
            <td><span class="badge badge-yellow">Moderate</span></td>
          </tr>
        </tbody>
      </table>
