:root { --navy: #1a2e4a; --navy-dark: #14243c; --navy-light: #243858; --cream: #f0ece4; --cream-dark: #e8e3d9; --white: #ffffff; --accent: #4a90d9; --accent-gold: #c9a84c; --text-primary: #1a1a2e; --text-secondary: #4a5568; --text-muted: #718096; --border: #d4cfc6; --success: #2d7a4f; --danger: #c0392b; --warning: #d4851c; --info: #2471a3; --mono: 'IBM Plex Mono', monospace; --serif: 'Playfair Display', serif; --body-serif: 'Source Serif 4', serif; --sans: 'Inter', sans-serif; }

body.dark-mode { --navy: #0f172a; --navy-dark: #020617; --navy-light: #38bdf8; --cream: #0f172a; --cream-dark: #1e293b; --white: #1e293b; --text-primary: #f8fafc; --text-secondary: #cbd5e0; --text-muted: #94a3b8; --border: #334155; --accent: #38bdf8; }

body.dark-mode .callout.info { background: rgba(56, 189, 248, 0.1); color: rgb(186, 230, 253); border-color: rgb(56, 189, 248); }

body.dark-mode .callout.success { background: rgba(34, 197, 94, 0.1); color: rgb(187, 247, 208); border-color: rgb(34, 197, 94); }

body.dark-mode .callout.danger { background: rgba(239, 68, 68, 0.1); color: rgb(254, 202, 202); border-color: rgb(239, 68, 68); }

body.dark-mode .callout.warning { background: rgba(234, 179, 8, 0.1); color: rgb(254, 240, 138); border-color: rgb(234, 179, 8); }

body.dark-mode .callout.analogy { background: rgba(168, 85, 247, 0.1); color: rgb(233, 213, 255); border-color: rgb(168, 85, 247); }

body.dark-mode .pros { background: rgba(34, 197, 94, 0.05); border-color: rgb(6, 95, 70); color: rgb(187, 247, 208); }

body.dark-mode .cons { background: rgba(239, 68, 68, 0.05); border-color: rgb(153, 27, 27); color: rgb(254, 202, 202); }

body.dark-mode .pros ul { color: rgb(187, 247, 208); }

body.dark-mode .cons ul { color: rgb(254, 202, 202); }

body.dark-mode tr:nth-child(2n) td { background: rgba(255, 255, 255, 0.03); }

body.dark-mode .hero-controls { background: rgba(0, 0, 0, 0.3); }

.hero-controls span.active { opacity: 1; filter: drop-shadow(0 0 8px var(--accent)); transform: scale(1.2); }

.hero-controls span { transition: 0.3s; display: inline-block; }

body.dark-mode svg text { fill: rgb(226, 232, 240); }

body.dark-mode svg text[fill="#fff"], body.dark-mode svg text[fill="rgba(255,255,255,0.5)"], body.dark-mode svg text[fill="rgba(255,255,255,0.7)"] { fill: rgb(255, 255, 255); }

body.dark-mode svg ellipse[fill="#e8f0fb"], body.dark-mode svg rect[fill="#e8f0fb"] { fill: rgb(30, 41, 59); stroke: rgb(56, 189, 248); }

body.dark-mode svg rect[fill="#fdf6e8"], body.dark-mode svg rect[fill="#fdf0ef"], body.dark-mode svg ellipse[fill="#f4f0f9"], body.dark-mode svg rect[fill="#f4f0f9"] { fill: rgb(30, 41, 59); stroke: rgb(100, 116, 139); }

body.dark-mode svg rect[fill="#eaf6ef"] { fill: rgb(6, 78, 59); stroke: rgb(16, 185, 129); }

body.dark-mode svg line { stroke: rgb(148, 163, 184); }

body.dark-mode svg line[stroke="#2d7a4f"] { stroke: rgb(16, 185, 129); }

body.dark-mode svg line[stroke="#c0392b"] { stroke: rgb(239, 68, 68); }

* { margin: 0px; padding: 0px; box-sizing: border-box; }

body { font-family: var(--body-serif); font-size: 17px; line-height: 1.8; color: var(--text-primary); background: var(--cream); }

.hero { background: var(--navy); padding: 60px 60px 56px; position: relative; overflow: hidden; }

.hero::before { content: ""; position: absolute; inset: 0px; background: radial-gradient(at 80% 50%, rgba(74, 144, 217, 0.08) 0%, transparent 60%); pointer-events: none; }

.hero-controls { position: absolute; top: 24px; right: 28px; display: flex; align-items: center; gap: 6px; background: rgba(255, 255, 255, 0.1); border-radius: 999px; padding: 6px 14px; }

.hero-controls span { font-size: 18px; cursor: pointer; opacity: 0.8; }

.hero h1 { font-family: var(--serif); font-size: 68px; font-weight: 700; color: rgb(255, 255, 255); line-height: 1.05; letter-spacing: -1px; margin-bottom: 18px; }

.hero-subtitle { font-family: var(--sans); font-size: 16px; color: rgba(255, 255, 255, 0.65); margin-bottom: 44px; font-weight: 300; letter-spacing: 0.02em; }

.hero-meta { display: flex; gap: 48px; }

.hero-meta-item label { display: block; font-family: var(--mono); font-size: 11px; font-weight: 500; color: rgba(255, 255, 255, 0.5); letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 4px; }

.hero-meta-item span { font-family: var(--mono); font-size: 13px; color: rgba(255, 255, 255, 0.75); }

.page-body { max-width: 900px; margin: 0px auto; padding: 56px 40px 100px; }

.toc-card { background: var(--white); border-left: 4px solid var(--navy); border-radius: 0px 8px 8px 0px; padding: 32px 36px; margin-bottom: 64px; box-shadow: rgba(26, 46, 74, 0.07) 0px 2px 16px; }

.toc-title { font-family: var(--mono); font-size: 11px; letter-spacing: 0.18em; color: var(--text-muted); text-transform: uppercase; margin-bottom: 20px; }

.toc-list { list-style: none; }

.toc-list li { padding: 7px 0px; border-bottom: 1px solid var(--cream-dark); display: flex; align-items: baseline; gap: 12px; }

.toc-list li:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.toc-num { font-family: var(--mono); font-size: 12px; color: var(--text-muted); min-width: 18px; }

.toc-list a { color: var(--navy); text-decoration: none; font-family: var(--sans); font-size: 15px; font-weight: 400; transition: color 0.2s; }

.toc-list a:hover { color: var(--accent); }

h2 { font-family: var(--serif); font-size: 38px; font-weight: 700; color: var(--navy); margin: 64px 0px 20px; line-height: 1.15; scroll-margin-top: 24px; }

h3 { font-family: var(--sans); font-size: 20px; font-weight: 600; color: var(--navy-light); margin: 40px 0px 14px; letter-spacing: -0.01em; scroll-margin-top: 24px; }

h4 { font-family: var(--sans); font-weight: 600; margin: 28px 0px 10px; text-transform: uppercase; letter-spacing: 0.06em; font-size: 13px; color: var(--text-muted); }

p { margin-bottom: 18px; }

.section-divider { display: flex; align-items: center; gap: 16px; margin: 64px 0px 0px; }

.section-num { font-family: var(--mono); font-size: 13px; color: var(--accent); min-width: 28px; }

.section-line { flex: 1 1 0%; height: 1px; background: var(--border); }

.callout { border-radius: 8px; padding: 20px 24px; margin: 28px 0px; border-left: 4px solid; font-family: var(--sans); font-size: 15px; line-height: 1.65; }

.callout-title { font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px; }

.callout.info { background: rgb(232, 244, 253); border-color: var(--info); color: rgb(26, 74, 110); }

