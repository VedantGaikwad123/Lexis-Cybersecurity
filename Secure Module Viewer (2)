.code-block pre { font-family: var(--mono); font-size: 13px; color: rgb(168, 216, 234); line-height: 1.7; }

.code-comment { color: rgb(74, 107, 110); }

.code-key { color: rgb(121, 192, 255); }

.code-val { color: rgb(255, 166, 87); }

.code-str { color: rgb(165, 214, 255); }

.step-flow { display: flex; flex-direction: column; gap: 0px; margin: 28px 0px; position: relative; }

.step-item { display: flex; gap: 20px; align-items: flex-start; position: relative; }

.step-item:not(:last-child)::before { content: ""; position: absolute; left: 18px; top: 42px; bottom: -12px; width: 2px; background: linear-gradient(to bottom, var(--navy-light), var(--border)); }

.step-num { width: 38px; height: 38px; border-radius: 50%; background: var(--navy); color: rgb(255, 255, 255); display: flex; align-items: center; justify-content: center; font-family: var(--mono); font-size: 14px; font-weight: 500; flex-shrink: 0; margin-bottom: 24px; }

.step-content { padding-top: 6px; padding-bottom: 24px; }

.step-content strong { font-family: var(--sans); font-size: 15px; font-weight: 600; color: var(--navy-light); display: block; margin-bottom: 4px; }

