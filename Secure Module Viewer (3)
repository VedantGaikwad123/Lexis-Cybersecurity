        </tr>
        <tr>
          <td>System config</td>
          <td class="win-col">HKLM\SYSTEM (Registry)</td>
          <td class="lin-col">/etc/ directory</td>
        </tr>
        <tr>
          <td>User home</td>
          <td class="win-col">C:\Users\username\</td>
          <td class="lin-col">/home/username/</td>
        </tr>
        <tr>
