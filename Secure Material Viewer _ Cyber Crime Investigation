@charset "utf-8";

:root { --bg: #0b0f1a; --surface: #111827; --surface2: #1a2235; --surface3: #1f2d45; --border: #1e2d45; --border2: #2a3d58; --text: #e8edf5; --text2: #94a3b8; --text3: #5a7090; --accent: #3b82f6; --accent2: #60a5fa; --green: #22c55e; --green-bg: #0d2818; --amber: #f59e0b; --amber-bg: #1c1505; --red: #ef4444; --red-bg: #1f0808; --blue: #3b82f6; --blue-bg: #071428; --glow: 0 0 40px rgba(59,130,246,0.08); }

*, ::before, ::after { box-sizing: border-box; margin: 0px; padding: 0px; }

body { font-family: "DM Sans", sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; line-height: 1.6; }

body::before { content: ""; position: fixed; inset: 0px; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E"); pointer-events: none; z-index: 0; opacity: 0.4; }

.wrapper { max-width: 1280px; margin: 0px auto; padding: 0px 24px 80px; position: relative; z-index: 1; }

.hero { padding: 60px 0px 48px; display: flex; flex-direction: column; gap: 16px; }

.hero-badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.3); border-radius: 100px; padding: 5px 14px; font-size: 11px; font-weight: 600; color: var(--accent2); letter-spacing: 0.08em; text-transform: uppercase; width: fit-content; }

.hero h1 { font-family: Syne, sans-serif; font-size: clamp(32px, 6vw, 64px); font-weight: 800; line-height: 1.05; letter-spacing: -0.02em; background: linear-gradient(135deg, rgb(232, 237, 245) 0%, rgb(148, 163, 184) 60%, rgb(59, 130, 246) 100%) text; -webkit-text-fill-color: transparent; }

.hero p { font-size: 16px; color: var(--text2); max-width: 560px; line-height: 1.7; }

.hero-stats { display: flex; gap: 24px; flex-wrap: wrap; margin-top: 8px; }

.stat { display: flex; flex-direction: column; gap: 2px; }

.stat-num { font-family: Syne, sans-serif; font-size: 24px; font-weight: 800; color: var(--accent2); }

.stat-lbl { font-size: 12px; color: var(--text3); }

.tabs-wrap { position: sticky; top: 0px; z-index: 100; background: rgba(11, 15, 26, 0.9); backdrop-filter: blur(16px); border-bottom: 1px solid var(--border); padding: 12px 24px; margin: 0px -24px 32px; }

.tabs { display: flex; gap: 6px; flex-wrap: wrap; }

.tab { padding: 7px 16px; border-radius: 8px; border: 1px solid var(--border2); background: var(--surface); font-size: 12.5px; font-weight: 500; color: var(--text2); cursor: pointer; transition: 0.2s; font-family: "DM Sans", sans-serif; }

.tab:hover { background: var(--surface3); color: var(--text); border-color: var(--accent); }

.tab.active { background: var(--accent); border-color: var(--accent); color: rgb(255, 255, 255); font-weight: 600; }

.section { display: none; }

.section.visible { display: block; }

.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 16px; }

.card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; transition: border-color 0.2s, box-shadow 0.2s; }

.card:hover { border-color: var(--border2); box-shadow: var(--glow); }

.card-header { padding: 20px 20px 0px; cursor: pointer; }

.card-top { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 12px; }

.card-icon { width: 46px; height: 46px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0; }

.card-meta { flex: 1 1 0%; }

.card-title { font-family: Syne, sans-serif; font-size: 16px; font-weight: 700; color: var(--text); line-height: 1.25; }

.card-sub { font-size: 11px; color: var(--text3); margin-top: 3px; }

.badge { display: inline-block; font-size: 10px; padding: 2px 9px; border-radius: 100px; font-weight: 600; margin-top: 5px; letter-spacing: 0.04em; text-transform: uppercase; }

.badge-blue { background: rgba(59, 130, 246, 0.15); color: rgb(96, 165, 250); border: 1px solid rgba(59, 130, 246, 0.25); }

.badge-green { background: rgba(34, 197, 94, 0.12); color: rgb(74, 222, 128); border: 1px solid rgba(34, 197, 94, 0.25); }

.badge-amber { background: rgba(245, 158, 11, 0.12); color: rgb(251, 191, 36); border: 1px solid rgba(245, 158, 11, 0.25); }

.badge-red { background: rgba(239, 68, 68, 0.12); color: rgb(248, 113, 113); border: 1px solid rgba(239, 68, 68, 0.25); }

.card-body { font-size: 13.5px; color: var(--text2); line-height: 1.75; padding: 0px 20px 16px; cursor: pointer; }

.expand-btn { display: flex; align-items: center; justify-content: center; gap: 7px; padding: 11px 20px; background: var(--surface2); border-top: 1px solid var(--border); font-size: 12px; font-weight: 600; color: var(--accent2); cursor: pointer; transition: background 0.15s; font-family: "DM Sans", sans-serif; letter-spacing: 0.02em; }

.expand-btn:hover { background: var(--surface3); }

.expand-btn .arr { font-size: 11px; transition: transform 0.25s; }

.expand-btn.open .arr { transform: rotate(180deg); }

.detail-wrap { display: none; padding: 16px 20px 20px; border-top: 1px solid var(--border); background: rgba(255, 255, 255, 0.02); }

.dsec { background: var(--surface2); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; margin-bottom: 10px; }

.dsec-title { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text3); margin-bottom: 10px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }

.drow { display: flex; gap: 12px; padding: 5px 0px; font-size: 13px; border-bottom: 1px solid rgba(255, 255, 255, 0.03); }

.drow:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.dlabel { font-weight: 600; color: var(--text2); min-width: 110px; flex-shrink: 0; padding-top: 1px; }

.dval { color: var(--text); line-height: 1.65; flex: 1 1 0%; }

.example-box { background: linear-gradient(135deg, rgba(245, 158, 11, 0.07), rgba(245, 158, 11, 0.03)); border: 1px solid rgba(245, 158, 11, 0.2); border-radius: 10px; padding: 14px 16px; margin-bottom: 10px; }

.example-box .ex-title { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--amber); margin-bottom: 7px; display: flex; align-items: center; gap: 6px; }

.example-box p { font-size: 13px; color: rgb(212, 168, 71); line-height: 1.7; }

.fact-box { background: linear-gradient(135deg, rgba(59, 130, 246, 0.08), rgba(59, 130, 246, 0.03)); border: 1px solid rgba(59, 130, 246, 0.2); border-radius: 10px; padding: 14px 16px; }

.fact-box .fact-title { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent2); margin-bottom: 7px; display: flex; align-items: center; gap: 6px; }

.fact-box p { font-size: 13px; color: rgb(147, 197, 253); line-height: 1.7; }

.flow-section { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 24px 24px 20px; margin-bottom: 16px; }

.flow-section h3 { font-family: Syne, sans-serif; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text2); margin-bottom: 20px; }

.flow-wrap { overflow-x: auto; padding-bottom: 8px; }

.flow { display: flex; align-items: center; min-width: 750px; }

.fstep { border-radius: 10px; padding: 10px 14px; font-size: 12px; font-weight: 600; text-align: center; min-width: 96px; border: 1px solid var(--border2); background: var(--surface2); color: var(--text); font-family: "DM Sans", sans-serif; }

.fstep .fsub { font-size: 10px; font-weight: 400; margin-top: 2px; opacity: 0.6; }

.farr { font-size: 16px; color: var(--text3); padding: 0px 8px; flex-shrink: 0; }

.fstep.danger { background: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.3); color: rgb(248, 113, 113); }

.fstep.info { background: rgba(59, 130, 246, 0.1); border-color: rgba(59, 130, 246, 0.3); color: rgb(96, 165, 250); }

.fstep.success { background: rgba(34, 197, 94, 0.1); border-color: rgba(34, 197, 94, 0.3); color: rgb(74, 222, 128); }

.note-bar { background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.2); border-radius: 8px; padding: 10px 14px; font-size: 12.5px; color: rgb(251, 191, 36); margin-top: 14px; line-height: 1.55; }

.cat-label { font-family: Syne, sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text3); margin-bottom: 14px; margin-top: 32px; display: flex; align-items: center; gap: 10px; }

.cat-label::after { content: ""; flex: 1 1 0%; height: 1px; background: var(--border); }

::-webkit-scrollbar { width: 6px; height: 6px; }

::-webkit-scrollbar-track { background: var(--bg); }

::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 3px; }

@media (max-width: 640px) {
  .grid { grid-template-columns: 1fr; }
  .hero h1 { font-size: 32px; }
  .tabs { gap: 4px; }
  .tab { padding: 6px 11px; font-size: 11.5px; }
}
