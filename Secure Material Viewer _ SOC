:root { --bg: #0a0e14; --surface: #111827; --surface2: #1a2332; --border: #2a3548; --accent: #10b981; --accent2: #f59e0b; --accent3: #ef4444; --accent4: #3b82f6; --text: #cbd5e1; --text-dim: #64748b; --text-bright: #f1f5f9; }

* { scroll-behavior: smooth; }

body { background: var(--bg); color: var(--text); font-family: Inter, sans-serif; }

.mono { font-family: "Space Mono", monospace; }

.sidebar { width: 280px; background: var(--surface); border-right: 1px solid var(--border); }

.sidebar a { display: flex; align-items: center; gap: 0.6rem; padding: 0.55rem 0.9rem; border-radius: 0.4rem; font-size: 0.82rem; color: var(--text-dim); transition: 0.15s; font-weight: 500; }

.sidebar a:hover { background: var(--surface2); color: var(--text-bright); }

.sidebar a.active { background: rgba(16, 185, 129, 0.1); color: var(--accent); border-left: 2px solid var(--accent); }

.section-card { background: var(--surface); border: 1px solid var(--border); border-radius: 0.6rem; }

.tool-card { background: var(--surface2); border: 1px solid var(--border); border-radius: 0.6rem; transition: 0.2s; }

.tool-card:hover { border-color: var(--accent4); transform: translateY(-3px); box-shadow: rgba(59, 130, 246, 0.12) 0px 8px 24px; }

.placeholder-box { border: 2px dashed var(--border); border-radius: 0.5rem; background: rgba(255, 255, 255, 0.02); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 1.5rem; gap: 0.5rem; color: var(--text-dim); }

.badge { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 0.2rem 0.6rem; border-radius: 0.3rem; }

.badge-green { background: rgba(16, 185, 129, 0.12); color: var(--accent); border: 1px solid rgba(16, 185, 129, 0.3); }

.badge-amber { background: rgba(245, 158, 11, 0.12); color: var(--accent2); border: 1px solid rgba(245, 158, 11, 0.3); }

.badge-red { background: rgba(239, 68, 68, 0.12); color: var(--accent3); border: 1px solid rgba(239, 68, 68, 0.3); }

.badge-blue { background: rgba(59, 130, 246, 0.12); color: var(--accent4); border: 1px solid rgba(59, 130, 246, 0.3); }

table.soc-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }

table.soc-table th { background: var(--surface2); text-align: left; padding: 0.7rem 1rem; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-dim); border-bottom: 1px solid var(--border); }

table.soc-table td { padding: 0.7rem 1rem; border-bottom: 1px solid var(--border); }

table.soc-table tr:hover td { background: rgba(255, 255, 255, 0.02); }

.flow-box { background: var(--surface2); border: 1px solid var(--border); border-radius: 0.5rem; padding: 0.9rem 1.2rem; text-align: center; font-size: 0.85rem; font-weight: 600; }

.flow-arrow { color: var(--text-dim); font-size: 1.2rem; display: flex; align-items: center; justify-content: center; }

.matrix-cell { border-radius: 0.5rem; padding: 1.2rem; border: 1px solid var(--border); }

h2.section-title { font-size: 1.6rem; font-weight: 800; color: var(--text-bright); display: flex; align-items: center; gap: 0.7rem; }

h3.sub-title { font-size: 1.05rem; font-weight: 700; color: var(--text-bright); margin-top: 1.2rem; margin-bottom: 0.6rem; }

.scroll-pt { scroll-margin-top: 1.5rem; }

::-webkit-scrollbar { width: 8px; }

::-webkit-scrollbar-track { background: var(--surface); }

::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
