ul, ol.content-list { padding-left: 0px; list-style: none; margin-bottom: 20px; }

ul li, ol.content-list li { position: relative; padding: 6px 0px 6px 26px; color: var(--text-secondary); border-bottom: 1px solid var(--border); }

ul li:last-child, ol.content-list li:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

ul li::before { content: "›"; position: absolute; left: 6px; color: var(--accent); font-size: 1.1rem; font-weight: 700; }

ol.content-list { counter-reset: cl 0; }

