.section-tag { display: inline-block; font-family: "JetBrains Mono", monospace; font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; background: var(--tag-bg); color: var(--accent); border: 1px solid var(--border-strong); border-radius: 4px; padding: 3px 10px; margin-bottom: 12px; }

