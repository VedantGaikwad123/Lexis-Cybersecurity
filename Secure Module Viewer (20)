ol.content-list li::before { content: counter(cl) "."; position: absolute; left: 0px; font-family: "JetBrains Mono", monospace; font-size: 0.8rem; color: var(--accent); font-weight: 600; }

.callout { border-radius: 10px; padding: 22px 26px; margin: 28px 0px; border-left: 4px solid; transition: background 0.4s; }

.callout.info { background: rgba(78, 154, 241, 0.07); border-color: var(--accent); }

.callout.warning { background: rgba(240, 201, 107, 0.07); border-color: var(--accent-2); }

.callout.case { background: rgba(46, 204, 113, 0.06); border-color: var(--correct); }

.callout.danger { background: rgba(231, 76, 60, 0.07); border-color: var(--incorrect); }

.callout-title { font-family: "JetBrains Mono", monospace; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; margin-bottom: 10px; }

.callout.info .callout-title { color: var(--accent); }

.callout.warning .callout-title { color: var(--accent-2); }

.callout.case .callout-title { color: var(--correct); }

