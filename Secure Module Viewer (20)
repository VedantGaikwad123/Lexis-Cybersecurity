        <tr><td>E-Governance</td><td>Online filing, digital signatures, electronic retention</td><td>Chapter V</td></tr>
        <tr><td>Regulation of CAs</td><td>Certifying Authorities licensing and regulation</td><td>Chapters VI–VIII</td></tr>
        <tr><td>Cybercrime Offences</td><td>Hacking, data theft, virus, fraud, terrorism</td><td>Chapter XI</td></tr>
        <tr><td>Adjudication</td><td>Compensation, dispute resolution</td><td>Chapter IX</td></tr>
        <tr><td>Cyber Appellate Tribunal</td><td>Appeals process</td><td>Chapter X</td></tr>
        <tr><td>Miscellaneous</td><td>Intermediary liability, network service providers</td><td>Chapter XII</td></tr>
      </tbody>
    </table>
