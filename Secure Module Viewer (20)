.score-display { color: var(--accent); font-weight: 600; font-size: 1rem; }

.progress-track { flex: 1 1 0%; height: 6px; background: var(--border); border-radius: 99px; margin: 0px 20px; overflow: hidden; }

.progress-fill { height: 100%; background: linear-gradient(90deg, var(--accent), var(--correct)); border-radius: 99px; transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1); }

.quiz-question { background: var(--bg-card); border-radius: 12px; padding: 28px 32px; margin-bottom: 24px; border: 1px solid var(--border); transition: border-color 0.3s, background 0.4s; }

.quiz-question.answered-correct { border-color: var(--correct); }

.quiz-question.answered-incorrect { border-color: var(--incorrect); }

.question-num { font-family: "JetBrains Mono", monospace; font-size: 0.7rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--accent); margin-bottom: 10px; }

.question-text { font-size: 1.05rem; color: var(--text-primary); font-weight: 400; margin-bottom: 20px; line-height: 1.6; }

.options { display: flex; flex-direction: column; gap: 10px; }

.option-btn { display: flex; align-items: center; gap: 14px; padding: 13px 18px; border-radius: 8px; border: 1.5px solid var(--border); background: transparent; cursor: pointer; text-align: left; color: var(--text-secondary); font-family: "Source Serif 4", serif; font-size: 0.95rem; transition: 0.2s; width: 100%; }

.option-btn:hover:not(:disabled) { border-color: var(--accent); background: var(--tag-bg); color: var(--text-primary); }

.option-btn:disabled { cursor: not-allowed; }

.option-btn.correct { background: rgba(46, 204, 113, 0.1); border-color: var(--correct); color: var(--correct); }

.option-btn.incorrect { background: rgba(231, 76, 60, 0.1); border-color: var(--incorrect); color: var(--incorrect); }

.option-letter { width: 26px; height: 26px; border-radius: 50%; background: var(--tag-bg); border: 1px solid var(--border-strong); display: flex; align-items: center; justify-content: center; font-family: "JetBrains Mono", monospace; font-size: 0.72rem; font-weight: 600; color: var(--accent); flex-shrink: 0; }

.option-btn.correct .option-letter { background: rgba(46, 204, 113, 0.2); border-color: var(--correct); color: var(--correct); }

