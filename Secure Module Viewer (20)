.hero h1 { font-family: "Playfair Display", serif; font-size: clamp(2.8rem, 6vw, 5rem); font-weight: 900; color: rgb(255, 255, 255); line-height: 1.1; letter-spacing: -0.02em; margin-bottom: 18px; }

