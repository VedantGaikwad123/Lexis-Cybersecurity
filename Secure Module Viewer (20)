.hero-meta { display: flex; gap: 50px; flex-wrap: wrap; }

.hero-meta-item label { display: block; font-family: "JetBrains Mono", monospace; font-size: 0.7rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255, 255, 255, 0.5); margin-bottom: 4px; }

.hero-meta-item span { font-family: "JetBrains Mono", monospace; font-size: 0.85rem; color: rgba(255, 255, 255, 0.7); }

.arrow { color: var(--accent-2); }

.page-body { background: var(--bg-primary); min-height: 100vh; transition: background 0.4s; }

.content-wrap { max-width: 820px; margin: 0px auto; padding: 60px 30px 100px; }

.toc { background: var(--bg-card); border-left: 4px solid var(--toc-border); border-radius: 0px 12px 12px 0px; padding: 36px 40px; margin-bottom: 60px; box-shadow: rgba(0, 0, 0, 0.12) 0px 4px 24px; transition: background 0.4s; }

.toc-label { font-family: "JetBrains Mono", monospace; font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 20px; }

.toc ol { list-style: none; counter-reset: toc 0; padding: 0px; }

.toc ol li { counter-increment: toc 1; padding: 9px 0px; border-bottom: 1px solid var(--border); display: flex; align-items: baseline; gap: 14px; }

.toc ol li:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.toc ol li::before { content: counter(toc) "."; font-family: "JetBrains Mono", monospace; font-size: 0.78rem; color: var(--text-muted); min-width: 22px; flex-shrink: 0; }

.toc ol li a { color: var(--accent); text-decoration: none; font-size: 1rem; font-weight: 400; transition: color 0.2s; }

.toc ol li a:hover { color: var(--accent-2); text-decoration: underline; }

section { margin-bottom: 64px; }

h2 { font-family: "Playfair Display", serif; font-size: 2rem; font-weight: 700; color: var(--text-primary); margin-bottom: 20px; padding-bottom: 12px; border-bottom: 2px solid var(--border-strong); line-height: 1.25; }

