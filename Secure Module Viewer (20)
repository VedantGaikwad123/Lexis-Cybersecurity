.feedback.show { display: block; }

.feedback.correct-fb { background: rgba(46, 204, 113, 0.1); color: var(--correct); border-left: 3px solid var(--correct); }

.feedback.incorrect-fb { background: rgba(231, 76, 60, 0.1); color: var(--incorrect); border-left: 3px solid var(--incorrect); }

.quiz-actions { display: flex; gap: 16px; justify-content: center; margin-top: 36px; flex-wrap: wrap; }

.btn { padding: 14px 36px; border-radius: 8px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; font-family: "Source Serif 4", serif; font-size: 1rem; font-weight: 600; transition: 0.25s; letter-spacing: 0.02em; }

.btn-primary { background: var(--accent); color: rgb(255, 255, 255); box-shadow: rgba(78, 154, 241, 0.3) 0px 4px 16px; }

.btn-primary:hover { transform: translateY(-2px); box-shadow: rgba(78, 154, 241, 0.4) 0px 8px 24px; }

.btn-primary:disabled { background: var(--text-muted); box-shadow: none; cursor: not-allowed; transform: none; }

.btn-secondary { background: var(--tag-bg); color: var(--accent); border: 1.5px solid var(--border-strong); }

.btn-secondary:hover { background: var(--border-strong); }

.quiz-result-msg { text-align: center; padding: 20px; border-radius: 10px; font-size: 1rem; font-weight: 600; display: none; margin-top: 20px; }

.quiz-result-msg.show { display: block; }

.quiz-result-msg.fail { background: rgba(231, 76, 60, 0.1); color: var(--incorrect); }

.quiz-result-msg.success { background: rgba(46, 204, 113, 0.1); color: var(--correct); }

.divider { border-right-width: medium; border-bottom-width: medium; border-left-width: medium; border-right-style: none; border-bottom-style: none; border-left-style: none; border-right-color: currentcolor; border-bottom-color: currentcolor; border-left-color: currentcolor; border-image: none; border-top: 1px solid var(--border); margin: 50px 0px; }

.analogy { background: linear-gradient(135deg, var(--bg-card), var(--bg-secondary)); border: 1px solid var(--border-strong); border-radius: 12px; padding: 24px 28px; margin: 24px 0px; position: relative; overflow: hidden; }

.analogy::before { content: "\""; position: absolute; top: -10px; left: 16px; font-size: 7rem; color: var(--border-strong); font-family: "Playfair Display", serif; line-height: 1; }

.analogy p { position: relative; z-index: 1; font-style: italic; color: var(--text-secondary); font-size: 1.02rem; }

.analogy-label { font-family: "JetBrains Mono", monospace; font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--accent-2); margin-bottom: 8px; position: relative; z-index: 1; }

.steps { counter-reset: step 0; }

.step { display: flex; gap: 20px; margin-bottom: 20px; align-items: flex-start; }

.step-num { counter-increment: step 1; min-width: 38px; height: 38px; background: var(--accent); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: "JetBrains Mono", monospace; font-size: 0.82rem; font-weight: 600; flex-shrink: 0; margin-top: 2px; }

.step-content { flex: 1 1 0%; }

.step-content strong { display: block; margin-bottom: 4px; color: var(--text-primary); }

.step-content p { margin: 0px; font-size: 0.95rem; }

@media (max-width: 600px) {
  .hero { padding: 70px 24px 50px; }
  .content-wrap { padding: 40px 20px 80px; }
  .quiz-section { padding: 30px 20px; }
  .toc { padding: 24px 22px; }
  h2 { font-size: 1.6rem; }
  .hero-meta { gap: 28px; }
