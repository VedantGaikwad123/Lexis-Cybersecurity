.data-table td { padding: 13px 18px; color: var(--text-secondary); border-bottom: 1px solid var(--border); }

.data-table tr:last-child td { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.data-table tr:hover td { background: var(--border); }

.quiz-section { background: var(--bg-secondary); border-radius: 16px; padding: 50px 40px; margin-top: 80px; border: 1px solid var(--border-strong); transition: background 0.4s; }

.quiz-header { text-align: center; margin-bottom: 40px; }

.quiz-header h2 { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding-bottom: 0px; font-size: 2.2rem; }

