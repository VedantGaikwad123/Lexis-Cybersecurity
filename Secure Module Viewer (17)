:root[data-theme="dark"] { --bg-page: #1a2236; --bg-hero: #1e3a5f; --bg-card: #1e2d47; --bg-toc: #1e2d47; --border-toc: #2e5090; --text-primary: #e8edf5; --text-secondary: #9aadcc; --text-muted: #6b829e; --accent: #4a9eff; --accent-glow: rgba(74,158,255,0.18); --accent2: #64d8cb; --hero-pattern: rgba(255,255,255,0.03); --card-shadow: 0 4px 28px rgba(0,0,0,0.45); --code-bg: #111b2e; --code-border: #2a3f5f; --correct: #22c55e; --incorrect: #ef4444; --quiz-option: #233250; --quiz-hover: #2a3e65; --btn-bg: #2e5090; --btn-hover: #3a64b8; --toggle-bg: #2e3f5a; --divider: rgba(255,255,255,0.07); --svg-stroke: #4a9eff; --svg-fill: rgba(74,158,255,0.08); --tag-bg: rgba(74,158,255,0.12); }

:root[data-theme="light"] { --bg-page: #f0f2f7; --bg-hero: #1e3a5f; --bg-card: #ffffff; --bg-toc: #ffffff; --border-toc: #c5d6ef; --text-primary: #1a2540; --text-secondary: #3a5278; --text-muted: #7a90b0; --accent: #1d5fb8; --accent-glow: rgba(29,95,184,0.10); --accent2: #0d9e90; --hero-pattern: rgba(255,255,255,0.03); --card-shadow: 0 4px 20px rgba(0,0,0,0.10); --code-bg: #eef2f8; --code-border: #c8d8ef; --correct: #16a34a; --incorrect: #dc2626; --quiz-option: #eef2f8; --quiz-hover: #dce7f5; --btn-bg: #1e3a5f; --btn-hover: #274d80; --toggle-bg: #d8e4f0; --divider: rgba(0,0,0,0.07); --svg-stroke: #1d5fb8; --svg-fill: rgba(29,95,184,0.06); --tag-bg: rgba(29,95,184,0.08); }

*, ::before, ::after { box-sizing: border-box; margin: 0px; padding: 0px; }

html { scroll-behavior: smooth; }

body { font-family: Lato, sans-serif; background: var(--bg-page); color: var(--text-primary); line-height: 1.75; transition: background 0.35s, color 0.35s; }

.hero { background: var(--bg-hero); padding: 72px 48px 56px; position: relative; overflow: hidden; }

.hero::before { content: ""; position: absolute; inset: 0px; background-image: repeating-linear-gradient(0deg, var(--hero-pattern) 0, var(--hero-pattern) 1px, transparent 1px, transparent 40px),
      repeating-linear-gradient(90deg, var(--hero-pattern) 0, var(--hero-pattern) 1px, transparent 1px, transparent 40px); pointer-events: none; }

.hero-inner { max-width: 860px; position: relative; z-index: 1; }

.hero h1 { font-family: "Playfair Display", Georgia, serif; font-size: clamp(2.4rem, 5vw, 3.8rem); font-weight: 900; color: rgb(255, 255, 255); line-height: 1.12; margin-bottom: 16px; letter-spacing: -0.02em; }

.hero .subtitle { font-family: Lato, sans-serif; font-size: 1.05rem; color: rgba(255, 255, 255, 0.72); font-weight: 300; margin-bottom: 40px; }

.hero-meta { display: flex; gap: 52px; flex-wrap: wrap; }

.hero-meta-item { }

.hero-meta-item .label { font-family: "Source Code Pro", monospace; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.12em; color: rgba(255, 255, 255, 0.55); text-transform: uppercase; margin-bottom: 4px; }

.hero-meta-item .value { font-family: "Source Code Pro", monospace; font-size: 0.88rem; color: rgba(255, 255, 255, 0.72); }

.theme-toggle { position: fixed; top: 20px; right: 24px; z-index: 999; background: var(--toggle-bg); border-radius: 40px; padding: 6px 10px; display: flex; align-items: center; gap: 6px; box-shadow: rgba(0, 0, 0, 0.25) 0px 2px 12px; cursor: pointer; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; transition: background 0.3s; }

.theme-toggle .icon { font-size: 1.1rem; }

.theme-toggle .toggle-track { width: 36px; height: 20px; background: rgba(74, 158, 255, 0.35); border-radius: 20px; position: relative; transition: background 0.3s; }

.theme-toggle .toggle-thumb { position: absolute; top: 3px; left: 3px; width: 14px; height: 14px; background: rgb(255, 255, 255); border-radius: 50%; transition: transform 0.3s; }

[data-theme="light"] .toggle-thumb { transform: translateX(16px); }

.theme-toggle .shield { font-size: 1.1rem; }

.page-body { max-width: 860px; margin: 0px auto; padding: 56px 24px 80px; }

.toc-card { background: var(--bg-toc); border-left: 4px solid var(--accent); border-radius: 6px; padding: 32px 36px; margin-bottom: 56px; box-shadow: var(--card-shadow); }

.toc-label { font-family: "Source Code Pro", monospace; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.18em; color: var(--text-muted); text-transform: uppercase; margin-bottom: 20px; }

.toc-list { list-style: none; counter-reset: toc 0; }

.toc-list li { counter-increment: toc 1; margin-bottom: 10px; }

.toc-list li a { color: var(--accent); text-decoration: none; font-size: 0.97rem; font-weight: 400; display: flex; align-items: center; gap: 10px; transition: color 0.2s; }

.toc-list li a::before { content: counter(toc) "."; font-family: "Source Code Pro", monospace; font-size: 0.8rem; color: var(--text-muted); min-width: 22px; }

.toc-list li a:hover { color: var(--accent2); }

.section { margin-bottom: 64px; }

.section-tag { display: inline-block; font-family: "Source Code Pro", monospace; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--accent); background: var(--tag-bg); padding: 4px 10px; border-radius: 3px; margin-bottom: 10px; }

h2 { font-family: "Playfair Display", serif; font-size: clamp(1.55rem, 3vw, 2.1rem); font-weight: 700; color: var(--text-primary); margin-bottom: 18px; line-height: 1.25; }

h3 { font-family: "Playfair Display", serif; font-size: 1.25rem; font-weight: 700; color: var(--text-primary); margin: 32px 0px 12px; }

h4 { font-family: Lato, sans-serif; font-size: 1rem; font-weight: 700; color: var(--accent2); margin: 24px 0px 8px; text-transform: uppercase; letter-spacing: 0.06em; }

p { color: var(--text-secondary); font-size: 0.975rem; margin-bottom: 16px; }

ul, ol { color: var(--text-secondary); font-size: 0.975rem; padding-left: 22px; margin-bottom: 16px; }

li { margin-bottom: 7px; }

strong { color: var(--text-primary); font-weight: 700; }

em { color: var(--accent2); font-style: italic; }

.divider { height: 1px; background: var(--divider); margin: 48px 0px; }

.info-card { background: var(--bg-card); border-radius: 8px; padding: 28px 32px; margin: 24px 0px; box-shadow: var(--card-shadow); border: 1px solid var(--divider); }

.info-card.accent-left { border-left: 4px solid var(--accent); }

.info-card.accent2-left { border-left: 4px solid var(--accent2); }

.info-card.warning-left { border-left: 4px solid rgb(245, 158, 11); }

.info-card.danger-left { border-left: 4px solid rgb(239, 68, 68); }

pre { background: var(--code-bg); border: 1px solid var(--code-border); border-radius: 6px; padding: 20px 24px; overflow-x: auto; margin: 20px 0px; }

code { font-family: "Source Code Pro", monospace; font-size: 0.84rem; color: var(--accent2); line-height: 1.7; }

p code, li code { background: var(--code-bg); border: 1px solid var(--code-border); padding: 2px 7px; border-radius: 3px; font-size: 0.82rem; color: var(--accent2); }

.step-list { list-style: none; padding: 0px; counter-reset: steps 0; }

.step-list li { counter-increment: steps 1; display: flex; gap: 18px; align-items: flex-start; margin-bottom: 18px; color: var(--text-secondary); font-size: 0.975rem; }

.step-list li::before { content: counter(steps); min-width: 32px; height: 32px; background: var(--accent); color: rgb(255, 255, 255); font-family: "Source Code Pro", monospace; font-size: 0.78rem; font-weight: 700; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px; }

.diagram-wrap { background: var(--bg-card); border: 1px solid var(--divider); border-radius: 8px; padding: 24px; margin: 28px 0px; overflow-x: auto; box-shadow: var(--card-shadow); }

.diagram-wrap svg { display: block; margin: 0px auto; max-width: 100%; }

.diagram-caption { text-align: center; font-family: "Source Code Pro", monospace; font-size: 0.72rem; color: var(--text-muted); letter-spacing: 0.08em; margin-top: 12px; }

.compare-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 20px 0px; }

@media (max-width: 600px) {
  .compare-grid { grid-template-columns: 1fr; }
}

.compare-card { background: var(--bg-card); border: 1px solid var(--divider); border-radius: 8px; padding: 20px 22px; }

.compare-card h5 { font-family: "Source Code Pro", monospace; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin-bottom: 12px; }

.compare-card.pro h5 { color: var(--correct); }

.compare-card.con h5 { color: var(--incorrect); }

.compare-card ul { color: var(--text-secondary); font-size: 0.9rem; }

.quiz-section { background: var(--bg-card); border: 1px solid var(--divider); border-radius: 10px; padding: 40px 36px; margin-top: 56px; box-shadow: var(--card-shadow); }

.quiz-header { margin-bottom: 32px; }

.quiz-header h2 { margin-bottom: 6px; }

.quiz-header p { color: var(--text-muted); font-size: 0.9rem; }

.quiz-score-bar { display: flex; align-items: center; gap: 14px; margin-bottom: 32px; }

.score-label { font-family: "Source Code Pro", monospace; font-size: 0.82rem; color: var(--text-muted); }

.score-track { flex: 1 1 0%; height: 6px; background: var(--divider); border-radius: 6px; overflow: hidden; }

.score-fill { height: 100%; background: linear-gradient(90deg, var(--accent), var(--accent2)); border-radius: 6px; transition: width 0.5s; width: 0%; }

.score-count { font-family: "Source Code Pro", monospace; font-size: 0.82rem; color: var(--accent); min-width: 36px; text-align: right; }

.quiz-question { margin-bottom: 36px; }

.q-number { font-family: "Source Code Pro", monospace; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.14em; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; }

.q-text { font-size: 1rem; font-weight: 700; color: var(--text-primary); margin-bottom: 16px; line-height: 1.45; }

.options { display: flex; flex-direction: column; gap: 10px; }

.option-btn { background: var(--quiz-option); border: 1px solid var(--divider); border-radius: 6px; padding: 13px 18px; text-align: left; font-family: Lato, sans-serif; font-size: 0.93rem; color: var(--text-secondary); cursor: pointer; transition: background 0.2s, border-color 0.2s, color 0.2s; display: flex; align-items: center; gap: 12px; }

.option-btn:hover:not(:disabled) { background: var(--quiz-hover); border-color: var(--accent); color: var(--text-primary); }

.option-btn .opt-key { font-family: "Source Code Pro", monospace; font-size: 0.75rem; font-weight: 700; color: var(--text-muted); min-width: 22px; transition: color 0.2s; }

.option-btn.correct { background: rgba(34, 197, 94, 0.12); border-color: var(--correct); color: var(--correct); }

.option-btn.correct .opt-key { color: var(--correct); }

.option-btn.incorrect { background: rgba(239, 68, 68, 0.1); border-color: var(--incorrect); color: var(--incorrect); }

.option-btn.incorrect .opt-key { color: var(--incorrect); }

.option-btn:disabled { cursor: not-allowed; }

.feedback-msg { margin-top: 12px; padding: 10px 14px; border-radius: 5px; font-size: 0.875rem; font-weight: 400; display: none; }

.feedback-msg.correct { background: rgba(34, 197, 94, 0.1); color: var(--correct); border-left: 3px solid var(--correct); display: block; }

.feedback-msg.incorrect { background: rgba(239, 68, 68, 0.08); color: var(--incorrect); border-left: 3px solid var(--incorrect); display: block; }

.quiz-actions { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; margin-top: 36px; padding-top: 28px; border-top: 1px solid var(--divider); }

.btn { font-family: "Source Code Pro", monospace; font-size: 0.82rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; padding: 12px 24px; border-radius: 5px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; transition: background 0.2s, opacity 0.2s; }

.btn-primary { background: var(--btn-bg); color: rgb(255, 255, 255); }

.btn-primary:hover { background: var(--btn-hover); }

.btn-secondary { background: transparent; color: var(--accent); border: 1px solid var(--accent); }

.btn-secondary:hover { background: var(--accent-glow); }

.btn:disabled { opacity: 0.4; cursor: not-allowed; }

.submit-msg { font-size: 0.88rem; padding: 10px 14px; border-radius: 5px; display: none; margin-top: 8px; width: 100%; }

.submit-msg.warn { background: rgba(245, 158, 11, 0.1); color: rgb(245, 158, 11); border-left: 3px solid rgb(245, 158, 11); display: block; }

.submit-msg.success { background: rgba(34, 197, 94, 0.12); color: var(--correct); border-left: 3px solid var(--correct); display: block; }

.complete-badge { display: none; align-items: center; gap: 10px; background: rgba(34, 197, 94, 0.1); border: 1px solid var(--correct); border-radius: 8px; padding: 16px 24px; margin-top: 24px; color: var(--correct); font-size: 0.95rem; font-weight: 700; }

.complete-badge.show { display: flex; }

.complete-badge .badge-icon { font-size: 1.6rem; }

.highlight-box { background: var(--accent-glow); border: 1px solid rgba(74, 158, 255, 0.25); border-radius: 6px; padding: 18px 22px; margin: 20px 0px; font-size: 0.95rem; color: var(--text-secondary); }

.analogy-box { background: var(--bg-card); border-radius: 8px; border: 1px dashed var(--accent); padding: 22px 26px; margin: 24px 0px; }

.analogy-box .analogy-label { font-family: "Source Code Pro", monospace; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--accent2); margin-bottom: 8px; }

.ascii-diagram { font-family: "Source Code Pro", monospace; font-size: 0.78rem; line-height: 1.55; color: var(--accent2); background: var(--code-bg); border: 1px solid var(--code-border); border-radius: 6px; padding: 22px 24px; margin: 24px 0px; overflow-x: auto; white-space: pre; }
