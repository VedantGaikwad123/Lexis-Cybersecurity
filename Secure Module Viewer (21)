:root { --bg: #0f1e35; --bg2: #162540; --bg3: #1c2e4a; --card: #1a2d45; --card2: #213452; --border: rgba(255,255,255,0.08); --accent: #4a9eff; --accent2: #64b5f6; --accent3: #ffd166; --text: #e8edf5; --text2: #9aafc8; --text3: #6b85a3; --heading: #ffffff; --toc-bg: #1a2d45; --toc-border: #2d4a6e; --toc-link: #7eb8f7; --correct: #4caf50; --wrong: #ef5350; --tag-bg: rgba(74,158,255,0.12); }

[data-theme="light"] { --bg: #f0ede8; --bg2: #e8e4dd; --bg3: #ddd9d1; --card: #ffffff; --card2: #f7f4ef; --border: rgba(0,0,0,0.08); --accent: #1d3f6e; --accent2: #2a5298; --accent3: #c47c00; --text: #2c3e50; --text2: #4a5568; --text3: #718096; --heading: #0f1e35; --toc-bg: #ffffff; --toc-border: #c8c2b8; --toc-link: #1d3f6e; --tag-bg: rgba(29,63,110,0.08); }

* { box-sizing: border-box; margin: 0px; padding: 0px; }

body { font-family: "Source Serif 4", Georgia, serif; background: var(--bg); color: var(--text); line-height: 1.8; font-size: 17px; transition: background 0.3s, color 0.3s; }

.hero { background: rgb(15, 30, 53); padding: 64px 60px 56px; position: relative; overflow: hidden; min-height: 280px; }

[data-theme="light"] .hero { background: rgb(19, 41, 75); }

.hero::before { content: ""; position: absolute; inset: 0px; background: radial-gradient(80% 60% at 70% 50%, rgba(74, 158, 255, 0.08) 0%, transparent 70%); pointer-events: none; }

.hero-badge { display: inline-block; font-family: "JetBrains Mono", monospace; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent2); background: rgba(74, 158, 255, 0.12); border: 1px solid rgba(74, 158, 255, 0.25); padding: 4px 12px; border-radius: 20px; margin-bottom: 20px; }

.hero h1 { font-family: "Playfair Display", serif; font-size: clamp(2.4rem, 5vw, 3.6rem); font-weight: 900; color: rgb(255, 255, 255); line-height: 1.1; margin-bottom: 16px; letter-spacing: -0.02em; }

.hero-sub { font-size: 1.05rem; color: rgba(255, 255, 255, 0.55); font-style: italic; margin-bottom: 40px; font-weight: 300; }

.hero-meta { display: flex; gap: 48px; flex-wrap: wrap; }

.hero-meta-item label { font-family: "JetBrains Mono", monospace; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255, 255, 255, 0.4); font-weight: 600; display: block; margin-bottom: 4px; }

.hero-meta-item span { font-size: 0.9rem; color: rgba(255, 255, 255, 0.65); }

.theme-toggle { position: fixed; top: 20px; right: 20px; z-index: 1000; display: flex; align-items: center; gap: 6px; background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.18); border-radius: 40px; padding: 6px 14px 6px 8px; cursor: pointer; transition: 0.2s; box-shadow: rgba(0, 0, 0, 0.3) 0px 4px 16px; }

.theme-toggle:hover { background: rgba(255, 255, 255, 0.15); }

.theme-toggle .knob { width: 28px; height: 28px; background: rgb(255, 255, 255); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 14px; box-shadow: rgba(0, 0, 0, 0.2) 0px 2px 6px; transition: transform 0.2s; }

.theme-toggle .moon { font-size: 14px; opacity: 0.7; }

.theme-toggle .check { font-size: 14px; color: var(--accent); }

.main-wrap { background: var(--bg2); transition: background 0.3s; }

.content-area { max-width: 860px; margin: 0px auto; padding: 60px 40px 100px; }

.toc { background: var(--toc-bg); border-top-color: ; border-top-style: ; border-top-width: ; border-right-color: ; border-right-style: ; border-right-width: ; border-bottom-color: ; border-bottom-style: ; border-bottom-width: ; border-image-source: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; border-left: 4px solid var(--accent); border-radius: 4px; padding: 32px 36px; margin-bottom: 56px; transition: background 0.3s, border-color 0.3s; }

.toc-title { font-family: "JetBrains Mono", monospace; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text3); margin-bottom: 20px; font-weight: 600; }

.toc ol { list-style: none; counter-reset: toc 0; padding: 0px; }

.toc li { counter-increment: toc 1; display: flex; align-items: baseline; gap: 10px; padding: 7px 0px; border-bottom: 1px solid var(--border); font-size: 0.95rem; }

.toc li:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.toc li::before { content: counter(toc) "."; font-family: "JetBrains Mono", monospace; font-size: 12px; color: var(--text3); min-width: 22px; }

.toc a { color: var(--toc-link); text-decoration: none; transition: color 0.2s; }

.toc a:hover { color: var(--accent); text-decoration: underline; }

.section { margin-bottom: 64px; }

h2 { font-family: "Playfair Display", serif; font-size: 1.9rem; font-weight: 700; color: var(--heading); margin-bottom: 20px; margin-top: 60px; padding-bottom: 12px; border-bottom: 1px solid var(--border); transition: color 0.3s; }

h2:first-child { margin-top: 0px; }

h3 { font-family: "Playfair Display", serif; font-size: 1.25rem; font-weight: 700; color: var(--heading); margin: 32px 0px 12px; transition: color 0.3s; }

h4 { font-family: "JetBrains Mono", monospace; font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent2); margin: 24px 0px 10px; }

p { margin-bottom: 16px; color: var(--text); transition: color 0.3s; }

.callout { border-left: 4px solid var(--accent); background: var(--card); border-radius: 0px 6px 6px 0px; padding: 20px 24px; margin: 28px 0px; transition: background 0.3s; }

.callout.warning { border-color: var(--accent3); }

.callout.success { border-color: var(--correct); }

.callout.danger { border-color: var(--wrong); }

.callout-label { font-family: "JetBrains Mono", monospace; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); font-weight: 700; margin-bottom: 8px; }

.callout.warning .callout-label { color: var(--accent3); }

.callout.success .callout-label { color: var(--correct); }

.callout.danger .callout-label { color: var(--wrong); }

.callout p { margin: 0px; font-size: 0.95rem; }

ul, ol { padding-left: 22px; margin-bottom: 18px; }

li { margin-bottom: 8px; color: var(--text); transition: color 0.3s; }

li strong { color: var(--heading); }

.tag { display: inline-block; font-family: "JetBrains Mono", monospace; font-size: 11px; padding: 3px 10px; border-radius: 12px; background: var(--tag-bg); color: var(--accent2); border: 1px solid rgba(74, 158, 255, 0.2); margin: 2px; }

.diagram-wrap { background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 28px; margin: 32px 0px; overflow-x: auto; text-align: center; transition: background 0.3s; }

.diagram-caption { font-family: "JetBrains Mono", monospace; font-size: 11px; color: var(--text3); margin-top: 14px; letter-spacing: 0.06em; text-align: center; }

.table-wrap { overflow-x: auto; margin: 28px 0px; }

table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }

th { background: var(--card2); color: var(--heading); font-family: "JetBrains Mono", monospace; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; padding: 12px 16px; text-align: left; border-bottom: 2px solid var(--border); transition: background 0.3s; }

td { padding: 11px 16px; border-bottom: 1px solid var(--border); color: var(--text); vertical-align: top; transition: color 0.3s; }

tr:hover td { background: var(--card); }

.analogy { background: linear-gradient(135deg, var(--card), var(--card2)); border: 1px solid var(--border); border-radius: 8px; padding: 24px 28px; margin: 28px 0px; position: relative; transition: background 0.3s; }

.analogy::before { content: "💡"; position: absolute; top: -14px; left: 20px; font-size: 24px; }

.analogy-title { font-family: "JetBrains Mono", monospace; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent3); margin-bottom: 8px; }

.steps { counter-reset: step 0; margin: 20px 0px; }

.step { display: flex; gap: 18px; margin-bottom: 20px; align-items: flex-start; }

.step-num { counter-increment: step 1; min-width: 36px; height: 36px; background: var(--accent); color: rgb(255, 255, 255); font-family: "JetBrains Mono", monospace; font-weight: 700; font-size: 13px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px; }

.step-content h4 { margin: 0px 0px 4px; font-size: 0.95rem; }

.step-content p { margin: 0px; font-size: 0.9rem; color: var(--text2); }

.case-study { background: var(--card); border-right-color: ; border-right-style: ; border-right-width: ; border-bottom-color: ; border-bottom-style: ; border-bottom-width: ; border-left-color: ; border-left-style: ; border-left-width: ; border-image-source: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; border-top: 4px solid var(--accent3); border-radius: 6px; padding: 28px 32px; margin: 32px 0px; transition: background 0.3s; }

.case-tag { font-family: "JetBrains Mono", monospace; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent3); margin-bottom: 8px; }

.case-study h3 { margin: 0px 0px 12px; color: var(--heading); }

.divider { border-right-width: medium; border-bottom-width: medium; border-left-width: medium; border-right-style: none; border-bottom-style: none; border-left-style: none; border-right-color: currentcolor; border-bottom-color: currentcolor; border-left-color: currentcolor; border-image: none; border-top: 1px solid var(--border); margin: 48px 0px; }

.quiz-section { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 40px; margin-top: 60px; transition: background 0.3s; }

.quiz-header { text-align: center; margin-bottom: 40px; }

.quiz-header h2 { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; margin-top: 0px; font-size: 2rem; }

.quiz-header p { color: var(--text2); font-size: 0.95rem; }

.quiz-score-bar { display: flex; align-items: center; justify-content: center; gap: 12px; margin: 12px 0px 0px; }

.score-pill { font-family: "JetBrains Mono", monospace; font-size: 0.95rem; background: var(--tag-bg); border: 1px solid rgba(74, 158, 255, 0.2); border-radius: 20px; padding: 4px 16px; color: var(--accent2); }

.quiz-q { background: var(--card2); border: 1px solid var(--border); border-radius: 8px; padding: 28px 32px; margin-bottom: 24px; transition: background 0.3s; }

.quiz-q-text { font-weight: 600; color: var(--heading); margin-bottom: 18px; font-size: 1rem; line-height: 1.5; }

.quiz-q-num { font-family: "JetBrains Mono", monospace; font-size: 11px; color: var(--accent2); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 8px; }

.options { display: flex; flex-direction: column; gap: 10px; }

.option-btn { background: var(--card); border: 1.5px solid var(--border); border-radius: 6px; padding: 12px 18px; color: var(--text); font-family: "Source Serif 4", serif; font-size: 0.9rem; cursor: pointer; text-align: left; transition: 0.18s; display: flex; align-items: center; gap: 12px; }

.option-btn:hover:not(:disabled) { border-color: var(--accent); background: var(--bg3); }

.option-btn .opt-letter { font-family: "JetBrains Mono", monospace; font-size: 12px; font-weight: 700; min-width: 22px; height: 22px; border-radius: 50%; background: var(--bg2); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: background 0.18s; }

.option-btn.correct { border-color: var(--correct); background: rgba(76, 175, 80, 0.1); color: var(--heading); }

.option-btn.correct .opt-letter { background: var(--correct); color: rgb(255, 255, 255); }

.option-btn.wrong { border-color: var(--wrong); background: rgba(239, 83, 80, 0.1); color: var(--text2); }

.option-btn.wrong .opt-letter { background: var(--wrong); color: rgb(255, 255, 255); }

.option-btn:disabled { cursor: not-allowed; }

.feedback { margin-top: 14px; font-size: 0.875rem; padding: 10px 14px; border-radius: 5px; display: none; font-family: "JetBrains Mono", monospace; }

.feedback.show { display: block; }

.feedback.correct-fb { background: rgba(76, 175, 80, 0.12); color: rgb(129, 199, 132); border-left: 3px solid var(--correct); }

.feedback.wrong-fb { background: rgba(239, 83, 80, 0.12); color: rgb(239, 154, 154); border-left: 3px solid var(--wrong); }

.quiz-controls { display: flex; flex-direction: column; align-items: center; gap: 14px; margin-top: 32px; }

.btn { font-family: "JetBrains Mono", monospace; font-size: 13px; letter-spacing: 0.06em; font-weight: 600; padding: 13px 32px; border-radius: 6px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; transition: 0.2s; }

.btn-retake { background: var(--card2); color: var(--accent2); border: 1.5px solid var(--border); }

.btn-retake:hover { border-color: var(--accent); }

.btn-submit { background: var(--accent); color: rgb(255, 255, 255); opacity: 0.4; cursor: not-allowed; }

.btn-submit.active { opacity: 1; cursor: pointer; }

.btn-submit.active:hover { background: var(--accent2); }

.submit-msg { font-family: "JetBrains Mono", monospace; font-size: 12px; color: var(--wrong); text-align: center; display: none; }

.complete-banner { text-align: center; padding: 32px; border-radius: 8px; background: rgba(76, 175, 80, 0.12); border: 1px solid var(--correct); display: none; margin-top: 20px; }

.complete-banner h3 { color: var(--correct); font-size: 1.5rem; margin-bottom: 8px; }

.complete-banner p { color: var(--text2); margin: 0px; font-size: 0.9rem; }

.progress-track { display: flex; gap: 6px; justify-content: center; margin: 16px 0px; }

.progress-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--border); border: 1.5px solid var(--text3); transition: background 0.3s, border-color 0.3s; }

.progress-dot.answered { background: var(--accent3); border-color: var(--accent3); }

.progress-dot.correct { background: var(--correct); border-color: var(--correct); }

.progress-dot.wrong { background: var(--wrong); border-color: var(--wrong); }

@media (max-width: 680px) {
  .hero { padding: 44px 24px 40px; }
  .content-area { padding: 40px 20px 80px; }
  .quiz-section { padding: 24px 18px; }
  .quiz-q { padding: 20px 18px; }
  .hero-meta { gap: 28px; }
}
