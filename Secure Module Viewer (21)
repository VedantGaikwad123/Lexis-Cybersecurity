      <table>
        <thead>
          <tr><th>Obligation</th><th>All Intermediaries</th><th>SSMIs</th></tr>
        </thead>
        <tbody>
          <tr><td>Grievance Officer</td><td>✓ Required</td><td>✓ + Must be Indian resident</td></tr>
          <tr><td>ToS Publication</td><td>✓ Required</td><td>✓ + Regional language</td></tr>
          <tr><td>Takedown in 36 hrs</td><td>✓ Required</td><td>✓ Required</td></tr>
          <tr><td>Chief Compliance Officer</td><td>✗ Not required</td><td>✓ Mandatory</td></tr>
          <tr><td>Monthly Compliance Report</td><td>✗ Not required</td><td>✓ Mandatory</td></tr>
          <tr><td>Traceability (if messaging)</td><td>✗ Not required</td><td>✓ Mandatory</td></tr>
          <tr><td>Proactive Content Monitoring</td><td>✗ Not required</td><td>✓ For certain content</td></tr>
        </tbody>
      </table>
    </div>
  </section>

