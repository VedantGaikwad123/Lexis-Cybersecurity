# ==============================================================================
# LEXIS Security & Environment Git Ignore Rules
# MUST PREVENT ANY SECRETS, CREDENTIALS, LOCAL ENVS, OR BUILDS FROM ENTERING GIT
# ==============================================================================

# --- Secrets & Environment Files ---
.env
.env.*
!.env.example
!.env.*.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# --- Credentials, Keys & Certificates ---
*.pem
*.key
*.crt
*.pfx
*.p12
*.cer
*.der
id_rsa
id_rsa.pub
secrets.json
credentials.json
service-account*.json
*.keystore

# --- Node.js & Web Frontend ---
node_modules/
jspm_packages/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
dist/
build/
out/
.next/
.nuxt/
.vuepress/
.cache/
.parcel-cache/

# --- Python & Agent Services ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# --- Database & User Upload Storage ---
/uploads/
/storage/
*.db
*.sqlite
*.sqlite3
dump.rdb

# --- OS & IDE Configurations ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
