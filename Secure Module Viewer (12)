:root[data-theme="dark"] { --bg: #0f1923; --bg2: #162032; --bg3: #1c2d42; --bg4: #1f3352; --surface: #1a2840; --surface2: #213350; --border: #2a4060; --border2: #3a5070; --accent: #4a9eda; --accent2: #5bb8f5; --accent3: #7ecfff; --text: #e8f0f8; --text2: #b0c8e0; --text3: #7a9ab8; --text4: #4a6a88; --heading: #f0f8ff; --tag-bg: #1a3a5c; --tag-text: #7ecfff; --correct: #2d6a4f; --correct-text: #74c69d; --wrong: #6b2737; --wrong-text: #f4a0b0; --toc-bg: #162032; --toc-border: #2a5080; --hero-bg: #13213a; --mono-bg: #0d1a28; --mono-text: #7ecfff; --diagram-bg: #0f1f33; }

:root[data-theme="light"] { --bg: #f0f4f8; --bg2: #e4ecf4; --bg3: #d8e6f0; --bg4: #ccdde8; --surface: #ffffff; --surface2: #f5f9fd; --border: #c8daea; --border2: #a8c4da; --accent: #1a5c90; --accent2: #1e6fa8; --accent3: #2080c0; --text: #1a2a3a; --text2: #2a4a6a; --text3: #4a6a8a; --text4: #7a9ab8; --heading: #0a1a2a; --tag-bg: #d0e8f8; --tag-text: #1a5080; --correct: #d4edda; --correct-text: #155724; --wrong: #f8d7da; --wrong-text: #721c24; --toc-bg: #ffffff; --toc-border: #3a7cb8; --hero-bg: #1a3a5c; --mono-bg: #e8f0f8; --mono-text: #1a5080; --diagram-bg: #e0ecf8; }

* { box-sizing: border-box; margin: 0px; padding: 0px; }

body { font-family: "Source Serif 4", Georgia, serif; background: var(--bg); color: var(--text); line-height: 1.75; font-size: 17px; transition: background 0.3s, color 0.3s; }

.theme-bar { position: fixed; top: 18px; right: 24px; z-index: 1000; background: var(--surface); border: 1.5px solid var(--border); border-radius: 50px; padding: 6px 10px; display: flex; align-items: center; gap: 10px; box-shadow: rgba(0, 0, 0, 0.3) 0px 4px 20px; backdrop-filter: blur(10px); }

.theme-toggle { width: 44px; height: 24px; background: var(--bg3); border-radius: 12px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; position: relative; transition: background 0.3s; }

.theme-toggle::after { content: ""; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; background: var(--accent2); border-radius: 50%; transition: transform 0.3s; }

[data-theme="light"] .theme-toggle::after { transform: translateX(20px); }

.theme-icon { font-size: 15px; color: var(--text3); }

.shield-icon { font-size: 15px; color: var(--accent); }

.hero { background-position-x: ; background-position-y: ; background-size: ; background-repeat: ; background-attachment: ; background-origin: ; background-clip: ; background-color: ; background-image: repeating-linear-gradient(135deg, transparent, transparent 40px, rgba(74, 158, 218, 0.03) 40px, rgba(74, 158, 218, 0.03) 80px), repeating-linear-gradient(45deg, transparent, transparent 40px, rgba(74, 158, 218, 0.03) 40px, rgba(74, 158, 218, 0.03) 80px); padding: 80px 80px 60px; border-bottom: 1px solid var(--border); position: relative; overflow: hidden; }

.hero::before { content: ""; position: absolute; inset: 0px; background: radial-gradient(at 20% 50%, rgba(74, 158, 218, 0.06) 0%, transparent 60%); pointer-events: none; }

.hero-title { font-family: "Playfair Display", Georgia, serif; font-size: clamp(42px, 6vw, 72px); font-weight: 900; color: rgb(240, 248, 255); line-height: 1.1; letter-spacing: -0.02em; max-width: 700px; }

.hero-subtitle { font-family: "Source Serif 4", serif; font-size: 18px; color: rgba(176, 200, 224, 0.85); margin-top: 14px; font-weight: 300; font-style: italic; max-width: 600px; }

.hero-meta { display: flex; gap: 48px; margin-top: 36px; }

.hero-meta-item label { display: block; font-family: "JetBrains Mono", monospace; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin-bottom: 4px; font-weight: 500; }

.hero-meta-item span { font-family: "JetBrains Mono", monospace; font-size: 13px; color: var(--text3); }

.container { max-width: 860px; margin: 0px auto; padding: 0px 40px; }

.toc-wrapper { background: var(--bg2); padding: 40px 0px; }

.toc { background: var(--toc-bg); border-left: 4px solid var(--toc-border); border-radius: 0px 8px 8px 0px; padding: 28px 32px; margin: 0px max(40px, 50% - 390px); max-width: 860px; }

.toc-label { font-family: "JetBrains Mono", monospace; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text4); margin-bottom: 16px; }

.toc ol { padding-left: 20px; }

.toc li { margin-bottom: 8px; }

.toc a { color: var(--accent2); text-decoration: none; font-size: 16px; transition: color 0.2s; }

.toc a:hover { color: var(--accent3); text-decoration: underline; }

.content { padding: 60px 0px 80px; }

.content .container > * + * { margin-top: 28px; }

h2 { font-family: "Playfair Display", serif; font-size: 32px; font-weight: 700; color: var(--heading); border-bottom: 2px solid var(--border); padding-bottom: 10px; line-height: 1.2; margin-top: 60px !important; }

h3 { font-family: "Playfair Display", serif; font-size: 22px; font-weight: 700; color: var(--accent2); margin-top: 36px !important; }

h4 { font-family: "Source Serif 4", serif; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; font-size: 13px; color: var(--text3); margin-top: 24px !important; }

p { color: var(--text2); }

strong { color: var(--text); font-weight: 600; }

em { color: var(--accent3); font-style: italic; }

ul, ol { padding-left: 24px; color: var(--text2); }

ul li, ol li { margin-bottom: 8px; }

ul li::marker { color: var(--accent); }

ol li::marker { color: var(--accent); font-family: "JetBrains Mono", monospace; font-size: 13px; }

code { font-family: "JetBrains Mono", monospace; background: var(--mono-bg); color: var(--mono-text); padding: 2px 7px; border-radius: 4px; font-size: 13px; border: 1px solid var(--border); }

pre { background: var(--mono-bg); border: 1px solid var(--border); border-radius: 8px; padding: 20px 24px; overflow-x: auto; margin: 24px 0px !important; }

pre code { background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 0px; color: var(--mono-text); font-size: 13px; line-height: 1.8; }

.callout { border-left: 4px solid var(--accent); background: var(--surface); border-radius: 0px 8px 8px 0px; padding: 18px 22px; color: var(--text2); margin: 24px 0px !important; }

.callout.warning { border-color: rgb(224, 123, 64); }

.callout.success { border-color: rgb(74, 173, 124); }

.callout strong { color: var(--text); }

.callout-title { font-family: "JetBrains Mono", monospace; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin-bottom: 6px; display: block; }

.callout.warning .callout-title { color: rgb(224, 123, 64); }

.callout.success .callout-title { color: rgb(74, 173, 124); }

.tag { display: inline-block; background: var(--tag-bg); color: var(--tag-text); border: 1px solid var(--border2); border-radius: 4px; padding: 2px 8px; font-family: "JetBrains Mono", monospace; font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase; margin: 2px; }

.diagram-container { background: var(--diagram-bg); border: 1px solid var(--border); border-radius: 10px; padding: 24px; overflow-x: auto; margin: 28px 0px !important; }

.diagram-title { font-family: "JetBrains Mono", monospace; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text4); margin-bottom: 16px; text-align: center; }

table { width: 100%; border-collapse: collapse; font-size: 15px; margin: 24px 0px !important; }

th { background: var(--surface2); color: var(--accent2); font-family: "JetBrains Mono", monospace; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; padding: 12px 16px; text-align: left; border-bottom: 2px solid var(--border); }

td { padding: 11px 16px; border-bottom: 1px solid var(--border); color: var(--text2); vertical-align: top; }

tr:hover td { background: var(--surface); }

.steps { counter-reset: step-counter 0; margin: 20px 0px !important; }

.step { counter-increment: step-counter 1; display: flex; gap: 16px; align-items: flex-start; margin-bottom: 16px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 16px 18px; }

.step::before { content: counter(step-counter); flex-shrink: 0; width: 28px; height: 28px; background: var(--accent); color: rgb(255, 255, 255); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: "JetBrains Mono", monospace; font-size: 13px; font-weight: 700; }

.step-content strong { color: var(--text); }

.step-content p { color: var(--text2); font-size: 15px; margin-top: 4px; }

.quiz-section { background: var(--bg2); padding: 60px 0px; border-top: 1px solid var(--border); }

.quiz-header { text-align: center; margin-bottom: 40px; }

.quiz-header h2 { font-family: "Playfair Display", serif; font-size: 36px; color: var(--heading); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 0px; margin: 0px !important; }

.quiz-header p { color: var(--text3); margin-top: 8px; font-style: italic; }

.quiz-score { text-align: center; font-family: "JetBrains Mono", monospace; font-size: 14px; color: var(--accent2); margin-bottom: 32px; letter-spacing: 0.05em; }

.quiz-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 28px 32px; margin-bottom: 24px; transition: border-color 0.3s; }

.quiz-card.answered-correct { border-color: rgb(74, 173, 124); }

.quiz-card.answered-wrong { border-color: rgb(192, 80, 112); }

.quiz-num { font-family: "JetBrains Mono", monospace; font-size: 11px; color: var(--text4); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 10px; }

.quiz-q { font-family: "Playfair Display", serif; font-size: 19px; color: var(--heading); margin-bottom: 20px; line-height: 1.4; }

.quiz-options { display: flex; flex-direction: column; gap: 10px; }

.quiz-opt { background: var(--bg3); border: 1.5px solid var(--border); border-radius: 8px; padding: 12px 18px; cursor: pointer; color: var(--text2); font-size: 15px; text-align: left; transition: 0.2s; position: relative; }

.quiz-opt:hover:not(:disabled) { background: var(--bg4); border-color: var(--accent); color: var(--text); }

.quiz-opt:disabled { cursor: not-allowed; }

.quiz-opt.correct { background: var(--correct); border-color: rgb(74, 173, 124); color: var(--correct-text); font-weight: 600; }

.quiz-opt.wrong { background: var(--wrong); border-color: rgb(192, 80, 112); color: var(--wrong-text); }

.quiz-feedback { margin-top: 14px; padding: 12px 16px; border-radius: 6px; font-size: 14px; display: none; }

.quiz-feedback.show { display: block; }

.quiz-feedback.correct { background: var(--correct); color: var(--correct-text); border-left: 3px solid rgb(74, 173, 124); }

.quiz-feedback.wrong { background: var(--wrong); color: var(--wrong-text); border-left: 3px solid rgb(192, 80, 112); }

.quiz-feedback-icon { margin-right: 6px; }

.quiz-controls { display: flex; gap: 16px; justify-content: center; align-items: center; margin-top: 32px; flex-wrap: wrap; }

.btn { padding: 12px 28px; border-radius: 8px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; font-family: "JetBrains Mono", monospace; font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 500; transition: 0.2s; }

.btn-retake { background: var(--surface2); border: 1.5px solid var(--border2); color: var(--text2); }

.btn-retake:hover { background: var(--bg4); color: var(--text); }

.btn-submit { background: var(--accent); color: rgb(255, 255, 255); }

.btn-submit:hover:not(:disabled) { background: var(--accent2); }

.btn-submit:disabled { background: var(--border); color: var(--text4); cursor: not-allowed; }

.quiz-message { text-align: center; font-size: 14px; color: var(--text3); margin-top: 12px; font-style: italic; min-height: 20px; }

.quiz-complete { text-align: center; padding: 32px; background: var(--surface); border: 2px solid rgb(74, 173, 124); border-radius: 12px; margin-top: 24px; display: none; }

.quiz-complete.show { display: block; }

.quiz-complete h3 { font-family: "Playfair Display", serif; font-size: 28px; color: rgb(74, 173, 124); margin: 0px 0px 8px !important; }

.quiz-complete p { color: var(--text2); font-style: italic; }

hr { border-right-width: medium; border-bottom-width: medium; border-left-width: medium; border-right-style: none; border-bottom-style: none; border-left-style: none; border-right-color: currentcolor; border-bottom-color: currentcolor; border-left-color: currentcolor; border-image: none; border-top: 1px solid var(--border); margin: 20px 0px !important; }

.progress-bar { position: fixed; top: 0px; left: 0px; height: 3px; background: linear-gradient(to right, var(--accent), var(--accent3)); z-index: 2000; transition: width 0.1s; }

@media (max-width: 640px) {
  .hero { padding: 50px 24px 40px; }
  .hero-meta { gap: 24px; flex-wrap: wrap; }
  .container { padding: 0px 20px; }
  .toc { margin: 0px 20px; }
  h2 { font-size: 26px; }
  h3 { font-size: 20px; }
  .quiz-card { padding: 20px 18px; }
}
