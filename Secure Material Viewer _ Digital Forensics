@charset "utf-8";

:root { --bg-color: #fdfbf7; --text-color: #2c241b; --accent-primary: #8b0000; --accent-secondary: #d4af37; --accent-tertiary: #2c3e50; --card-bg: #ffffff; --border-color: #e0d5c5; --shadow: 0 4px 20px rgba(44, 36, 27, 0.08); }

* { box-sizing: border-box; margin: 0px; padding: 0px; }

body { font-family: Lora, serif; background-color: var(--bg-color); color: var(--text-color); line-height: 1.7; background-image: radial-gradient(rgb(224, 213, 197) 1px, transparent 1px); background-size: 20px 20px; }

h1, h2, h3, h4 { font-family: "Playfair Display", serif; color: var(--accent-primary); margin-bottom: 1rem; }

h1 { font-size: 3rem; text-align: center; margin-bottom: 0.5rem; border-bottom: 3px double var(--accent-secondary); padding-bottom: 1rem; }

h2 { font-size: 2rem; margin-top: 2.5rem; border-left: 5px solid var(--accent-secondary); padding-left: 1rem; }

h3 { font-size: 1.5rem; color: var(--accent-tertiary); margin-top: 1.5rem; }

h4 { font-size: 1.2rem; font-style: italic; color: rgb(85, 85, 85); }

p, li { font-family: Inter, sans-serif; font-size: 1.05rem; margin-bottom: 1rem; }

.container { display: flex; max-width: 1400px; margin: 0px auto; padding: 2rem; gap: 2rem; }

.sidebar { width: 280px; position: sticky; top: 2rem; height: calc(-4rem + 100vh); overflow-y: auto; background: var(--card-bg); padding: 1.5rem; border-radius: 8px; border: 1px solid var(--border-color); box-shadow: var(--shadow); }

.sidebar h3 { font-size: 1.2rem; border-bottom: 2px solid var(--accent-secondary); padding-bottom: 0.5rem; margin-bottom: 1rem; }

.sidebar ul { list-style: none; }

.sidebar li { margin-bottom: 0.5rem; }

.sidebar a { text-decoration: none; color: var(--text-color); font-family: Inter, sans-serif; font-size: 0.9rem; display: block; padding: 0.5rem; border-radius: 4px; transition: 0.3s; }

.sidebar a:hover, .sidebar a.active { background-color: var(--accent-primary); color: white; padding-left: 1rem; }

.main-content { flex: 1 1 0%; background: var(--card-bg); padding: 3rem; border-radius: 8px; border: 1px solid var(--border-color); box-shadow: var(--shadow); }

.search-box { width: 100%; padding: 1rem; margin-bottom: 2rem; border: 2px solid var(--border-color); border-radius: 8px; font-family: Inter, sans-serif; font-size: 1rem; transition: border-color 0.3s; }

.search-box:focus { outline: none; border-color: var(--accent-primary); }

.card { background: rgb(250, 248, 245); border-left: 4px solid var(--accent-secondary); padding: 1.5rem; margin: 1.5rem 0px; border-radius: 0px 8px 8px 0px; }

.highlight { background-color: rgba(212, 175, 55, 0.3); padding: 0px 2px; border-radius: 2px; }

.table-container { overflow-x: auto; margin: 1.5rem 0px; border-radius: 8px; border: 1px solid var(--border-color); }

table { width: 100%; border-collapse: collapse; font-family: Inter, sans-serif; font-size: 0.95rem; }

th { background-color: var(--accent-tertiary); color: white; padding: 1rem; text-align: left; font-family: "Playfair Display", serif; }

td { padding: 1rem; border-bottom: 1px solid var(--border-color); }

tr:nth-child(2n) { background-color: rgb(249, 249, 249); }

tr:hover { background-color: rgba(212, 175, 55, 0.1); }

.diagram-box { background: var(--accent-tertiary); color: white; padding: 1.5rem; border-radius: 8px; margin: 1.5rem 0px; font-family: Inter, sans-serif; text-align: center; position: relative; }

.diagram-box .arrow { font-size: 1.5rem; color: var(--accent-secondary); margin: 0.5rem 0px; }

.flow-step { background: rgba(255, 255, 255, 0.1); padding: 1rem; border-radius: 6px; border: 1px solid var(--accent-secondary); margin: 0.5rem 0px; }

details { margin: 1rem 0px; border: 1px solid var(--border-color); border-radius: 6px; overflow: hidden; }

summary { background: rgb(244, 241, 234); padding: 1rem; cursor: pointer; font-weight: 600; font-family: "Playfair Display", serif; color: var(--accent-primary); list-style: none; display: flex; justify-content: space-between; align-items: center; }

summary::after { content: "+"; font-size: 1.5rem; transition: transform 0.3s; }

details[open] summary::after { transform: rotate(45deg); }

details .content { padding: 1.5rem; background: white; }

.evidence-log { border: 2px solid var(--accent-primary); padding: 2rem; background: rgb(255, 255, 255); margin: 1.5rem 0px; position: relative; }

.evidence-log::before { content: "CONFIDENTIAL"; position: absolute; top: 10px; right: 10px; color: var(--accent-primary); border: 2px solid var(--accent-primary); padding: 0.2rem 0.5rem; font-weight: bold; font-family: Inter, sans-serif; transform: rotate(5deg); opacity: 0.7; }

.form-row { display: flex; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap; }

.form-group { flex: 1 1 0%; min-width: 200px; }

.form-group label { display: block; font-weight: 600; margin-bottom: 0.3rem; font-family: Inter, sans-serif; font-size: 0.9rem; }

.form-group input, .form-group select { width: 100%; padding: 0.5rem; border: 1px solid rgb(204, 204, 204); border-radius: 4px; background: rgb(250, 250, 250); }

#backToTop { position: fixed; bottom: 2rem; right: 2rem; background: var(--accent-primary); color: white; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; width: 50px; height: 50px; border-radius: 50%; cursor: pointer; font-size: 1.5rem; display: none; box-shadow: rgba(0, 0, 0, 0.3) 0px 4px 10px; transition: background 0.3s; }

#backToTop:hover { background: var(--accent-secondary); color: var(--text-color); }

@media (max-width: 900px) {
  .container { flex-direction: column; }
  .sidebar { width: 100%; height: auto; position: relative; top: 0px; }
  h1 { font-size: 2rem; }
}
