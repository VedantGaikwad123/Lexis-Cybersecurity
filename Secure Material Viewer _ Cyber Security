@charset "utf-8";

:root { --bg: #060b14; --surface: #0d1626; --surface2: #111e33; --border: #1e3050; --accent: #00e5ff; --accent2: #ff3e6c; --accent3: #a259ff; --accent4: #00ff88; --text: #e2eaf5; --muted: #6b84a8; --warning: #ffb020; }

* { margin: 0px; padding: 0px; box-sizing: border-box; }

body { background: var(--bg); color: var(--text); font-family: "DM Sans", sans-serif; font-size: 15px; line-height: 1.7; overflow-x: hidden; }

.hero { position: relative; min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 4rem 2rem; overflow: hidden; }

.hero-grid { position: absolute; inset: 0px; background-image: linear-gradient(rgba(0, 229, 255, 0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(0, 229, 255, 0.04) 1px, transparent 1px); background-size: 40px 40px; animation: 8s ease-in-out 0s infinite normal none running gridPulse; }

@keyframes gridPulse { 
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

.hero-orb { position: absolute; border-radius: 50%; filter: blur(80px); pointer-events: none; }

.orb1 { width: 500px; height: 500px; background: rgba(0, 229, 255, 0.08); top: -100px; left: -100px; animation: 12s ease-in-out 0s infinite normal none running float1; }

.orb2 { width: 400px; height: 400px; background: rgba(255, 62, 108, 0.06); bottom: -100px; right: -50px; animation: 15s ease-in-out 0s infinite normal none running float2; }

.orb3 { width: 300px; height: 300px; background: rgba(162, 89, 255, 0.07); top: 40%; left: 50%; transform: translateX(-50%); animation: 10s ease-in-out 0s infinite reverse none running float1; }

@keyframes float1 { 
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-30px); }
}

@keyframes float2 { 
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(25px); }
}

.hero-badge { display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(0, 229, 255, 0.1); border: 1px solid rgba(0, 229, 255, 0.25); color: var(--accent); font-family: "Space Mono", monospace; font-size: 0.7rem; padding: 0.4rem 1rem; border-radius: 999px; letter-spacing: 0.1em; margin-bottom: 1.5rem; animation: 0.8s ease 0s 1 normal both running fadeUp; }

.pulse-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); animation: 1.5s ease-in-out 0s infinite normal none running pulseDot; }

@keyframes pulseDot { 
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.6); }
}

.hero h1 { font-family: Syne, sans-serif; font-size: clamp(3rem, 8vw, 7rem); font-weight: 800; line-height: 1; letter-spacing: -0.02em; animation: 0.8s ease 0.1s 1 normal both running fadeUp; }

.hero h1 span { color: var(--accent); }

.hero h1 em { color: var(--accent2); font-style: normal; }

.hero-sub { font-family: "Space Mono", monospace; color: var(--muted); font-size: 0.85rem; margin-top: 1rem; letter-spacing: 0.05em; animation: 0.8s ease 0.2s 1 normal both running fadeUp; }

.hero-stats { display: flex; gap: 2rem; margin-top: 3rem; flex-wrap: wrap; justify-content: center; animation: 0.8s ease 0.3s 1 normal both running fadeUp; }

.stat { text-align: center; padding: 1rem 1.5rem; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; }

.stat-num { font-family: Syne, sans-serif; font-size: 2rem; font-weight: 800; color: var(--accent); }

.stat-label { font-size: 0.75rem; color: var(--muted); letter-spacing: 0.05em; }

@keyframes fadeUp { 
  0% { opacity: 0; transform: translateY(20px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.toc { padding: 3rem 2rem; max-width: 1100px; margin: 0px auto; }

.toc-title { font-family: Syne, sans-serif; font-size: 1.1rem; font-weight: 700; color: var(--muted); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1.5rem; }

.toc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.5rem; }

.toc-item { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.75rem; border-radius: 8px; background: var(--surface); border: 1px solid var(--border); font-size: 0.8rem; color: var(--muted); cursor: pointer; transition: 0.2s; text-decoration: none; }

.toc-item:hover { background: var(--surface2); border-color: var(--accent); color: var(--accent); }

.toc-num { font-family: "Space Mono", monospace; font-size: 0.7rem; color: var(--accent); min-width: 20px; }

.category-header { position: relative; padding: 5rem 2rem 2rem; max-width: 1100px; margin: 0px auto; }

.cat-label { font-family: "Space Mono", monospace; font-size: 0.7rem; letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 0.5rem; }

.cat-title { font-family: Syne, sans-serif; font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 800; line-height: 1.1; }

.cat-line { width: 60px; height: 4px; border-radius: 2px; margin-top: 1rem; }

.cards-grid { max-width: 1100px; margin: 0px auto; padding: 1rem 2rem 3rem; display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 1.5rem; }

.card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s; position: relative; }

.card:hover { transform: translateY(-4px); box-shadow: rgba(0, 0, 0, 0.4) 0px 20px 40px; }

.card-top { padding: 1.5rem 1.5rem 1rem; position: relative; overflow: hidden; }

.card-icon { font-size: 2.5rem; margin-bottom: 0.75rem; display: block; }

.card-num { position: absolute; top: 1rem; right: 1.25rem; font-family: "Space Mono", monospace; font-size: 0.65rem; color: var(--muted); letter-spacing: 0.1em; }

.card-title { font-family: Syne, sans-serif; font-size: 1.2rem; font-weight: 700; margin-bottom: 0.25rem; }

.card-mono { font-family: "Space Mono", monospace; font-size: 0.7rem; color: var(--muted); margin-bottom: 0.75rem; letter-spacing: 0.05em; }

.card-body { padding: 0px 1.5rem 1.5rem; }

.card-desc { font-size: 0.9rem; line-height: 1.7; color: rgb(176, 196, 222); margin-bottom: 1rem; }

.card-box { background: var(--surface2); border-radius: 10px; padding: 1rem; margin-bottom: 0.75rem; border-left: 3px solid; }

.card-box-title { font-family: "Space Mono", monospace; font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.4rem; }

.card-box p { font-size: 0.85rem; color: rgb(143, 167, 201); }

.tag-row { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.75rem; }

.tag { font-family: "Space Mono", monospace; font-size: 0.65rem; padding: 0.2rem 0.6rem; border-radius: 4px; letter-spacing: 0.04em; }

.diagram { background: var(--surface2); border-radius: 12px; padding: 1rem; margin: 0.75rem 0px; font-family: "Space Mono", monospace; font-size: 0.75rem; overflow-x: auto; }

.diagram pre { color: rgb(143, 167, 201); white-space: pre; }

.ascii-art { font-family: "Space Mono", monospace; font-size: 0.7rem; line-height: 1.4; color: rgb(74, 122, 155); background: var(--bg); border-radius: 8px; padding: 1rem; overflow-x: auto; white-space: pre; }

.alert { display: flex; gap: 0.75rem; align-items: flex-start; padding: 0.75rem 1rem; border-radius: 8px; margin: 0.75rem 0px; font-size: 0.83rem; }

.alert-warn { background: rgba(255, 176, 32, 0.08); border: 1px solid rgba(255, 176, 32, 0.2); color: rgb(212, 160, 23); }

.alert-info { background: rgba(0, 229, 255, 0.06); border: 1px solid rgba(0, 229, 255, 0.15); color: var(--accent); }

.alert-danger { background: rgba(255, 62, 108, 0.08); border: 1px solid rgba(255, 62, 108, 0.2); color: var(--accent2); }

.alert-good { background: rgba(0, 255, 136, 0.06); border: 1px solid rgba(0, 255, 136, 0.15); color: var(--accent4); }

.alert-icon { font-size: 1rem; flex-shrink: 0; margin-top: 0.1rem; }

.steps { margin: 0.75rem 0px; }

.step { display: flex; gap: 1rem; padding: 0.6rem 0px; border-bottom: 1px solid var(--border); }

.step:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.step-num { width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: "Space Mono", monospace; font-size: 0.65rem; flex-shrink: 0; margin-top: 0.1rem; }

.step-content { font-size: 0.85rem; color: rgb(143, 167, 201); }

.step-content strong { color: var(--text); }

.compare-table { width: 100%; border-collapse: collapse; font-size: 0.8rem; margin: 0.75rem 0px; }

.compare-table th { font-family: "Space Mono", monospace; font-size: 0.65rem; letter-spacing: 0.1em; padding: 0.5rem 0.75rem; text-align: left; border-bottom: 1px solid var(--border); }

.compare-table td { padding: 0.5rem 0.75rem; border-bottom: 1px solid rgba(30, 48, 80, 0.5); color: rgb(143, 167, 201); }

.compare-table tr:last-child td { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.section-divider { max-width: 1100px; margin: 0px auto; padding: 0px 2rem; height: 1px; background: linear-gradient(90deg,transparent,var(--border),transparent); }

footer { text-align: center; padding: 4rem 2rem; font-family: "Space Mono", monospace; font-size: 0.75rem; color: var(--muted); border-top: 1px solid var(--border); margin-top: 4rem; }

::-webkit-scrollbar { width: 6px; }

::-webkit-scrollbar-track { background: var(--bg); }

::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

.cat-bar { height: 3px; background: linear-gradient(90deg,var(--accent),transparent); opacity: 0.4; }

.wide-card { grid-column: 1 / -1; }
