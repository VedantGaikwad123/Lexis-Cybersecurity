{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# K-Means Clustering From Scratch (Stepwise Demonstration)\n",
    "\n",
    "This notebook demonstrates the K-Means clustering algorithm **implemented from scratch** without using sklearn.\n",
    "\n",
    "Steps covered:\n",
    "1. Create a small dataset\n",
    "2. Initialize centroids\n",
    "3. Compute Euclidean distances\n",
    "4. Assign clusters\n",
    "5. Update centroids\n",
    "6. Repeat until convergence\n",
    "7. Visualize clusters\n",
    "8. Classify a new sample\n"
   ],
   "id": "f1b77f078263faa8"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 1: Import Libraries"
   ],
   "id": "5c2a857fd6215c0e"
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-03-25T09:47:13.725740300Z",
     "start_time": "2026-03-25T09:47:13.535740100Z"
    }
   },
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt"
   ],
   "id": "dd02e925d885e36b",
   "outputs": [],
   "execution_count": 1
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 2: Create Dataset"
   ],
   "id": "7177ccc3eaa07efc"
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-03-25T09:47:14.256052900Z",
     "start_time": "2026-03-25T09:47:13.773740800Z"
    }
   },
   "source": [
    "data = np.array([\n",
    "    [22,25],\n",
    "    [25,30],\n",
    "    [30,35],\n",
    "    [45,65],\n",
    "    [50,70],\n",
    "    [55,75]\n",
    "])\n",
    "\n",
    "print('Dataset:')\n",
    "print(data)"
   ],
   "id": "82c5bea1ecb73aa6",
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Dataset:\n",
      "[[22 25]\n",
      " [25 30]\n",
      " [30 35]\n",
      " [45 65]\n",
      " [50 70]\n",
      " [55 75]]\n"
     ]
    }
   ],
   "execution_count": 2
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 3: Initialize Centroids"
   ],
   "id": "be4060c2adc31929"
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-03-25T09:47:15.929117600Z",
     "start_time": "2026-03-25T09:47:15.519177700Z"
    }
   },
   "source": [
    "k = 2\n",
    "centroids = data[:k]\n",
    "\n",
    "print('Initial Centroids:')\n",
    "print(centroids)"
   ],
   "id": "287c43ab00096ddf",
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Initial Centroids:\n",
      "[[22 25]\n",
      " [25 30]]\n"
     ]
    }
   ],
   "execution_count": 3
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 4: K-Means Iteration"
   ],
   "id": "c60d22f74c76647a"
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-03-25T09:47:16.396146600Z",
     "start_time": "2026-03-25T09:47:15.970115900Z"
    }
   },
   "source": [
    "iteration = 1\n",
    "\n",
    "while True:\n",
    "    print('\\nIteration', iteration)\n",
    "\n",
    "    clusters = [[] for _ in range(k)]\n",
    "\n",
    "    for point in data:\n",
    "        distances = []\n",
    "\n",
    "        for centroid in centroids:\n",
    "            dist = np.sqrt(np.sum((point - centroid)**2))\n",
    "            distances.append(dist)\n",
    "\n",
    "        cluster_index = np.argmin(distances)\n",
    "        clusters[cluster_index].append(point)\n",
    "\n",
    "        print('Point', point, 'Distances', distances, '-> Cluster', cluster_index)\n",
    "\n",
    "    new_centroids = []\n",
    "\n",
    "    for i in range(k):\n",
    "        cluster_points = np.array(clusters[i])\n",
    "        centroid = cluster_points.mean(axis=0)\n",
    "        new_centroids.append(centroid)\n",
    "\n",
    "    new_centroids = np.array(new_centroids)\n",
    "\n",
    "    print('New Centroids:')\n",
    "    print(new_centroids)\n",
    "\n",
    "    if np.all(centroids == new_centroids):\n",
    "        break\n",
    "\n",
    "    centroids = new_centroids\n",
    "    iteration += 1"
   ],
   "id": "225eeb1beda4a28c",
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "Iteration 1\n",
      "Point [22 25] Distances [np.float64(0.0), np.float64(5.830951894845301)] -> Cluster 0\n",
      "Point [25 30] Distances [np.float64(5.830951894845301), np.float64(0.0)] -> Cluster 1\n",
      "Point [30 35] Distances [np.float64(12.806248474865697), np.float64(7.0710678118654755)] -> Cluster 1\n",
      "Point [45 65] Distances [np.float64(46.14108798023731), np.float64(40.311288741492746)] -> Cluster 1\n",
      "Point [50 70] Distances [np.float64(53.0), np.float64(47.16990566028302)] -> Cluster 1\n",
      "Point [55 75] Distances [np.float64(59.90826320300064), np.float64(54.08326913195984)] -> Cluster 1\n",
      "New Centroids:\n",
      "[[22. 25.]\n",
      " [41. 55.]]\n",
      "\n",
      "Iteration 2\n",
      "Point [22 25] Distances [np.float64(0.0), np.float64(35.510561809129406)] -> Cluster 0\n",
      "Point [25 30] Distances [np.float64(5.830951894845301), np.float64(29.68164415931166)] -> Cluster 0\n",
      "Point [30 35] Distances [np.float64(12.806248474865697), np.float64(22.825424421026653)] -> Cluster 0\n",
      "Point [45 65] Distances [np.float64(46.14108798023731), np.float64(10.770329614269007)] -> Cluster 1\n",
      "Point [50 70] Distances [np.float64(53.0), np.float64(17.4928556845359)] -> Cluster 1\n",
      "Point [55 75] Distances [np.float64(59.90826320300064), np.float64(24.413111231467404)] -> Cluster 1\n",
      "New Centroids:\n",
      "[[25.66666667 30.        ]\n",
      " [50.         70.        ]]\n",
      "\n",
      "Iteration 3\n",
      "Point [22 25] Distances [np.float64(6.200358412579426), np.float64(53.0)] -> Cluster 0\n",
      "Point [25 30] Distances [np.float64(0.6666666666666679), np.float64(47.16990566028302)] -> Cluster 0\n",
      "Point [30 35] Distances [np.float64(6.616477747093069), np.float64(40.311288741492746)] -> Cluster 0\n",
      "Point [45 65] Distances [np.float64(39.98471930347615), np.float64(7.0710678118654755)] -> Cluster 1\n",
      "Point [50 70] Distances [np.float64(46.81998623569972), np.float64(0.0)] -> Cluster 1\n",
      "Point [55 75] Distances [np.float64(53.716333125451186), np.float64(7.0710678118654755)] -> Cluster 1\n",
      "New Centroids:\n",
      "[[25.66666667 30.        ]\n",
      " [50.         70.        ]]\n"
     ]
    }
   ],
   "execution_count": 4
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 5: Final Clusters"
   ],
   "id": "3d7327a1454de8e0"
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-03-25T09:47:17.036563300Z",
     "start_time": "2026-03-25T09:47:16.492140500Z"
    }
   },
   "source": [
    "print('\\nFinal Centroids:')\n",
    "print(centroids)\n",
    "\n",
    "for i in range(k):\n",
    "    print('Cluster', i+1, ':', clusters[i])"
   ],
   "id": "e047e44e744e36cb",
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "Final Centroids:\n",
      "[[25.66666667 30.        ]\n",
      " [50.         70.        ]]\n",
      "Cluster 1 : [array([22, 25]), array([25, 30]), array([30, 35])]\n",
      "Cluster 2 : [array([45, 65]), array([50, 70]), array([55, 75])]\n"
     ]
    }
   ],
   "execution_count": 5
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 6: Visualization"
   ],
   "id": "8f32d517ec67f34"
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-03-25T09:47:18.404009100Z",
     "start_time": "2026-03-25T09:47:17.210821400Z"
    }
   },
   "source": [
    "for i in range(k):\n",
    "    cluster_points = np.array(clusters[i])\n",
    "    plt.scatter(cluster_points[:,0], cluster_points[:,1])\n",
    "\n",
    "plt.scatter(centroids[:,0], centroids[:,1], marker='X', s=200)\n",
    "\n",
    "plt.xlabel('Age')\n",
    "plt.ylabel('Spending Score')\n",
    "plt.title('K-Means Clustering From Scratch')\n",
    "plt.show()"
   ],
   "id": "4185981496f4770",
   "outputs": [
    {
     "data": {
      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ],
      "image/png": ""
     },
     "metadata": {},
     "output_type": "display_data",
     "jetTransient": {
      "display_id": null
     }
    }
   ],
   "execution_count": 6
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 7: Classify a New Sample"
   ],
   "id": "77b7d09236598ba0"
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-03-25T09:47:18.690055400Z",
     "start_time": "2026-03-25T09:47:18.560893800Z"
    }
   },
   "source": [
    "new_point = np.array([28,32])\n",
    "\n",
    "distances = []\n",
    "for centroid in centroids:\n",
    "    dist = np.sqrt(np.sum((new_point-centroid)**2))\n",
    "    distances.append(dist)\n",
    "\n",
    "cluster = np.argmin(distances)\n",
    "\n",
    "print('New Data Point:', new_point)\n",
    "print('Distances:', distances)\n",
    "print('Assigned Cluster:', cluster+1)"
   ],
   "id": "7e7dcc75a9f4e938",
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "New Data Point: [28 32]\n",
      "Distances: [np.float64(3.073181485764295), np.float64(43.9089968002003)]\n",
      "Assigned Cluster: 1\n"
     ]
    }
   ],
   "execution_count": 7
  }
 ],
