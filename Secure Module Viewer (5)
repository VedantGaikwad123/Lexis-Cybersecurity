@charset "utf-8";

:root { --primary: #1A1A1A; --primary-light: #333333; --accent: #3b82f6; --accent-glow: rgba(59, 130, 246, 0.5); --success: #10b981; --error: #ef4444; --bg-cream: #FBFBFA; --text-main: #333333; --text-muted: #A0AEC0; --white: #ffffff; --border: #EEEEEE; --card-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05); }

[data-theme="dark"] { --primary: #020617; --primary-light: #0f172a; --bg-cream: #020617; --text-main: #f1f5f9; --text-muted: #94a3b8; --white: #0f172a; --border: #1e293b; }

* { box-sizing: border-box; margin: 0px; padding: 0px; }

html { scroll-behavior: smooth; }

body { font-family: Inter, sans-serif; background-color: var(--bg-cream); color: var(--text-main); line-height: 1.6; transition: 0.3s; font-size: 16px; }

h1, h2, h3, h4 { font-family: "Source Serif 4", serif; color: var(--primary); font-weight: 700; }

.hero { min-height: 70vh; background: radial-gradient(circle at 50% 0%, rgb(30, 41, 59) 0%, rgb(15, 23, 42) 100%); color: var(--white); padding: 120px 40px 180px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; position: relative; overflow: hidden; }

.hero::before { content: ""; position: absolute; inset: 0px; background-image: repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.016) 0px, rgba(255, 255, 255, 0.016) 2px, transparent 2px, transparent 8px); pointer-events: none; }

.hero h1 { font-size: 56px; color: rgb(255, 255, 255); margin-bottom: 24px; letter-spacing: -0.02em; line-height: 1.1; font-family: "Source Serif 4", serif; }

.hero p { font-size: 18px; max-width: 700px; font-weight: 400; margin-bottom: 60px; color: rgb(203, 213, 225); line-height: 1.6; }

.hero-meta { display: flex; gap: 60px; margin-top: 0px; }

.meta-box { background: transparent; padding: 0px; border-radius: 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; display: flex; flex-direction: column; align-items: center; }

.meta-label { display: block; font-family: "JetBrains Mono", monospace; font-size: 12px; text-transform: uppercase; letter-spacing: 0.15em; color: rgb(100, 116, 139); margin-bottom: 8px; font-weight: 600; }

.meta-val { font-family: "JetBrains Mono", monospace; font-weight: 400; font-size: 14px; color: rgb(248, 250, 252); }

.theme-switch { position: absolute; top: 40px; right: 40px; z-index: 1000; background: rgba(30, 41, 59, 0.7); padding: 6px; border-radius: 50px; box-shadow: none; display: flex; gap: 4px; border: 1px solid rgba(255, 255, 255, 0.1); backdrop-filter: blur(10px); }

.theme-btn { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: 0.3s; color: rgb(148, 163, 184); }

.theme-btn svg { width: 18px; height: 18px; fill: currentcolor; }

.theme-btn.active { background: rgb(255, 255, 255); color: rgb(15, 23, 42); box-shadow: rgba(0, 0, 0, 0.1) 0px 2px 10px; }

.nav-container { max-width: 800px; margin: -120px auto 100px; position: relative; z-index: 10; padding: 0px 20px; }

.toc-card { background: var(--white); border-radius: 4px; padding: 50px 60px; box-shadow: rgba(0, 0, 0, 0.1) 0px 20px 40px; border-width: medium medium medium 4px; border-style: none none none solid; border-color: currentcolor currentcolor currentcolor rgb(29, 78, 216); border-image: none; }

.toc-card h3 { font-family: Inter, sans-serif; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.2em; color: rgb(148, 163, 184); margin-bottom: 40px; text-align: left; }

.toc-grid { display: flex; flex-direction: column; gap: 24px; }

.toc-link { text-decoration: none; color: rgb(30, 41, 59); font-size: 18px; font-weight: 500; display: flex; align-items: center; gap: 24px; transition: 0.3s; padding: 0px; border-radius: 0px; }

.toc-num { color: rgb(148, 163, 184); font-weight: 400; min-width: 24px; }

.toc-link:hover { background: transparent; color: rgb(29, 78, 216); transform: translateX(5px); }

.content-wrap { max-width: 900px; margin: 0px auto; padding: 0px 20px; }

section { margin-bottom: 120px; }

.section-header { margin-bottom: 40px; }

.section-number { font-family: "JetBrains Mono", monospace; color: var(--text-muted); font-size: 11px; font-weight: 400; display: block; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.1em; }

h2 { font-size: 28px; margin-bottom: 20px; position: relative; }

h2::after { content: ""; position: absolute; bottom: -10px; left: 0px; width: 40px; height: 2px; background: var(--accent); }

p { margin-bottom: 30px; color: var(--text-main); font-size: 16px; line-height: 1.6; }

.intro-lead { font-size: 1.4rem; font-weight: 300; color: var(--text-muted); border-left: 4px solid var(--accent); padding-left: 30px; margin: 40px 0px; }

.feature-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 30px; margin: 50px 0px; }

.feature-card { background: var(--white); padding: 40px; border-radius: 20px; border: 1px solid var(--border); transition: 0.4s; box-shadow: rgba(0, 0, 0, 0.05) 0px 4px 6px -1px; }

.feature-card:hover { transform: translateY(-10px); box-shadow: var(--card-shadow); border-color: var(--accent); }

.icon-box { font-size: 2.5rem; margin-bottom: 20px; display: block; }

.definition { background: var(--primary); color: white; padding: 60px; border-radius: 30px; margin: 60px 0px; position: relative; overflow: hidden; }

.definition h3 { color: var(--accent); margin-bottom: 20px; }

.definition p { color: white; font-size: 1.3rem; margin-bottom: 0px; line-height: 1.6; }

.pro-tip { background: rgb(255, 251, 235); border: 1px solid rgb(254, 243, 199); padding: 30px; border-radius: 15px; margin: 40px 0px; display: flex; gap: 20px; }

.pro-tip::before { content: "💡"; font-size: 2rem; }

.quiz-section { background: var(--white); border-radius: 30px; padding: 80px 60px; box-shadow: var(--card-shadow); margin-top: 100px; }

.question-box { margin-bottom: 60px; padding-bottom: 60px; border-bottom: 1px solid var(--border); }

.question-text { font-size: 1.5rem; font-weight: 700; margin-bottom: 30px; color: var(--primary); }

.option-list { display: flex; flex-direction: column; gap: 15px; }

.option-item { padding: 20px 30px; border: 2px solid var(--border); border-radius: 15px; cursor: pointer; transition: 0.2s; font-weight: 500; display: flex; justify-content: space-between; align-items: center; }

.option-item:hover { border-color: var(--accent); background: var(--bg-cream); }

.option-item.correct { border-color: var(--success); background: rgb(236, 253, 245); color: rgb(6, 95, 70); }

.option-item.wrong { border-color: var(--error); background: rgb(254, 242, 242); color: rgb(153, 27, 27); }

.explanation { margin-top: 20px; padding: 15px 25px; border-radius: 10px; font-size: 0.95rem; display: none; line-height: 1.5; }

.explanation.visible { display: block; animation: 0.5s ease 0s 1 normal none running fadeIn; }

.expl-correct { background: rgb(209, 250, 229); color: rgb(6, 95, 70); border-left: 4px solid var(--success); }

.expl-wrong { background: rgb(254, 226, 226); color: rgb(153, 27, 27); border-left: 4px solid var(--error); }

.action-area { text-align: center; padding: 80px 0px; }

.btn-large { padding: 20px 60px; font-size: 1.2rem; font-weight: 700; border-radius: 50px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; transition: 0.3s; background: rgb(203, 213, 225); color: white; }

.btn-large.active { background: var(--accent); box-shadow: 0 10px 20px var(--accent-glow); }

.btn-large.active:hover { transform: translateY(-5px); background: var(--primary); }

.warning-msg { color: var(--error); margin-bottom: 20px; font-weight: 600; display: none; }

footer { background: var(--primary); color: white; padding: 100px 40px; text-align: center; }

@keyframes fadeIn { 
  0% { opacity: 0; transform: translateY(10px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@media (max-width: 768px) {
  .hero h1 { font-size: 3rem; }
  .quiz-section { padding: 40px 20px; }
  .toc-grid { grid-template-columns: 1fr; }
}
